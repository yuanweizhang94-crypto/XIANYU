# Example local upstream wrapper configuration. Copy to D:/xianyu/.local/xianyu-upstream.env.
# Keep the copied file untracked. Do not put real secrets in Git.
XIANYU_WRAPPER_MODE=pilot
XIANYU_REQUIRE_MANUAL_CONFIRMATION=true
XIANYU_ALLOW_LIVE_WRITES=false
XIANYU_UPSTREAM_BACKEND_URL=http://127.0.0.1:18089
XIANYU_UPSTREAM_LISTENER_URL=http://127.0.0.1:18090
XIANYU_UPSTREAM_TIMEOUT_SECONDS=5
XIANYU_UPSTREAM_READ_RETRIES=1
XIANYU_WRAPPER_AUDIT_PATH=.local/upstream-wrapper-audit.jsonl
XIANYU_UPSTREAM_PILOT_ROOT=D:/xianyu-upstream-pilot

# Optional: enables the Wrapper to use the same online-chat API as the Pilot UI.
# Keep this value only in .local/xianyu-upstream.env and never commit or share it.
# XIANYU_UPSTREAM_AUTH_HEADER=Bearer replace-with-local-operator-provided-value
