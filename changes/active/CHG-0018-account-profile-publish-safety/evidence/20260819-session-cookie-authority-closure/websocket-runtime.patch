+async def claim_authoritative_cookie_renewal(
+    account_id: str,
+    *,
+    source: str,
+    lease_seconds: int = 600,
+) -> dict[str, Any]:
+    """Claim the existing per-account SESSION_RENEWING lease under a row lock."""
+    async with async_session_maker() as session:
+        result = await session.execute(
+            select(XYAccount)
+            .where(XYAccount.account_id == account_id)
+            .order_by(XYAccount.id.desc())
+            .limit(1)
+            .with_for_update()
+        )
+        account = result.scalars().first()
+        if not account:
+            return {"claimed": False, "reason": "ACCOUNT_NOT_FOUND", "expected_fingerprint": ""}
+        current_cookie = account.cookie or ""
+        current_fp = cookie_fingerprint(current_cookie)
+        state = get_session_maintenance_state(account.metadata_json)
+        qualified_qr = (
+            state.get("state") == "HUMAN_QR_REQUIRED"
+            and str(state.get("failure_reason") or "").startswith(
+                "OFFICIAL_RENEWAL_FAILED_SAFE_MTOP_SESSION_EXPIRED"
+            )
+            and str(state.get("qr_required_cookie_fingerprint") or "") == current_fp
+        )
+        if qualified_qr:
+            return {
+                "claimed": False,
+                "reason": "HUMAN_QR_REQUIRED_EVIDENCE_QUALIFIED",
+                "expected_fingerprint": current_fp,
+                "authoritative_cookie": current_cookie,
+            }
+        if state.get("state") == "SESSION_RENEWING":
+            raw_updated = str(state.get("updated_at") or "")
+            try:
+                updated = datetime.fromisoformat(raw_updated.replace("Z", "+00:00"))
+                if updated.tzinfo is None:
+                    updated = updated.replace(tzinfo=timezone.utc)
+                age = (datetime.now(timezone.utc) - updated).total_seconds()
+            except Exception:
+                age = 0.0
+            if age < max(1, int(lease_seconds)):
+                return {
+                    "claimed": False,
+                    "reason": "SESSION_RENEWING",
+                    "expected_fingerprint": current_fp,
+                }
+        account.metadata_json = set_session_maintenance_state(
+            account.metadata_json,
+            state="SESSION_RENEWING",
+            cookie_string=current_cookie,
+            failure_reason=f"OWNER:{source}"[:500],
+        )
+        session.add(account)
+        await session.commit()
+        return {
+            "claimed": True,
+            "reason": "CLAIMED",
+            "expected_fingerprint": current_fp,
+            "authoritative_cookie": current_cookie,
+        }
