{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/xianyu/project-state.schema.json",
  "title": "XIANYU Project State",
  "type": "object",
  "required": [
    "project",
    "version",
    "active_change",
    "tasks",
    "suspended_changes",
    "capabilities",
    "runtime_authority"
  ],
  "properties": {
    "project": { "const": "XIANYU" },
    "version": { "type": "string", "minLength": 1 },
    "active_change": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["id", "status", "path"],
          "properties": {
            "id": { "type": "string", "pattern": "^CHG-\\d{4}-[A-Za-z0-9_.-]+$" },
            "status": { "enum": ["DRAFT", "APPROVED", "IMPLEMENTING", "VERIFYING", "MERGED", "ARCHIVED"] },
            "path": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "tasks": {
      "type": "object",
      "required": ["total", "completed", "next_task", "items"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "completed": { "type": "integer", "minimum": 0 },
        "next_task": { "type": ["string", "null"] },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "completed"],
            "properties": {
              "text": { "type": "string" },
              "completed": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "suspended_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "path",
          "suspended_from",
          "suspended_at",
          "suspended_reason",
          "resume_condition",
          "tasks"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^CHG-\\d{4}-[A-Za-z0-9_.-]+$" },
          "status": { "const": "SUSPENDED" },
          "path": { "type": "string", "pattern": "^changes/suspended/" },
          "suspended_from": { "type": ["string", "null"] },
          "suspended_at": { "type": ["string", "null"] },
          "suspended_reason": { "type": ["string", "null"] },
          "resume_condition": { "type": ["string", "null"] },
          "tasks": {
            "type": "object",
            "required": ["total", "completed", "next_task", "items"],
            "properties": {
              "total": { "type": "integer", "minimum": 0 },
              "completed": { "type": "integer", "minimum": 0 },
              "next_task": { "type": ["string", "null"] },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["text", "completed"],
                  "properties": {
                    "text": { "type": "string" },
                    "completed": { "type": "boolean" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["total", "by_status", "items"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "by_status": { "type": "object", "additionalProperties": { "type": "integer" } },
        "items": { "type": "array" }
      },
      "additionalProperties": false
    },
    "runtime_authority": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": [
            "effective_at",
            "production_runtime_code_base_sha",
            "upstream_sha",
            "current_chat_architecture",
            "current_chat_recovery_status",
            "qr_eager_chat_auth",
            "auto_reply_and_chat_independent",
            "remote_token_required",
            "platform_verification_can_recover_through_upstream_bounded_path",
            "production_source_behavior_changed_by_knowledge_sync",
            "production_deployment_required_for_knowledge_sync",
            "recovery_evidence",
            "repository_documentation_sha_resolution"
          ],
          "properties": {
            "effective_at": { "type": "string", "minLength": 1 },
            "production_runtime_code_base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "upstream_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "latest_upstream_main_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "current_chat_upstream_authority_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "current_publish_upstream_authority_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "current_chat_architecture": { "const": "LATEST_UPSTREAM_NATIVE" },
            "current_chat_recovery_status": { "const": "PROVEN_READY_ON_REAL_CANARY" },
            "current_publish_architecture": { "const": "LATEST_UPSTREAM_CAPABILITY_ROUTED_DIRECT_OR_PERSONAL_MTOP" },
            "current_publish_recovery_status": { "const": "PROVEN_READY_ON_REAL_CANARY" },
            "latest_upstream_publish_is_authority": { "const": true },
            "normal_direct_publish_requires_browser": { "const": false },
            "real_browser_login_ready_is_not_normal_publish_gate": { "const": true },
            "publish_account_capability_routing_preserved": { "const": true },
            "production_publish_runtime_overlay": { "const": true },
            "production_publish_runtime_source_match": { "const": true },
            "production_publish_runtime_overlay_note": { "type": "string", "minLength": 1 },
            "qr_eager_chat_auth": { "const": false },
            "auto_reply_and_chat_independent": { "const": true },
            "remote_token_required": { "const": false },
            "platform_verification_can_recover_through_upstream_bounded_path": { "const": true },
            "production_source_behavior_changed_by_knowledge_sync": { "const": false },
            "production_source_behavior_changed_by_publish_restore": { "const": true },
            "production_deployment_required_for_knowledge_sync": { "const": false },
            "recovery_evidence": { "type": "string", "minLength": 1 },
            "publish_recovery_evidence": { "type": "string", "minLength": 1 },
            "repository_documentation_sha_resolution": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
