+    ws_connection_state = str(ws_status.get("connection_state") or "unknown")
+    ws_connected = bool(ws_status.get("is_connected")) or ws_connection_state == "connected"
+    ws_recovery_active = bool(ws_status.get("reconnect_active"))
+    ws_recovery_deadline = ws_status.get("recovery_deadline_at")
+    ws_platform_verification_required = bool(ws_status.get("platform_verification_required"))
+    ws_platform_verification_reason = str(
+        ws_status.get("platform_verification_reason") or "platform_verification_required"
+    )
+    ws_human_qr_required = bool(ws_status.get("human_qr_required"))
+    # 当前业务可用性以真实 WebSocket 连接为最高优先级。后台维护曾遇到 PVR 只说明
+    # 下一次认证可能需要平台验证，不能覆盖一个仍在正常收消息的 live WS。
+    if ws_connected:
+        auto_reply = _business_capability(
+            state="ONLINE",
+            label="在线",
+            reason="websocket_connected",
+            source="websocket_manager",
+            last_checked_at=checked_at,
+            auto_recoverable=True,
+        )
+    elif ws_platform_verification_required:
+        auto_reply = _business_capability(
+            state="PLATFORM_VERIFICATION_REQUIRED",
+            label="需平台验证",
+            reason=ws_platform_verification_reason,
+            source="auto_reply_token_owner",
+            last_checked_at=checked_at,
+            auto_recoverable=False,
+            recovery_active=False,
+        )
+        auto_reply["human_action"] = "platform_verification"
+    elif ws_human_qr_required:
+        auto_reply = _business_capability(
+            state="LOGIN_REQUIRED",
+            label="需登录",
+            reason="authoritative_human_qr_required",
+            source="auto_reply_token_owner",
+            last_checked_at=checked_at,
+            auto_recoverable=False,
+            recovery_active=False,
+        )
+    elif ws_recovery_active:
+        auto_reply = _business_capability(
+            state="RECOVERING",
+            label="恢复中",
+            reason="websocket_reconnect_active",
+            source="websocket_manager",
+            last_checked_at=checked_at,
+            auto_recoverable=True,
+            recovery_active=True,
+            deadline_at=ws_recovery_deadline,
+        )
+    else:
+        offline_reason = (
+            "websocket_recovery_deadline_exceeded"
+            if ws_running and ws_connection_state in {"connecting", "reconnecting"} and ws_recovery_deadline
+            else "websocket_disconnected_no_active_recovery"
+            if ws_running
+            else "websocket_task_not_running"
+        )
+        auto_reply = _business_capability(
+            state="OFFLINE",
+            label="离线",
+            reason=offline_reason,
+            source="websocket_manager",
+            last_checked_at=checked_at,
+            auto_recoverable=True,
+            deadline_at=ws_recovery_deadline,
+        )
+
+    auth_convergence = metadata.get("auth_convergence")
+    if not isinstance(auth_convergence, dict):
+        auth_convergence = {}
+    chat_recovery_active, chat_recovery_expired = _bounded_operation_active(
+        auth_convergence,
+        active_key="recovery_active",
+        deadline_key="recovery_deadline_at",
+    )
+    chat_recovery_deadline = auth_convergence.get("recovery_deadline_at")
+    chat_state = str(chat.get("state") or "PENDING")
+    chat_reason = str(chat.get("reason") or "chat_readiness_pending")
+    chat_checked_at = chat.get("updated_at") or chat_diagnostic.get("updated_at")
+
+    # Chat 用户态由现有 ImSessionManager strict diagnostic 计算 current usability。
+    # 历史 READY 没有 live client 时绝不能继续假绿；Account GET 仍严格只读。
+    effective_chat_state = str(chat_diagnostic.get("effective_state") or "")
+    effective_chat_reason = str(chat_diagnostic.get("effective_reason") or "")
+    effective_chat_auto_recoverable = bool(chat_diagnostic.get("auto_recoverable", True))
+    chat_connect_active = bool(chat_diagnostic.get("connect_active"))
+    chat_connect_deadline = chat_diagnostic.get("connect_deadline_at")
+    if not effective_chat_state:
+        if bool(
+            chat_diagnostic.get("client_connected")
+            and chat_diagnostic.get("client_fingerprint_matches")
+        ):
+            effective_chat_state = "READY"
+            effective_chat_reason = "chat_runtime_client_ready"
+        elif bool(chat_diagnostic.get("connect_active")) or chat_recovery_active:
+            effective_chat_state = "CONNECTING"
+            effective_chat_reason = chat_reason or "auth_convergence_active"
+        elif chat_state == "PLATFORM_VERIFICATION_REQUIRED":
+            effective_chat_state = "PLATFORM_VERIFICATION_REQUIRED"
+            effective_chat_reason = chat_reason or "platform_verification_required"
+            effective_chat_auto_recoverable = False
+        elif chat_state in {"HUMAN_QR_REQUIRED", "SESSION_EXPIRED"}:
+            effective_chat_state = "LOGIN_REQUIRED"
+            effective_chat_reason = chat_reason or "chat_login_required"
+            effective_chat_auto_recoverable = False
+        elif chat_state == "TEMPORARY_FAILURE":
+            effective_chat_state = "TEMPORARY_FAILURE"
+            effective_chat_reason = chat_reason or "chat_temporary_failure"
+        else:
+            # 包括 stored READY/PENDING：没有当前 runtime 证据只能“待连接”。
+            effective_chat_state = "WAITING_CONNECT"
+            effective_chat_reason = "chat_client_not_currently_connected"
+
+    chat_labels = {
+        "READY": "可用",
+        "CONNECTING": "连接中",
+        "RECOVERING": "恢复中",
+        "WAITING_CONNECT": "待连接",
+        "DISCONNECTED": "待连接",
+        "TEMPORARY_FAILURE": "暂不可用",
+        "LOGIN_REQUIRED": "需登录",
+        "PLATFORM_VERIFICATION_REQUIRED": "需平台验证",
+        "RATE_LIMITED": "请求频繁，稍后重试",
+        "DISABLED": "停用",
+        "UNKNOWN": "未知",
+    }
+    chat_capability = _business_capability(
+        state=effective_chat_state,
+        label=chat_labels.get(effective_chat_state, "未知"),
+        reason=effective_chat_reason or "chat_state_unknown",
+        source="chat_read_only_runtime",
+        last_checked_at=(checked_at if effective_chat_state in {"READY", "CONNECTING"} else chat_checked_at),
+        auto_recoverable=effective_chat_auto_recoverable,
+        recovery_active=chat_connect_active or chat_recovery_active,
+        deadline_at=chat_connect_deadline or chat_recovery_deadline,
+    )
+    chat_capability["verification_state"] = str(
+        chat_diagnostic.get("verification_state") or chat.get("verification_state") or "NONE"
