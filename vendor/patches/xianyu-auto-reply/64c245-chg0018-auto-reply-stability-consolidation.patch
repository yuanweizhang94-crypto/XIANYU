+    async def cancel_platform_verification(self, account_id: str) -> dict[str, Any]:
+        verification_lock = self._get_verification_lock(account_id)
+        async with verification_lock:
+            record = self._verification_sessions.get(account_id)
+            if not record or not record.get("verification_active"):
+                return self._public_verification_status(record or {
+                    "verification_state": "NONE",
+                    "verification_active": False,
+                })
+            record["verification_active"] = False
+            record["verification_state"] = "VERIFICATION_CANCELLED"
+            record["verification_reason"] = "user_cancelled_official_verification"
+            record["verification_url"] = ""
+            task = self._verification_tasks.pop(account_id, None)
+            if task and not task.done():
+                task.cancel()
+            await self._record_platform_verification_state(account_id, record)
+            return self._public_verification_status(record)
