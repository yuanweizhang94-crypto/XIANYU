+    )
+    lowered = text_body.lower()
+    if "fail_sys_user_validate" in lowered or "rgv587_error" in lowered or "captcha" in lowered:
+        return (
+            "PLATFORM_VERIFICATION_REQUIRED",
+            "platform_verification_required",
+            "CHAT_PLATFORM_VERIFICATION_REQUIRED",
+        )
+    if "human_qr_required" in lowered:
+        return "HUMAN_QR_REQUIRED", "authoritative_session_required_qr", "CHAT_LOGIN_REQUIRED"
+    if "session_expired" in lowered or "login_required" in lowered:
+        return "SESSION_EXPIRED", "chat_session_expired", "CHAT_LOGIN_REQUIRED"
+    if "400600001" in text_body:
+        return "RATE_LIMITED", "chat_rate_limited", "CHAT_RATE_LIMITED"
+    if "timeout" in lowered or "network" in lowered:
+        return "TEMPORARY_FAILURE", "temporary_network", "CHAT_TEMPORARY_FAILURE"
+    if "disconnect" in lowered or "closed" in lowered:
+        return "DISCONNECTED", "chat_disconnected", "CHAT_TEMPORARY_FAILURE"
+    return "TEMPORARY_FAILURE", "chat_read_failed", "CHAT_UNKNOWN_AUTH_FAILURE"
