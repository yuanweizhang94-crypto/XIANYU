+    async def _run_platform_verification_resume(self, account_id: str) -> None:
+        """Boundedly retry the existing Chat auth after the user starts official verification."""
+        try:
+            while True:
+                record = self._verification_sessions.get(account_id)
+                if not record or not record.get("verification_active"):
+                    return
+                if time.monotonic() >= float(record.get("deadline_monotonic") or 0):
+                    await self._finish_platform_verification(
+                        account_id,
+                        state="VERIFICATION_EXPIRED",
+                        reason="official_verification_deadline_expired",
+                        chat_state="PLATFORM_VERIFICATION_REQUIRED",
+                        chat_error_code="CHAT_PLATFORM_VERIFICATION_REQUIRED",
+                        token_retry_result="EXPIRED",
+                    )
+                    return
