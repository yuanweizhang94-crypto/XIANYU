+async def _record_chat_readiness(
+    *,
+    account_id: str,
+    state: str,
+    reason: str = "",
+    auth_fingerprint: str = "",
+    error_code: str = "",
+) -> None:
+    try:
+        async with async_session_maker() as session:
+            result = await session.execute(
+                text(
+                    "SELECT id, metadata FROM xy_accounts "
+                    "WHERE account_id = :account_id ORDER BY id DESC LIMIT 1"
+                ),
+                {"account_id": account_id},
+            )
+            row = result.mappings().first()
+            if not row:
+                return
+            metadata = _metadata_dict(row.get("metadata"))
+            session_state = dict(metadata.get("session_maintenance") or {})
+            consumers = dict(session_state.get("consumers") or {})
+            record = {
+                "state": state,
+                "updated_at": get_beijing_now_naive().isoformat(),
+                "reason": reason,
+            }
+            if auth_fingerprint:
+                record["auth_fingerprint"] = auth_fingerprint[:12]
+            if error_code:
+                record["error_code"] = str(error_code)[:120]
+            consumers["chat"] = record
+            session_state["consumers"] = consumers
+            metadata["session_maintenance"] = session_state
+            await session.execute(
+                text("UPDATE xy_accounts SET metadata = :metadata WHERE id = :id"),
+                {"metadata": json.dumps(metadata, ensure_ascii=False), "id": row["id"]},
