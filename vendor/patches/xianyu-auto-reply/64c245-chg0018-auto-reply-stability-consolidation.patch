+            status = self.PLATFORM_STATUS_OFFLINE
+        else:
+            return {
+                "confirmed": False,
+                "status": self.PLATFORM_STATUS_UNKNOWN,
+                "reason": summary or "official_detail_no_explicit_status",
+                "source": source,
+                "raw_platform_item_status": raw_status,
+                "preserve_previous": True,
+            }
+        return {
+            "confirmed": True,
+            "status": status,
+            "reason": summary or "official_detail_no_explicit_status",
+            "source": source,
+            "raw_platform_item_status": raw_status,
+            "preserve_previous": False,
+        }
+
+    def _authoritative_item_platform_metadata(
+        self,
+        classification: dict[str, Any],
+        now: str,
+    ) -> dict[str, Any]:
+        return {
+            "platform_status": classification.get("status") or self.PLATFORM_STATUS_UNKNOWN,
+            "platform_status_reason": classification.get("reason") or "",
+            "platform_status_source": classification.get("source") or "goofish_item_detail_page",
+            "platform_status_updated_at": now,
+            "last_status_check_at": now,
+            "raw_platform_item_status": classification.get("raw_platform_item_status"),
+        }
