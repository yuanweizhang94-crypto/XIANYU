+        client_connected: bool = False,
+        conversation_list_success: bool = False,
+        conversation_count: int = 0,
+    ) -> None:
+        record = self._verification_sessions.get(account_id)
+        if not record:
+            return
+        record.update({
+            "verification_state": state,
+            "verification_active": False,
+            "verification_reason": reason,
+            "verification_url": "",
+            "chat_state": chat_state,
+            "chat_error_code": chat_error_code,
+            "chat_token_retry_result": token_retry_result,
+            "chat_client_connected": client_connected,
+            "conversation_list_success": conversation_list_success,
+            "conversation_count": conversation_count,
+        })
+        await self._record_platform_verification_state(account_id, record)
+        if state == "VERIFICATION_SUCCEEDED":
+            self._verification_challenges.pop(account_id, None)
