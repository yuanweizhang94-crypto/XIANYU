+def _bounded_operation_active(
+    record: dict[str, Any],
+    *,
+    active_key: str,
+    deadline_key: str,
+) -> tuple[bool, bool]:
+    """Return (effective_active, deadline_expired) for existing owner metadata."""
+    if not bool(record.get(active_key)):
+        return False, False
+    raw_deadline = str(record.get(deadline_key) or "").strip()
+    if not raw_deadline:
+        return False, True
+    try:
+        deadline = datetime.fromisoformat(raw_deadline.replace("Z", "+00:00"))
+        if deadline.tzinfo is None:
+            deadline = deadline.replace(tzinfo=timezone(timedelta(hours=8)))
+        return datetime.now(timezone.utc) < deadline.astimezone(timezone.utc), datetime.now(timezone.utc) >= deadline.astimezone(timezone.utc)
+    except Exception:
+        return False, True
+
