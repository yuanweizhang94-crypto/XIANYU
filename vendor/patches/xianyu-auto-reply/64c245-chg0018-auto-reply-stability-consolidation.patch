+def cookie_fingerprint(cookie_string: str) -> str:
+    """Return a one-way fingerprint for diagnostics without exposing Cookie content."""
+    normalized = normalize_cookie_string(cookie_string or "")
+    return hashlib.sha256(normalized.encode("utf-8")).hexdigest()
+
+
+# Browser health can legitimately rotate these short-lived browser/session telemetry
+# fields while the account authentication identity remains unchanged. They must not
+# create a new consumer-auth generation by themselves.
+_CONSUMER_AUTH_EPHEMERAL_COOKIE_NAMES = frozenset({"atpsida", "sca", "tfstk"})
+
+
+def auth_convergence_fingerprint(cookie_string: str) -> str:
+    """Fingerprint auth-relevant Cookie state for consumer convergence.
+
+    This does not change Cookie storage. It only canonicalizes field order and ignores
+    runtime-proven volatile browser fields that rotate during a read-only Browser
+    health check. Authentication/verification Cookie changes remain part of the hash.
+    """
+    try:
+        parsed = parse_cookie_string(cookie_string or "")
+    except Exception:
+        parsed = {}
+    if parsed:
+        normalized = "; ".join(
+            f"{name}={parsed[name]}"
+            for name in sorted(parsed)
+            if name not in _CONSUMER_AUTH_EPHEMERAL_COOKIE_NAMES
+        )
+    else:
+        normalized = normalize_cookie_string(cookie_string or "")
+    return hashlib.sha256(normalized.encode("utf-8")).hexdigest()
