+def _read(path: Path) -> str:
+    return path.read_text(encoding="utf-8-sig")
+
+
+def _function_block(path: Path, name: str) -> str:
+    source = _read(path)
+    tree = ast.parse(source)
+    for node in ast.walk(tree):
+        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and node.name == name:
+            return ast.get_source_segment(source, node) or ""
+    raise AssertionError(f"function not found: {name}")
+
+
+def _load_capability_builder():
+    source = _read(ACCOUNT_ROUTE)
+    tree = ast.parse(source)
+    wanted = {
+        "_status_to_enabled",
+        "_consumer_record",
+        "_build_platform_restriction",
+        "_business_capability",
+        "_bounded_operation_active",
+        "_build_business_capabilities",
+    }
+    nodes = [
+        node
+        for node in tree.body
+        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and node.name in wanted
+    ]
+    namespace = {
+        "Any": Any,
+        "XYAccount": object,
+        "datetime": datetime,
+        "timezone": timezone,
+        "safe_isoformat": lambda value: value.isoformat() if value else None,
+    }
+    module = ast.Module(body=nodes, type_ignores=[])
+    exec(compile(module, str(ACCOUNT_ROUTE), "exec"), namespace)
+    return namespace["_build_business_capabilities"]
+
+
+def _account():
+    return SimpleNamespace(
+        status="active",
+        metadata_json={
+            "session_maintenance": {
+                "state": "SESSION_CHECK_PENDING",
+                "consumers": {
+                    "chat": {"state": "PENDING", "reason": "", "updated_at": None},
+                    "publish": {"state": "PENDING", "reason": "", "updated_at": None},
+                },
+            }
+        },
+        disable_reason="",
+        updated_at=None,
+    )
+
