+                if not record.get("authenticated_browser_started"):
+                    record["authenticated_browser_started"] = True
+                    record["verification_state"] = "VERIFICATION_IN_PROGRESS"
+                    record["verification_reason"] = "opening_authenticated_account_browser"
+                    await self._record_platform_verification_state(account_id, record)
+                    remaining_for_browser = max(
+                        30,
+                        min(
+                            240,
+                            int(float(record.get("deadline_monotonic") or 0) - time.monotonic()),
+                        ),
+                    )
+                    browser_response = await websocket_client.start_authenticated_platform_verification(
+                        account_id,
+                        str(record.get("verification_url") or ""),
+                        timeout_seconds=remaining_for_browser,
+                    )
+                    browser_data = (
+                        browser_response.get("data") or {}
+                        if isinstance(browser_response, dict)
+                        else {}
+                    )
+                    browser_state = str(
