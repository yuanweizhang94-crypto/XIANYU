+        if success:
+            suc_count += 1
+        else:
+            fail_count += 1
+            messages.append(str(item_result.get("message") or "下架失败"))
+
+    if not cleaned_ids:
+        message = "没有有效的商品ID"
+    elif suc_count == 0:
+        message = messages[0] if messages else "下架失败"
+    else:
+        message = f"下架成功 {suc_count} 个，失败 {fail_count} 个"
+    return {
+        "success": suc_count > 0,
+        "message": message,
+        "suc_count": suc_count,
+        "fail_count": fail_count,
+        "results": results,
