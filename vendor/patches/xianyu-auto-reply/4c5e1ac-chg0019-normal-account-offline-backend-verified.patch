+def test_browser_exception_returns_failure_not_success():
+    module = load_publisher_module()
+    publisher = module.XianyuPublisher()
+
+    async def broken_initialize(*args, **kwargs):
+        raise RuntimeError("browser exploded")
+
+    async def harmless_close():
+        return None
+
+    publisher.initialize = broken_initialize
+    publisher.close = harmless_close
+    result = asyncio.run(publisher.offline_item(item_id="1070515947040", cookies_str="masked"))
+    assert result["success"] is False
+    assert result["ui_success"] is False
+    assert result["message"].startswith("browser_failure:")
