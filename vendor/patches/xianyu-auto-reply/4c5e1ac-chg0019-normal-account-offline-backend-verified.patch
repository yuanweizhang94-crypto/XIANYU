+def test_batch_results_are_independent(monkeypatch):
+    from common.services import xianyu_publish_service as service
+
+    outcomes = iter([
+        {"success": True, "message": "offline_success"},
+        {"success": False, "message": "offline_control_not_found"},
+    ])
+
+    class FakePublisher:
+        async def offline_item(self, **kwargs):
+            return next(outcomes)
+
+    monkeypatch.setattr(service, "create_xianyu_publisher", lambda: FakePublisher())
+    result = asyncio.run(
+        service.offline_items_normal_web(cookies_str="masked", item_ids=["1", "2"])
+    )
+    assert result["suc_count"] == 1
+    assert result["fail_count"] == 1
+    assert result["results"] == [
+        {"item_id": "1", "success": True},
+        {"item_id": "2", "success": False},
+    ]
+
+
+def test_batch_offline_route_reads_counts_from_normal_web_result():
+    source = ITEMS_ROUTE_PATH.read_text(encoding="utf-8")
+    call_index = source.index("result = await offline_items_normal_web(")
+    success_count_index = source.index('suc_count = int(result.get("suc_count", 0) or 0)', call_index)
+    failure_count_index = source.index('fail_count = int(result.get("fail_count", 0) or 0)', call_index)
+    logger_index = source.index("logger.info(", failure_count_index)
+    assert call_index < success_count_index < failure_count_index < logger_index
+
