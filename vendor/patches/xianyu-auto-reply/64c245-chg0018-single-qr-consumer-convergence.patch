+def get_effective_publish_restriction(metadata: Any, *, now: datetime | None = None) -> dict[str, Any] | None:
+    if not isinstance(metadata, dict):
+        return None
+    record = metadata.get("platform_restriction")
+    if not isinstance(record, dict) or record.get("state") != "PUBLISH_RESTRICTED":
+        return None
+    current = now or datetime.now(timezone.utc)
+    until = _parse_iso_datetime(record.get("restriction_until"))
+    if until and until <= current:
+        return None
+    checked_at = _parse_iso_datetime(record.get("last_checked_at") or record.get("updated_at"))
+    if not until and checked_at and current - checked_at > timedelta(hours=24):
+        return None
+    return record
+
+
