+                elif isinstance(raw_metadata, str) and raw_metadata.strip():
+                    try:
+                        parsed_metadata = json.loads(raw_metadata)
+                        metadata = dict(parsed_metadata) if isinstance(parsed_metadata, dict) else {}
+                    except Exception:
+                        metadata = {}
+                else:
+                    metadata = {}
+                session_state = dict(metadata.get("session_maintenance") or {})
+                consumers = dict(session_state.get("consumers") or {})
+                stamp = get_beijing_now_naive().isoformat()
+                consumers["chat"] = {
+                    "state": "PENDING",
+                    "updated_at": stamp,
+                    "reason": reason,
