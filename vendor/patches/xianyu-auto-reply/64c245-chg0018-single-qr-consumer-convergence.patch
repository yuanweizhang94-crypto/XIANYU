@@ -0,0 +1,164 @@
+from __future__ import annotations
+
+import ast
+import json
+from pathlib import Path
+from types import SimpleNamespace
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def _load_functions(path: Path, names: set[str]) -> dict[str, object]:
+    tree = ast.parse(path.read_text(encoding="utf-8"))
+    selected = [
+        node
+        for node in tree.body
+        if isinstance(node, ast.FunctionDef) and node.name in names
+    ]
+    module = ast.Module(body=selected, type_ignores=[])
+    ast.fix_missing_locations(module)
+    namespace = {"Any": Any, "json": json}
+    exec(compile(module, str(path), "exec"), namespace)
+    return {name: namespace[name] for name in names}
+
+
+cookie_helpers = _load_functions(
+    ROOT / "backend-web" / "app" / "api" / "routes" / "cookies.py",
+    {
+        "_consumer_record",
+        "_browser_state_from_session",
+        "_publish_state_from_session",
+        "_build_consumer_readiness",
+    },
+)
+chat_helpers = _load_functions(
+    ROOT / "backend-web" / "app" / "services" / "chat_new" / "im_client.py",
+    {"_classify_chat_readiness_failure"},
+)
+publish_helpers = _load_functions(
+    ROOT / "common" / "services" / "xianyu_publish_service.py",
+    {"_classify_publish_readiness_result"},
+)
+
+_build_consumer_readiness = cookie_helpers["_build_consumer_readiness"]
+_classify_chat_readiness_failure = chat_helpers["_classify_chat_readiness_failure"]
+_classify_publish_readiness_result = publish_helpers["_classify_publish_readiness_result"]
+
+
+def _account_with_session(session_maintenance: dict) -> SimpleNamespace:
+    return SimpleNamespace(metadata_json={"session_maintenance": session_maintenance})
+
+
+def test_auto_reply_online_does_not_imply_chat_or_publish_ready():
+    readiness = _build_consumer_readiness(
+        _account_with_session({"state": "SESSION_CHECK_PENDING"}),
+        auto_reply_online=True,
+    )
+
+    assert readiness["auto_reply_state"] == "READY"
+    assert readiness["browser_session_state"] == "PENDING"
+    assert readiness["chat_state"] == "PENDING"
+    assert readiness["publish_state"] == "PENDING"
+
+
+def test_chat_can_be_ready_while_browser_session_requires_qr():
+    readiness = _build_consumer_readiness(
+        _account_with_session(
+            {
+                "state": "HUMAN_QR_REQUIRED",
+                "updated_at": "2026-08-13T08:00:00",
+                "failure_reason": "LOGIN_OR_QR_UI_VISIBLE",
+                "consumers": {
+                    "chat": {
+                        "state": "READY",
+                        "updated_at": "2026-08-13T08:05:00",
+                        "reason": "conversation_read_success",
+                    }
+                },
+            }
+        ),
+        auto_reply_online=False,
+    )
+
+    assert readiness["auto_reply_state"] == "DISCONNECTED"
+    assert readiness["browser_session_state"] == "HUMAN_QR_REQUIRED"
+    assert readiness["chat_state"] == "READY"
+    assert readiness["publish_state"] == "HUMAN_QR_REQUIRED"
+
+
+def test_browser_ready_does_not_mask_chat_temporary_failure():
+    readiness = _build_consumer_readiness(
+        _account_with_session(
+            {
+                "state": "REAL_BROWSER_LOGIN_READY",
+                "consumers": {
+                    "chat": {
+                        "state": "TEMPORARY_FAILURE",
+                        "updated_at": "2026-08-13T08:07:00",
+                        "reason": "temporary_network",
+                    },
+                    "publish": {
+                        "state": "READY",
+                        "updated_at": "2026-08-13T08:08:00",
+                        "reason": "publish_preflight_ready",
+                    },
+                },
+            }
+        ),
+        auto_reply_online=True,
+    )
+
+    assert readiness["browser_session_state"] == "READY"
+    assert readiness["chat_state"] == "TEMPORARY_FAILURE"
+    assert readiness["publish_state"] == "READY"
+
+
+def test_platform_verification_is_not_collapsed_into_qr_required():
+    readiness = _build_consumer_readiness(
+        _account_with_session(
+            {
+                "state": "PLATFORM_VERIFICATION_REQUIRED",
+                "failure_reason": "MANUAL_VERIFICATION_REQUIRED",
+            }
+        ),
+        auto_reply_online=True,
+    )
+
+    assert readiness["browser_session_state"] == "PLATFORM_VERIFICATION_REQUIRED"
+    assert readiness["publish_state"] == "PLATFORM_VERIFICATION_REQUIRED"
+
+
+def test_chat_failure_classifier_keeps_distinct_reasons():
+    assert _classify_chat_readiness_failure({"reason": "FAIL_SYS_USER_VALIDATE"}) == (
+        "PLATFORM_VERIFICATION_REQUIRED",
+        "platform_verification_required",
+    )
+    assert _classify_chat_readiness_failure({"reason": "login_required"}) == (
+        "HUMAN_QR_REQUIRED",
+        "authoritative_session_required_qr",
+    )
+    assert _classify_chat_readiness_failure({"code": "400600001"}) == (
+        "TEMPORARY_FAILURE",
+        "chat_rate_limited",
+    )
+
+
+def test_publish_preflight_classifier_keeps_browser_and_platform_reasons_distinct():
+    assert _classify_publish_readiness_result({"success": True}) == (
+        "READY",
+        "publish_preflight_ready",
+    )
+    assert _classify_publish_readiness_result({"failure_reason": "profile_in_use"}) == (
+        "PROFILE_BUSY",
+        "profile_busy",
+    )
+    assert _classify_publish_readiness_result({"failure_reason": "profile_missing"}) == (
+        "PENDING",
+        "profile_not_ready",
+    )
+    assert _classify_publish_readiness_result({"failure_reason": "manual_verification_required"}) == (
+        "PLATFORM_VERIFICATION_REQUIRED",
+        "platform_verification_required",
+    )
