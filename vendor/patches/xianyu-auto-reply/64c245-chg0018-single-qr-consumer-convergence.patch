+def _browser_state_from_session(session_maintenance: dict[str, Any]) -> str:
+    state = str(session_maintenance.get("state") or "SESSION_CHECK_PENDING")
+    return {
+        "REAL_BROWSER_LOGIN_READY": "READY",
+        "SESSION_CHECK_PENDING": "PENDING",
+        "SESSION_RENEWING": "PENDING",
+        "SESSION_RENEW_FAILED": "TEMPORARY_FAILURE",
+        "HUMAN_QR_REQUIRED": "HUMAN_QR_REQUIRED",
+        "PLATFORM_VERIFICATION_REQUIRED": "PLATFORM_VERIFICATION_REQUIRED",
+        "COOLDOWN": "COOLDOWN",
+    }.get(state, "PENDING")
+
+
+def _publish_state_from_session(session_maintenance: dict[str, Any]) -> str:
+    publish = _consumer_record(session_maintenance, "publish")
+    if publish["state"] != "PENDING":
+        return publish["state"]
+    browser_state = _browser_state_from_session(session_maintenance)
+    if browser_state in {"HUMAN_QR_REQUIRED", "PLATFORM_VERIFICATION_REQUIRED", "COOLDOWN"}:
+        return browser_state
+    return "PENDING"
+
+
