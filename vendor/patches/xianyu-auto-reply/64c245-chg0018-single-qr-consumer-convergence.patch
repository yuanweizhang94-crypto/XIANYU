+    def _clean_singleton_lock_files(self, user_data_dir: str, log_prefix: str) -> None:
+        """Safely recover only provably stale local Chrome Singleton files.
+
+        The process-local account RLock is necessary but not sufficient because Publisher and
+        WebSocket live in separate containers. A parseable same-host dead PID is recoverable;
+        a live, foreign-host, or unparseable owner fails closed instead of deleting an active
+        Profile lock.
+        """
+        if not user_data_dir or not os.path.isdir(user_data_dir):
+            return
+
+        singleton_names = ("SingletonLock", "SingletonCookie", "SingletonSocket")
+        present = [
+            name
+            for name in singleton_names
+            if os.path.exists(os.path.join(user_data_dir, name))
+            or os.path.islink(os.path.join(user_data_dir, name))
+        ]
+        if not present:
+            return
+
+        lock_path = os.path.join(user_data_dir, "SingletonLock")
+        if not os.path.exists(lock_path) and not os.path.islink(lock_path):
+            for name in present:
+                path = os.path.join(user_data_dir, name)
+                if os.path.islink(path):
+                    os.unlink(path)
+                elif os.path.exists(path):
+                    os.remove(path)
+            logger.warning(f"{log_prefix} 已清理无SingletonLock的孤立Chrome锁文件: {present}")
+            return
+
+        target = ""
+        try:
+            target = os.readlink(lock_path)
+        except OSError:
+            try:
+                with open(lock_path, "r", encoding="utf-8", errors="ignore") as handle:
+                    target = handle.read().strip()
+            except Exception:
+                target = ""
+
+        match = re.search(r"^(?P<host>.+)-(?P<pid>\d+)$", os.path.basename(target) if target else "")
+        if not match:
+            raise RuntimeError("PROFILE_LOCK_OWNER_UNKNOWN")
+
+        owner_host = match.group("host")
+        owner_pid = int(match.group("pid"))
+        if owner_host != socket.gethostname():
+            raise RuntimeError("PROFILE_LOCK_FOREIGN_HOST")
+
+        try:
+            os.kill(owner_pid, 0)
+            owner_alive = True
+        except ProcessLookupError:
+            owner_alive = False
+        except PermissionError:
+            owner_alive = True
+        except (OSError, ValueError):
+            owner_alive = False
+        if owner_alive:
+            raise RuntimeError("PROFILE_IN_USE")
+
+        removed: list[str] = []
+        for name in singleton_names:
+            path = os.path.join(user_data_dir, name)
+            if not os.path.exists(path) and not os.path.islink(path):
+                continue
+            if os.path.islink(path):
+                os.unlink(path)
+            else:
+                os.remove(path)
+            removed.append(name)
+        logger.warning(f"{log_prefix} 已清理确认失效的Chrome Singleton文件: {removed}")
 
