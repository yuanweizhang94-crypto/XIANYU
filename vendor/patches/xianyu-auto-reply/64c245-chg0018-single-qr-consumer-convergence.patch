+    def _get_platform_restriction_record(self, account: XYAccount) -> dict[str, Any]:
+        metadata = account.metadata_json if isinstance(account.metadata_json, dict) else {}
+        record = metadata.get("platform_restriction")
+        return dict(record) if isinstance(record, dict) else {}
+
+    async def _set_account_platform_restriction(
+        self,
+        account: XYAccount,
+        *,
+        state: str,
+        reason: str,
+        source: str,
+        now: str,
+        previous_active_count: int,
+        current_active_count: int,
+        restriction_until: str | None = None,
+        duration_seconds: int | None = None,
+        evidence_type: str | None = None,
+    ) -> bool:
+        metadata = dict(account.metadata_json or {})
+        previous = metadata.get("platform_restriction")
+        if not isinstance(previous, dict):
+            previous = {}
+        next_record = dict(previous)
+        next_record.update({
+            "state": state,
+            "reason": reason,
+            "source": source,
+            "updated_at": now,
+            "last_checked_at": now,
+            "previous_active_count": previous_active_count,
+            "current_active_count": current_active_count,
+            "restriction_until": restriction_until,
+            "duration_seconds": duration_seconds,
+            "evidence_type": evidence_type,
+        })
+        if state == self.ACCOUNT_RESTRICTION_SUSPECTED and not next_record.get("detected_at"):
+            next_record["detected_at"] = now
+        if next_record != previous:
+            metadata["platform_restriction"] = next_record
+            account.metadata_json = metadata
+            flag_modified(account, "metadata_json")
+            self.session.add(account)
+            return True
+        return False
+
+    async def _probe_item_detail_page_status(
+        self,
+        account: XYAccount,
+        item: XYCatalogItem,
+    ) -> dict[str, Any]:
+        import aiohttp
+
+        detail_url = f"https://www.goofish.com/item?id={item.item_id}"
+        metadata = item.metadata_json if isinstance(item.metadata_json, dict) else {}
+        detail_blob = metadata.get("detail")
+        if isinstance(detail_blob, str) and detail_blob.strip():
+            try:
+                detail_data = json.loads(detail_blob)
+                candidate_url = str(detail_data.get("detail_url") or detail_data.get("detailUrl") or "").strip()
+                if candidate_url.startswith("http"):
+                    detail_url = candidate_url
+            except Exception:
+                pass
+
+        headers = {
+            "accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
+            "accept-language": "zh-CN,zh;q=0.9,en;q=0.8",
+            "cookie": account.cookie or "",
+            "referer": "https://www.goofish.com/",
+            "user-agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
+        }
+        try:
+            timeout = aiohttp.ClientTimeout(total=20)
+            async with aiohttp.ClientSession(headers=headers, timeout=timeout) as http:
+                async with http.get(detail_url, allow_redirects=True) as response:
+                    body = await response.text(errors="ignore")
+                    return self._classify_authoritative_item_status(
+                        http_status=response.status,
+                        text=body,
+                        raw_status=f"http_{response.status}",
+                    )
+        except asyncio.TimeoutError:
+            return {
+                "confirmed": False,
+                "status": self.PLATFORM_STATUS_UNKNOWN,
+                "reason": "temporary_network_timeout",
+                "source": "goofish_item_detail_page",
+                "preserve_previous": True,
+            }
+        except Exception as exc:
+            return {
+                "confirmed": False,
+                "status": self.PLATFORM_STATUS_UNKNOWN,
+                "reason": f"temporary_network_failure:{type(exc).__name__}",
+                "source": "goofish_item_detail_page",
+                "preserve_previous": True,
+            }
+
+    async def _confirm_missing_items_authoritatively(
+        self,
+        account: XYAccount,
+        missing_items: list[XYCatalogItem],
+        now: str,
+        *,
+        force: bool = False,
+    ) -> dict[str, Any]:
+        checked = 0
+        updated = 0
+        results: list[dict[str, Any]] = []
+        eligible_items = [item for item in missing_items if self._should_probe_authoritative_item_status(item, force=force)]
+        session_convergence: dict[str, Any] | None = None
+        session_retry_consumed = False
+        for item in eligible_items[: self.AUTHORITATIVE_ITEM_PROBE_LIMIT]:
+            previous_metadata = item.metadata_json if isinstance(item.metadata_json, dict) else {}
+            previous_state = previous_metadata.get("platform_status") or self.PLATFORM_STATUS_UNKNOWN
+            if session_convergence and not session_convergence.get("ready"):
+                classification = self._session_blocked_item_classification(session_convergence)
+            else:
+                classification = await self._probe_item_detail_page_status(account, item)
+                if (
+                    classification.get("reason") == "session_or_verification_required"
+                    and not session_retry_consumed
+                ):
+                    session_retry_consumed = True
+                    session_convergence = await self._converge_session_for_item_status(account)
+                    if session_convergence.get("ready"):
+                        classification = await self._probe_item_detail_page_status(account, item)
+                    else:
+                        classification = self._session_blocked_item_classification(session_convergence)
+            checked += 1
+            final_status = previous_state
+            if classification.get("preserve_previous"):
+                metadata = dict(item.metadata_json or {})
+                evidence_update = {
+                    "platform_status": previous_state,
+                    "platform_status_reason": classification.get("reason") or "authoritative_status_unconfirmed",
+                    "platform_status_source": classification.get("source") or "authoritative_probe",
+                    "last_status_check_at": now,
+                }
+                if any(metadata.get(key) != value for key, value in evidence_update.items()):
+                    metadata.update(evidence_update)
+                    item.metadata_json = metadata
+                    flag_modified(item, "metadata_json")
+                    self.session.add(item)
+                    updated += 1
+            else:
+                metadata = dict(item.metadata_json or {})
+                metadata.update(self._authoritative_item_platform_metadata(classification, now))
+                item.metadata_json = metadata
+                flag_modified(item, "metadata_json")
+                self.session.add(item)
+                updated += 1
+                final_status = metadata.get("platform_status") or self.PLATFORM_STATUS_UNKNOWN
+            results.append({
+                "item_id": item.item_id,
+                "previous_state": previous_state,
+                "official_result": classification.get("status"),
+                "final_platform_status": final_status,
+                "reason": classification.get("reason"),
+                "source": classification.get("source"),
+                "preserved_previous": bool(classification.get("preserve_previous")),
+            })
+        return {
+            "checked_count": checked,
+            "skipped_count": max(0, len(missing_items) - checked),
+            "updated_count": updated,
+            "results": results,
+        }
+
+    async def _reconcile_missing_active_items(
+        self,
+        account: XYAccount,
+        current_item_ids: set[str],
+        now: str,
+        *,
+        force_authoritative_probe: bool = False,
+    ) -> dict[str, Any]:
+        stmt = select(XYCatalogItem).where(
+            XYCatalogItem.owner_id == account.owner_id,
+            XYCatalogItem.account_pk == account.id,
+        )
+        existing_items = (await self.session.execute(stmt)).scalars().all()
+        previously_active: list[XYCatalogItem] = []
+        for existing in existing_items:
+            metadata = existing.metadata_json if isinstance(existing.metadata_json, dict) else {}
+            status = metadata.get("platform_status")
+            if status in (None, "", self.PLATFORM_STATUS_ACTIVE):
+                previously_active.append(existing)
+
+        missing_items = [item for item in previously_active if item.item_id not in current_item_ids]
+        if force_authoritative_probe:
+            known_missing_items = [
+                item
+                for item in existing_items
+                if item.item_id not in current_item_ids
+                and isinstance(item.metadata_json, dict)
+                and item.metadata_json.get("platform_status") == self.PLATFORM_STATUS_MISSING
+                and item not in missing_items
+            ]
+            missing_items.extend(known_missing_items)
+        changed = False
+        for item in missing_items:
+            metadata = dict(item.metadata_json or {})
+            metadata.update({
+                "platform_status": self.PLATFORM_STATUS_MISSING,
+                "platform_status_reason": "not_seen_after_complete_active_list_sync",
+                "platform_status_source": "fetch_items.reconciliation",
+                "platform_status_updated_at": now,
+                "last_status_check_at": now,
+            })
+            item.metadata_json = metadata
+            flag_modified(item, "metadata_json")
+            self.session.add(item)
+            changed = True
+
+        authoritative_confirmation = await self._confirm_missing_items_authoritatively(
+            account,
+            missing_items,
+            now,
+            force=force_authoritative_probe,
+        )
+        if authoritative_confirmation.get("updated_count"):
+            changed = True
+
+        previous_active_count = len(previously_active)
+        if previous_active_count > 0 and len(current_item_ids) == 0:
+            changed = await self._set_account_platform_restriction(
+                account,
+                state=self.ACCOUNT_RESTRICTION_SUSPECTED,
+                reason="all_active_items_missing_after_complete_sync",
+                source="fetch_items.reconciliation",
+                now=now,
+                previous_active_count=previous_active_count,
+                current_active_count=0,
+            ) or changed
+        elif current_item_ids:
+            record = self._get_platform_restriction_record(account)
+            if (
+                record.get("state") == self.ACCOUNT_RESTRICTION_SUSPECTED
+                and record.get("source") == "fetch_items.reconciliation"
+            ):
+                changed = await self._set_account_platform_restriction(
+                    account,
+                    state=self.ACCOUNT_RESTRICTION_NORMAL,
+                    reason="active_items_seen_after_complete_sync",
+                    source="fetch_items.reconciliation",
+                    now=now,
+                    previous_active_count=previous_active_count,
+                    current_active_count=len(current_item_ids),
+                ) or changed
+
+        if changed:
+            await self.session.commit()
+
+        return {
+            "reconciled": True,
+            "previous_active_count": previous_active_count,
+            "current_active_count": len(current_item_ids),
+            "missing_count": len(missing_items),
+            "missing_item_ids": [item.item_id for item in missing_items[:20]],
+            "authoritative_confirmation": authoritative_confirmation,
+        }
+
+    async def probe_account_publish_restriction(
