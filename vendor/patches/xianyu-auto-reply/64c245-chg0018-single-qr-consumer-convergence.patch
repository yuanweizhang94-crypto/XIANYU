+async def _load_websocket_task_statuses(
+    accounts: list[XYAccount],
+    online_ids: frozenset[str],
+) -> dict[str, dict[str, Any]]:
+    """Read existing WebSocket task state for enabled accounts without creating a second manager."""
+    from app.services.websocket_client import websocket_client
+
+    statuses: dict[str, dict[str, Any]] = {
+        account_id: {"running": True, "is_connected": True, "connection_state": "connected"}
+        for account_id in online_ids
+    }
+    targets = [
+        account
+        for account in accounts
+        if _status_to_enabled(account.status) and account.account_id not in online_ids
+    ]
+    if not targets:
+        return statuses
+
+    async def _read_one(account: XYAccount) -> tuple[str, dict[str, Any]]:
+        try:
+            response = await asyncio.wait_for(
+                websocket_client.get_account_status(account.account_id),
+                timeout=2.0,
+            )
+            if isinstance(response, dict) and response.get("success"):
+                data = response.get("data")
+                if isinstance(data, dict):
+                    return account.account_id, data
+        except Exception:
+            pass
+        return account.account_id, {}
+
+    results = await asyncio.gather(*(_read_one(account) for account in targets))
+    statuses.update(dict(results))
+    return statuses
+
+
+def _build_business_capabilities(
+    account: XYAccount,
+    ws_status: dict[str, Any],
+    checked_at: str,
+) -> dict[str, Any]:
+    enabled = _status_to_enabled(account.status)
+    metadata = account.metadata_json if isinstance(account.metadata_json, dict) else {}
+    session_maintenance = metadata.get("session_maintenance")
+    if not isinstance(session_maintenance, dict):
+        session_maintenance = {}
+    chat = _consumer_record(session_maintenance, "chat")
+    publish = _consumer_record(session_maintenance, "publish")
+    restriction = _build_platform_restriction(account)
+
+    if not enabled:
+        disabled = _business_capability(
+            state="DISABLED",
+            label="停用",
+            reason=account.disable_reason or "account_disabled",
+            source="account_status",
+            last_checked_at=safe_isoformat(account.updated_at),
+            auto_recoverable=False,
+        )
+        return {"auto_reply": dict(disabled), "chat": dict(disabled), "publish": dict(disabled)}
+
+    ws_running = bool(ws_status.get("running"))
+    ws_connected = bool(ws_status.get("is_connected")) or str(ws_status.get("connection_state") or "") == "connected"
+    if ws_connected:
+        auto_reply = _business_capability(
+            state="ONLINE",
+            label="在线",
+            reason="websocket_connected",
+            source="websocket_manager",
+            last_checked_at=checked_at,
+            auto_recoverable=True,
+        )
+    elif ws_running:
+        auto_reply = _business_capability(
+            state="RECOVERING",
+            label="恢复中",
+            reason="websocket_task_running_disconnected",
+            source="websocket_manager",
+            last_checked_at=checked_at,
+            auto_recoverable=True,
+        )
+    else:
+        auto_reply = _business_capability(
+            state="OFFLINE",
+            label="离线",
+            reason="websocket_task_not_running",
+            source="websocket_manager",
+            last_checked_at=checked_at,
+            auto_recoverable=True,
+        )
+
+    chat_state = str(chat.get("state") or "PENDING")
+    chat_reason = str(chat.get("reason") or "chat_readiness_pending")
+    chat_checked_at = chat.get("updated_at") or checked_at
+    if chat_state == "READY":
+        chat_capability = _business_capability(
+            state="READY", label="可用", reason=chat_reason or "chat_auth_ready",
+            source="chat_auth_readiness", last_checked_at=chat_checked_at, auto_recoverable=True,
+        )
+    elif chat_state in {"HUMAN_QR_REQUIRED", "SESSION_EXPIRED"}:
+        chat_capability = _business_capability(
+            state="LOGIN_REQUIRED", label="需登录", reason=chat_reason or "chat_login_required",
+            source="chat_auth_readiness", last_checked_at=chat_checked_at, auto_recoverable=False,
+        )
+    elif chat_state == "PLATFORM_VERIFICATION_REQUIRED":
+        chat_capability = _business_capability(
+            state="PLATFORM_VERIFICATION_REQUIRED", label="需平台验证",
+            reason=chat_reason or "platform_verification_required",
+            source="chat_auth_readiness", last_checked_at=chat_checked_at, auto_recoverable=False,
+        )
+    elif chat_state == "TEMPORARY_FAILURE":
+        chat_capability = _business_capability(
+            state="TEMPORARY_FAILURE", label="暂不可用", reason=chat_reason,
+            source="chat_auth_readiness", last_checked_at=chat_checked_at, auto_recoverable=True,
+        )
+    else:
+        chat_capability = _business_capability(
+            state="RECOVERING", label="恢复中", reason=chat_reason,
+            source="chat_auth_readiness", last_checked_at=chat_checked_at, auto_recoverable=True,
+        )
+
+    restriction_state = str(restriction.get("platform_restriction_state") or "UNKNOWN")
+    browser_state = str(session_maintenance.get("state") or "SESSION_CHECK_PENDING")
+    publish_state = str(publish.get("state") or "PENDING")
+    publish_reason = str(publish.get("reason") or session_maintenance.get("failure_reason") or "")
+    publish_checked_at = (
+        restriction.get("platform_restriction_updated_at")
+        or publish.get("updated_at")
+        or session_maintenance.get("updated_at")
+        or checked_at
+    )
+
+    if restriction_state == "PUBLISH_RESTRICTED":
+        publish_capability = _business_capability(
+            state="RESTRICTED", label="限制发布",
+            reason=str(restriction.get("platform_restriction_reason") or "publish_restricted"),
+            source=str(restriction.get("platform_restriction_source") or "platform_restriction"),
+            last_checked_at=publish_checked_at, auto_recoverable=False,
+        )
+    elif restriction_state == "PLATFORM_VERIFICATION_REQUIRED" or browser_state == "PLATFORM_VERIFICATION_REQUIRED" or publish_state == "PLATFORM_VERIFICATION_REQUIRED":
+        publish_capability = _business_capability(
+            state="PLATFORM_VERIFICATION_REQUIRED", label="需平台验证",
+            reason=publish_reason or str(restriction.get("platform_restriction_reason") or "platform_verification_required"),
+            source="canonical_browser_session", last_checked_at=publish_checked_at, auto_recoverable=False,
+        )
+    elif browser_state == "HUMAN_QR_REQUIRED" or publish_state == "HUMAN_QR_REQUIRED":
+        publish_capability = _business_capability(
+            state="QR_REQUIRED", label="需扫码",
+            reason=publish_reason or str(session_maintenance.get("failure_reason") or "LOGIN_OR_QR_UI_VISIBLE"),
+            source="canonical_browser_session", last_checked_at=publish_checked_at, auto_recoverable=False,
+        )
+    elif browser_state in {"SESSION_RENEWING", "SESSION_RENEWABLE"} or publish_state == "SESSION_EXPIRED":
+        publish_capability = _business_capability(
+            state="RECOVERING", label="恢复中", reason=publish_reason or browser_state,
+            source="session_maintenance", last_checked_at=publish_checked_at, auto_recoverable=True,
+        )
+    elif browser_state == "SESSION_CHECK_PENDING" or publish_state == "PENDING":
+        publish_capability = _business_capability(
+            state="CHECKING", label="检查中", reason=publish_reason or "session_check_pending",
+            source="session_maintenance", last_checked_at=publish_checked_at, auto_recoverable=True,
+        )
+    elif browser_state == "COOLDOWN" or publish_state in {"PROFILE_BUSY", "TEMPORARY_FAILURE", "COOLDOWN"}:
+        publish_capability = _business_capability(
+            state="RETRY_LATER", label="稍后重试", reason=publish_reason or browser_state,
+            source="session_maintenance", last_checked_at=publish_checked_at, auto_recoverable=True,
+        )
+    elif publish_state == "READY":
+        publish_capability = _business_capability(
+            state="READY", label="可用", reason=publish_reason or "publish_auth_ready",
+            source="publish_auth_readiness", last_checked_at=publish_checked_at, auto_recoverable=True,
+        )
+    else:
+        publish_capability = _business_capability(
+            state="UNKNOWN", label="未知", reason=publish_reason or publish_state,
+            source="publish_auth_readiness", last_checked_at=publish_checked_at, auto_recoverable=False,
+        )
+
+    return {
+        "auto_reply": auto_reply,
+        "chat": chat_capability,
+        "publish": publish_capability,
+    }
+
