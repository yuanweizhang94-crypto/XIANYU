+async def probe_account_publish_restriction(
+    *,
+    cookie: str | None,
+    account_id: str | None = None,
+    owner_id: int | None = None,
+    static_root: str | Path | None = None,
+) -> dict[str, Any]:
+    """Read-only compatibility probe backed by the current upstream preget capability check."""
+    del static_root
+    result = await detect_publish_account_capability(
+        cookie=cookie or "",
+        account_id=str(account_id or ""),
+        owner_id=owner_id,
+    )
+    message = str(result.get("message") or result.get("error") or "")
+    lowered = message.lower()
+    if result.get("success"):
+        return {
+            "success": True,
+            "probe_mode": "READ_ONLY",
+            "state": "NORMAL",
+            "reason": "upstream_preget_capability_ready",
+            "restriction_until": None,
+            "duration_seconds": None,
+            "source": "detect_publish_account_capability",
+            "evidence_type": "UPSTREAM_PREGET_SUCCESS",
+            "real_products_published": 0,
+        }
+    if (
+        "user_was_forbidden2" in lowered
+        or "发布权限被限制" in message
+        or "限制发布" in message
+        or "无法发布" in message
+    ):
+        return {
+            "success": True,
+            "probe_mode": "READ_ONLY",
+            "state": "PUBLISH_RESTRICTED",
+            "reason": message[:180] or "upstream_preget_publish_restricted",
+            "restriction_until": None,
+            "duration_seconds": None,
+            "source": "detect_publish_account_capability",
+            "evidence_type": "UPSTREAM_PREGET_RESTRICTION",
+            "real_products_published": 0,
+        }
+    if any(marker in lowered for marker in ("session", "login", "token")) or any(
+        marker in message for marker in ("登录", "扫码")
+    ):
+        state = "HUMAN_QR_REQUIRED"
+    elif any(marker in lowered for marker in ("captcha", "verification", "validate")) or any(
+        marker in message for marker in ("验证", "滑块")
+    ):
+        state = "PLATFORM_VERIFICATION_REQUIRED"
+    else:
+        state = "UNKNOWN"
+    return {
+        "success": False,
+        "probe_mode": "READ_ONLY",
+        "state": state,
+        "reason": message[:180] or "upstream_preget_probe_failed",
+        "restriction_until": None,
+        "duration_seconds": None,
+        "source": "detect_publish_account_capability",
+        "evidence_type": "NO_AUTHORITATIVE_RESTRICTION",
+        "real_products_published": 0,
+    }
