+def _extract_item_sync_result_item_ids(result: dict[str, Any]) -> list[str]:
+    raw_items = result.get("items")
+    if not isinstance(raw_items, list):
+        return []
+    item_ids: list[str] = []
+    seen: set[str] = set()
+    for item in raw_items:
+        if not isinstance(item, dict):
+            continue
+        item_id = str(item.get("item_id") or item.get("id") or "").strip()
+        if item_id and item_id not in seen:
+            seen.add(item_id)
+            item_ids.append(item_id)
+    return item_ids
+
+
+async def _read_item_sync_durable_state(
+    session: AsyncSession,
+    *,
+    account: Any,
+    result: dict[str, Any],
+) -> dict[str, Any]:
+    """Read back xy_catalog_items after ItemService writes, without remote side effects."""
+    account_pk = getattr(account, "id", None)
+    fetched_item_ids = _extract_item_sync_result_item_ids(result)
+
+    account_row_count_stmt = select(func.count(XYCatalogItem.id)).where(
+        XYCatalogItem.account_pk == account_pk
+    )
+    account_row_count = int((await session.execute(account_row_count_stmt)).scalar() or 0)
+
+    duplicate_stmt = (
+        select(XYCatalogItem.item_id, func.count(XYCatalogItem.id).label("row_count"))
+        .where(XYCatalogItem.account_pk == account_pk)
+        .group_by(XYCatalogItem.item_id)
+        .having(func.count(XYCatalogItem.id) > 1)
+    )
+    duplicate_rows = (await session.execute(duplicate_stmt)).all()
+    duplicate_group_count = len(duplicate_rows)
+    duplicate_row_count = sum(max(0, int(row_count) - 1) for _, row_count in duplicate_rows)
+
+    matched_response_item_count = 0
+    if fetched_item_ids:
+        matched_stmt = select(func.count(func.distinct(XYCatalogItem.item_id))).where(
+            XYCatalogItem.account_pk == account_pk,
+            XYCatalogItem.item_id.in_(fetched_item_ids),
+        )
+        matched_response_item_count = int((await session.execute(matched_stmt)).scalar() or 0)
+
+    response_total_count = int(result.get("total_count") or result.get("total") or 0)
+    saved_count = int(result.get("saved_count") or result.get("saved") or 0)
+    response_item_id_count = len(fetched_item_ids)
+    result_success = bool(result.get("success"))
+    reconciled = (
+        result_success
+        and duplicate_group_count == 0
+        and response_total_count == response_item_id_count
+        and matched_response_item_count == response_item_id_count
+        and saved_count <= account_row_count
+    )
+
+    return {
+        "source": "xy_catalog_items",
+        "query_success": True,
+        "checked": reconciled,
+        "reconciled": reconciled,
+        "account_row_count": account_row_count,
+        "response_total_count": response_total_count,
+        "response_item_id_count": response_item_id_count,
+        "matched_response_item_count": matched_response_item_count,
+        "saved_count": saved_count,
+        "duplicate_count": duplicate_group_count,
+        "duplicate_row_count": duplicate_row_count,
+        "unique_contract": "account_id,item_id",
+    }
+
+
+async def _attach_item_sync_canary_contract(
+    result: dict[str, Any],
+    *,
+    session: AsyncSession,
+    account: Any,
+    operation_id: str,
+    request_id: str | None,
+    page_size: int,
+    max_pages: int | None,
+) -> dict[str, Any]:
+    masked_account_id = _mask_account_id(getattr(account, "account_id", None))
+    response = dict(result)
+    try:
+        durable_readback = await _read_item_sync_durable_state(
+            session,
+            account=account,
+            result=response,
+        )
+        sync_status = (
+            "SUCCESS"
+            if bool(response.get("success")) and bool(durable_readback.get("checked"))
+            else "FAILED"
+            if not bool(response.get("success"))
+            else "UNKNOWN"
+        )
+    except Exception as exc:
+        durable_readback = {
+            "source": "xy_catalog_items",
+            "query_success": False,
+            "checked": False,
+            "reconciled": False,
+            "failure_reason": f"DURABLE_READBACK_QUERY_FAILED:{type(exc).__name__}",
+            "duplicate_count": None,
+            "unique_contract": "account_id,item_id",
+        }
+        sync_status = "UNKNOWN"
+        response["success"] = False
+        response["message"] = f"Item Sync durable readback failed closed: {type(exc).__name__}"
+
+    response.update(
+        {
+            "operation_id": operation_id,
+            "request_id": str(request_id or operation_id),
+            "masked_account_id": masked_account_id,
+            "sync_status": sync_status,
+            "terminal": True,
+            "retry_allowed": False,
+            "owner": "ItemService.fetch_all_items_from_account",
+            "durable_readback": durable_readback,
+            "page_size": page_size,
+            "max_pages": max_pages,
+        }
+    )
+    logger.info(
+        "CHG0030_ITEM_SYNC_TERMINAL_READBACK %s",
+        {
+            "operation_id": operation_id,
+            "request_id": str(request_id or operation_id),
+            "masked_account_id": masked_account_id,
+            "terminal_state": sync_status,
+            "durable_checked": durable_readback.get("checked"),
+            "account_row_count": durable_readback.get("account_row_count"),
+            "response_total_count": durable_readback.get("response_total_count"),
+            "matched_response_item_count": durable_readback.get("matched_response_item_count"),
+            "duplicate_count": durable_readback.get("duplicate_count"),
+            "retry_allowed": False,
+        },
+    )
+    return response
+
+
