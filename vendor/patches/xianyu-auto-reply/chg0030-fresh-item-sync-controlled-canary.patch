+            "token_ready": token_ready if token_ready_known else None,
+        },
+    }
+    logger.info(
+        "CHG0030_ITEM_SYNC_PREFLIGHT_STATUS %s",
+        {
+            "masked_account_id": _mask_account_id_for_log(account.account_id),
+            "state": capability["state"],
+            "item_sync_eligible": item_sync_eligible,
+            "failure_reasons": failure_reasons,
+            "checked": True,
+        },
+    )
+    return capability
+
