+from __future__ import annotations
+
+import asyncio
+import importlib.util
+import sys
+import types
+from pathlib import Path
+from types import SimpleNamespace
+
+
+ROOT = Path(__file__).resolve().parents[1]
+ITEMS_ROUTE = ROOT / "backend-web/app/api/routes/items.py"
+COOKIES_ROUTE = ROOT / "backend-web/app/api/routes/cookies.py"
+
+
+class _ApiResponse:
+    def __init__(self, *, success: bool, message: str, data=None):
+        self.success = success
+        self.message = message
+        self.data = data
+
+
+class _Router:
+    def __init__(self, *args, **kwargs):
+        pass
+
+    def get(self, *args, **kwargs):
+        return lambda func: func
+
+    def post(self, *args, **kwargs):
+        return lambda func: func
+
+    def put(self, *args, **kwargs):
+        return lambda func: func
+
+    def delete(self, *args, **kwargs):
+        return lambda func: func
+
+
+def _ensure_module(monkeypatch, name: str) -> types.ModuleType:
+    module = types.ModuleType(name)
+    monkeypatch.setitem(sys.modules, name, module)
+    return module
+
+
+def _install_route_stubs(monkeypatch) -> None:
+    sys.path[:0] = [str(ROOT), str(ROOT / "backend-web")]
+
+    app = _ensure_module(monkeypatch, "app")
+    app.__path__ = []
+    api = _ensure_module(monkeypatch, "app.api")
+    api.__path__ = []
+    deps = _ensure_module(monkeypatch, "app.api.deps")
+    deps.get_current_active_user = object()
+    deps.get_account_service = object()
+    deps.get_item_service = object()
+    deps.get_default_reply_service = object()
+    deps.get_db_session = object()
+
+    services = _ensure_module(monkeypatch, "app.services")
+    services.__path__ = []
+    core = _ensure_module(monkeypatch, "app.core")
+    core.__path__ = []
+    paths = _ensure_module(monkeypatch, "app.core.paths")
+    paths.STATIC_ROOT = ROOT / "static"
+    account_service = _ensure_module(monkeypatch, "app.services.account_service")
+    account_service.AccountService = object
+    item_service = _ensure_module(monkeypatch, "app.services.item_service")
+    item_service.ItemService = object
+    selectable_item_service = _ensure_module(monkeypatch, "app.services.selectable_item_service")
+    selectable_item_service.SelectableItemService = object
+    auto_reply_stats = _ensure_module(monkeypatch, "app.services.auto_reply_stats_service")
+    auto_reply_stats.AutoReplyStatsService = object
+    dashboard_stats = _ensure_module(monkeypatch, "app.services.dashboard_stats_service")
+    dashboard_stats.DashboardStatsService = object
+
+    common_schemas = _ensure_module(monkeypatch, "common.schemas.common")
+    common_schemas.ApiResponse = _ApiResponse
+    offline = _ensure_module(monkeypatch, "common.services.item_offline_service")
+    offline.batch_offline_items_from_xianyu = object()
+    delete = _ensure_module(monkeypatch, "common.services.item_delete_service")
+    delete.batch_delete_items_from_xianyu = object()
+    ai_provider = _ensure_module(monkeypatch, "common.services.ai_provider_service")
+    ai_provider.read_ai_enabled = lambda *args, **kwargs: False
+    token_cache = _ensure_module(monkeypatch, "common.services.token_renewal_cache_service")
+    token_cache.mark_token_cache_expired = lambda *args, **kwargs: None
+
+    fastapi = _ensure_module(monkeypatch, "fastapi")
+    fastapi.APIRouter = _Router
+    fastapi.Body = lambda default=None, **kwargs: default
+    fastapi.Depends = lambda dependency=None: dependency
+    fastapi.File = lambda default=None, **kwargs: default
+    fastapi.Form = lambda default=None, **kwargs: default
+    fastapi.HTTPException = Exception
+    fastapi.Query = lambda default=None, **kwargs: default
+    fastapi.Request = object
+    fastapi.Response = object
+    fastapi.UploadFile = object
+    fastapi.status = types.SimpleNamespace(HTTP_401_UNAUTHORIZED=401)
+
+
+def _load_module(monkeypatch, path: Path, name: str):
+    _install_route_stubs(monkeypatch)
+    sys.modules.pop(name, None)
+    spec = importlib.util.spec_from_file_location(name, path)
+    assert spec is not None
+    module = importlib.util.module_from_spec(spec)
+    assert spec.loader is not None
+    spec.loader.exec_module(module)
+    return module
+
+
+class _ScalarResult:
+    def __init__(self, value):
+        self.value = value
+
+    def scalar(self):
+        return self.value
+
+    def all(self):
+        return self.value
+
+
+class _ReadbackSession:
+    def __init__(self, values):
+        self.values = list(values)
+        self.statement_count = 0
+
+    async def execute(self, _stmt):
+        self.statement_count += 1
+        value = self.values.pop(0)
+        if isinstance(value, BaseException):
+            raise value
+        return _ScalarResult(value)
+
+
+def test_get_all_from_account_durable_readback_measures_db_counts(monkeypatch) -> None:
+    module = _load_module(monkeypatch, ITEMS_ROUTE, "chg0030_items_route")
+    session = _ReadbackSession([2, [], 2])
+    account = SimpleNamespace(id=7, account_id="221234567890")
+
+    result = asyncio.run(
+        module._attach_item_sync_canary_contract(
+            {
+                "success": True,
+                "message": "ok",
+                "total_count": 2,
+                "saved_count": 2,
+                "items": [{"item_id": "item-a"}, {"item_id": "item-b"}],
+            },
+            session=session,
+            account=account,
+            operation_id="op-1",
+            request_id="req-1",
+            page_size=20,
+            max_pages=1,
+        )
+    )
+
+    assert session.statement_count == 3
+    assert result["sync_status"] == "SUCCESS"
+    assert result["retry_allowed"] is False
+    assert result["masked_account_id"] == "22*********90"
+    assert result["durable_readback"]["checked"] is True
+    assert result["durable_readback"]["account_row_count"] == 2
+    assert result["durable_readback"]["duplicate_count"] == 0
+    assert result["durable_readback"]["matched_response_item_count"] == 2
+
+
+def test_get_all_from_account_query_failure_is_terminal_unknown(monkeypatch) -> None:
+    module = _load_module(monkeypatch, ITEMS_ROUTE, "chg0030_items_route_failure")
+    session = _ReadbackSession([RuntimeError("db unavailable")])
+    account = SimpleNamespace(id=7, account_id="221234567890")
+
+    result = asyncio.run(
+        module._attach_item_sync_canary_contract(
+            {"success": True, "total_count": 1, "saved_count": 1, "items": [{"item_id": "item-a"}]},
+            session=session,
+            account=account,
+            operation_id="op-2",
+            request_id=None,
+            page_size=20,
+            max_pages=None,
+        )
+    )
+
+    assert result["success"] is False
+    assert result["sync_status"] == "UNKNOWN"
+    assert result["terminal"] is True
+    assert result["retry_allowed"] is False
+    assert result["durable_readback"]["query_success"] is False
+    assert result["durable_readback"]["duplicate_count"] is None
+
+
+def test_item_sync_preflight_pass_requires_authoritative_facts(monkeypatch) -> None:
+    module = _load_module(monkeypatch, COOKIES_ROUTE, "chg0030_cookies_route")
+    cookie = "a=1; b=2"
+    account = SimpleNamespace(status="active", cookie=cookie, account_id="221234567890")
+    session_maintenance = {
+        "state": "REAL_BROWSER_LOGIN_READY",
+        "cookie_fingerprint": module.cookie_fingerprint(cookie),
+    }
+
+    capability = module._build_item_sync_preflight_capability(
+        account=account,
+        ws_status={"token_ready": True},
+        session_maintenance=session_maintenance,
+        platform_verification={"required": False, "source": "none", "evidence_type": "NONE"},
+        checked_at="2026-08-25T00:00:00Z",
+    )
+
+    assert capability["item_sync_eligible"] is True
+    assert capability["fail_closed"] is False
+    assert capability["failure_reasons"] == []
+    assert capability["facts"]["session_cookie_lineage"] == "MATCH"
+
+
+def test_item_sync_preflight_fails_closed_on_unknown_lineage_or_token(monkeypatch) -> None:
+    module = _load_module(monkeypatch, COOKIES_ROUTE, "chg0030_cookies_route_unknown")
+    account = SimpleNamespace(status="active", cookie="a=1", account_id="221234567890")
+
+    capability = module._build_item_sync_preflight_capability(
+        account=account,
+        ws_status={},
+        session_maintenance={},
+        platform_verification={},
+        checked_at="2026-08-25T00:00:00Z",
+    )
