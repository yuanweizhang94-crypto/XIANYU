+def _build_item_sync_preflight_capability(
+    *,
+    account: XYAccount,
+    ws_status: dict[str, Any],
+    session_maintenance: dict[str, Any],
+    platform_verification: dict[str, Any],
+    checked_at: str,
+) -> dict[str, Any]:
+    enabled = _status_to_enabled(account.status)
+    has_cookie = bool((account.cookie or "").strip())
+    session_state = str(session_maintenance.get("state") or "")
+    stored_cookie_fingerprint = str(session_maintenance.get("cookie_fingerprint") or "")
+    current_cookie_fingerprint = cookie_fingerprint(account.cookie or "") if has_cookie else ""
+    session_cookie_lineage_matches = bool(
+        stored_cookie_fingerprint
+        and current_cookie_fingerprint
+        and stored_cookie_fingerprint == current_cookie_fingerprint
+    )
+    session_check_active, session_check_expired = _bounded_operation_active(
+        session_maintenance,
+        active_key="check_active",
+        deadline_key="check_deadline_at",
+    )
+    checking_state_known = bool(session_state)
+    checking_clear = (
+        checking_state_known
+        and not session_check_active
+        and session_state in {"REAL_BROWSER_LOGIN_READY", "SESSION_RENEW_SUCCESS", "AUTH_VALID", "READY"}
+    )
+    platform_verification_known = "required" in platform_verification and "evidence_type" in platform_verification
+    platform_verification_required = bool(platform_verification.get("required"))
+    token_ready_known = "token_ready" in ws_status
+    token_ready = bool(ws_status.get("token_ready"))
+
+    failure_reasons: list[str] = []
+    if not enabled:
+        failure_reasons.append("ACCOUNT_DISABLED")
+    if not has_cookie:
+        failure_reasons.append("COOKIE_MISSING")
+    if not checking_state_known:
+        failure_reasons.append("CHECKING_STATE_UNKNOWN")
+    elif not checking_clear:
+        failure_reasons.append("CHECKING_NOT_CLEAR" if not session_check_expired else "CHECKING_EXPIRED_UNKNOWN")
+    if not platform_verification_known:
+        failure_reasons.append("PLATFORM_VERIFICATION_UNKNOWN")
+    elif platform_verification_required:
+        failure_reasons.append("PLATFORM_VERIFICATION_REQUIRED")
+    if not session_cookie_lineage_matches:
+        failure_reasons.append("SESSION_COOKIE_LINEAGE_UNKNOWN")
+    if not token_ready_known:
+        failure_reasons.append("TOKEN_NOT_READY_OR_UNKNOWN")
+    elif not token_ready:
+        failure_reasons.append("TOKEN_NOT_READY_OR_UNKNOWN")
+
+    item_sync_eligible = not failure_reasons
+    capability = {
+        "state": "READY" if item_sync_eligible else "UNKNOWN",
+        "mode": "SELECTED_ACCOUNT_PREFLIGHT",
+        "checked": True,
+        "item_sync_eligible": item_sync_eligible,
+        "fail_closed": not item_sync_eligible,
+        "failure_reason": None if item_sync_eligible else failure_reasons[0],
+        "failure_reasons": failure_reasons,
+        "source": "account_status_sanitized_preflight",
+        "last_checked_at": checked_at,
+        "auto_recoverable": False,
+        "facts": {
+            "disabled": not enabled,
+            "checking_state": session_state or "UNKNOWN",
+            "checking_active": bool(session_check_active),
+            "platform_verification_source": str(platform_verification.get("source") or "unknown"),
+            "platform_verification_required": platform_verification_required,
