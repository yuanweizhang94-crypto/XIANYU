+    async def _owner_action_context_path(self, element) -> list[int] | None:
+        """Capture the exact pre-action owner-operation DOM location for post-action verification."""
+        try:
+            path = await element.evaluate(
+                """
+                (el) => {
+                    let node = el;
+                    for (let depth = 0; node && depth < 7; depth += 1, node = node.parentElement) {
+                        const text = (node.innerText || node.textContent || '').replace(/\\s+/g, ' ').trim();
+                        if (!text.includes('下架') || !text.includes('删除') || text.length > 500) continue;
+                        const path = [];
+                        let current = node;
+                        while (current && current !== document.body) {
+                            const parent = current.parentElement;
+                            if (!parent) return null;
+                            const index = Array.prototype.indexOf.call(parent.children, current);
+                            if (index < 0) return null;
+                            path.unshift(index);
+                            current = parent;
+                        }
+                        return current === document.body ? path : null;
+                    }
+                    return null;
+                }
+                """
+            )
+            if not isinstance(path, list):
+                return None
+            return [int(index) for index in path]
+        except Exception:
+            return None
