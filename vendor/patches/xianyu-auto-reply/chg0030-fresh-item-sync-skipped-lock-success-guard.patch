+def test_skipped_lock_result_is_terminal_unknown_not_success(monkeypatch) -> None:
+    module = _load_module(monkeypatch, ITEMS_ROUTE, "chg0030_items_route_skipped")
+    session = _ReadbackSession([0, []])
+    account = SimpleNamespace(id=7, account_id="221234567890")
+
+    result = asyncio.run(
+        module._attach_item_sync_canary_contract(
+            {
+                "success": True,
+                "skipped": True,
+                "message": "Item sync already running",
+                "total_count": 0,
+                "total_pages": 0,
+                "page_size": 20,
+                "saved_count": 0,
+                "items": [],
+            },
+            session=session,
+            account=account,
+            operation_id="op-skipped",
+            request_id="req-skipped",
+            page_size=20,
+            max_pages=None,
+        )
+    )
+
+    assert result["success"] is False
+    assert result["sync_status"] == "UNKNOWN"
+    assert result["terminal"] is True
+    assert result["retry_allowed"] is False
+    assert result["durable_readback"]["checked"] is False
+    assert result["durable_readback"]["reconciled"] is False
+    assert result["durable_readback"]["failure_reason"] == "OWNER_LOCK_OCCUPIED_SKIPPED"
+    assert result["durable_readback"]["skipped"] is True
+
+
+def test_success_requires_full_active_list_confirmed(monkeypatch) -> None:
+    module = _load_module(monkeypatch, ITEMS_ROUTE, "chg0030_items_route_incomplete")
+    session = _ReadbackSession([1, [], 1])
+    account = SimpleNamespace(id=7, account_id="221234567890")
+
+    result = asyncio.run(
+        module._attach_item_sync_canary_contract(
+            {
+                "success": True,
+                "message": "ok",
+                "total_count": 1,
+                "saved_count": 1,
+                "full_active_list_confirmed": False,
+                "sync_stop_reason": "max_pages_limit",
+                "items": [{"item_id": "item-a"}],
+            },
+            session=session,
+            account=account,
+            operation_id="op-incomplete",
+            request_id="req-incomplete",
+            page_size=20,
+            max_pages=1,
+        )
+    )
+
+    assert session.statement_count == 3
+    assert result["success"] is False
+    assert result["sync_status"] == "UNKNOWN"
+    assert result["retry_allowed"] is False
