+async def _record_chat_readiness(
+    *,
+    account_id: str,
+    state: str,
+    reason: str = "",
+    auth_fingerprint: str = "",
+) -> None:
+    try:
+        async with async_session_maker() as session:
+            result = await session.execute(
+                text(
+                    "SELECT id, metadata FROM xy_accounts "
+                    "WHERE account_id = :account_id ORDER BY id DESC LIMIT 1"
+                ),
+                {"account_id": account_id},
+            )
+            row = result.mappings().first()
+            if not row:
+                return
+            metadata = _metadata_dict(row.get("metadata"))
+            session_state = dict(metadata.get("session_maintenance") or {})
+            consumers = dict(session_state.get("consumers") or {})
+            record = {
+                "state": state,
+                "updated_at": get_beijing_now_naive().isoformat(),
+                "reason": reason,
+            }
+            if auth_fingerprint:
+                record["auth_fingerprint"] = auth_fingerprint[:12]
+            consumers["chat"] = record
+            session_state["consumers"] = consumers
+            metadata["session_maintenance"] = session_state
+            await session.execute(
+                text("UPDATE xy_accounts SET metadata = :metadata WHERE id = :id"),
+                {"metadata": json.dumps(metadata, ensure_ascii=False), "id": row["id"]},
+            )
+            await session.commit()
+    except Exception as exc:
+        logger.warning(f"【{account_id}】Chat readiness记录失败: {exc}")
+
+
+def _classify_chat_readiness_failure(body: Any) -> tuple[str, str]:
+    text_body = (
+        json.dumps(body, ensure_ascii=False)
+        if isinstance(body, (dict, list))
+        else str(body or "")
+    )
+    lowered = text_body.lower()
+    if "fail_sys_user_validate" in lowered or "rgv587_error" in lowered or "captcha" in lowered:
+        return "PLATFORM_VERIFICATION_REQUIRED", "platform_verification_required"
+    if "human_qr_required" in lowered or "login_required" in lowered:
+        return "HUMAN_QR_REQUIRED", "authoritative_session_required_qr"
+    if "400600001" in text_body:
+        return "TEMPORARY_FAILURE", "chat_rate_limited"
+    if "timeout" in lowered or "network" in lowered:
+        return "TEMPORARY_FAILURE", "temporary_network"
+    if "disconnect" in lowered or "closed" in lowered:
+        return "DISCONNECTED", "chat_disconnected"
+    return "TEMPORARY_FAILURE", "chat_read_failed"
+
