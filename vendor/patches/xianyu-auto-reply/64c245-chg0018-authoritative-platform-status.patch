+def _parse_iso_datetime(value: Any) -> datetime | None:
+    if not value:
+        return None
+    try:
+        parsed = datetime.fromisoformat(str(value).strip().replace("Z", "+00:00"))
+        if parsed.tzinfo is None:
+            parsed = parsed.replace(tzinfo=timezone.utc)
+        return parsed
+    except Exception:
+        return None
+
+
+def get_effective_publish_restriction(metadata: Any, *, now: datetime | None = None) -> dict[str, Any] | None:
+    if not isinstance(metadata, dict):
+        return None
+    record = metadata.get("platform_restriction")
+    if not isinstance(record, dict) or record.get("state") != "PUBLISH_RESTRICTED":
+        return None
+    current = now or datetime.now(timezone.utc)
+    until = _parse_iso_datetime(record.get("restriction_until"))
+    if until and until <= current:
+        return None
+    checked_at = _parse_iso_datetime(record.get("last_checked_at") or record.get("updated_at"))
+    if not until and checked_at and current - checked_at > timedelta(hours=24):
+        return None
+    return record
+
+
+def build_publish_restriction_failure(record: dict[str, Any]) -> dict[str, Any]:
+    reason = str(record.get("reason") or "official_publish_restriction_detected")
+    until = record.get("restriction_until")
+    return {
+        "success": False,
+        "message": "PUBLISH_BLOCKED_BY_PLATFORM_RESTRICTION",
+        "failure_reason": "PUBLISH_BLOCKED_BY_PLATFORM_RESTRICTION",
+        "platform_restriction_reason": reason,
+        "platform_restriction_until": until,
+        "diagnostics": {
+            "source": record.get("source"),
+            "evidence_type": record.get("evidence_type"),
+        },
+    }
+
