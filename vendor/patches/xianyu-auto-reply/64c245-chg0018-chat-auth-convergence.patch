+    async def invalidate_auth_consumers(self, account_id: str, cookies_str: str | None = None) -> dict[str, Any]:
+        """
+        Invalidate Chat auth state after an authoritative Cookie rotation.
+
+        This only uses the existing in-memory Chat client and token-cache expiry semantics.
+        It does not delete cache rows or create another Session owner.
+        """
+        async with self._lock:
+            client = self.clients.pop(account_id, None)
+            disconnected = False
+            if client:
+                await client.disconnect()
+                disconnected = True
+
+        cookie_source = cookies_str
