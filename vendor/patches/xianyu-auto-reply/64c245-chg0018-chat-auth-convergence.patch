+            account_context = await self._get_account_context(account_id)
+            cookie_source = account_context[1] if account_context else ""
+
+        unb = ""
+        try:
+            unb = trans_cookies(cookie_source or "").get("unb", "")
+        except Exception:
+            unb = ""
+
+        token_cache_invalidated = False
+        if unb:
+            invalidation = await mark_token_cache_expired(
+                token_user_id=f"chat_{unb}",
+                invalidate_valid_cache=True,
+            )
+            token_cache_invalidated = invalidation.success
