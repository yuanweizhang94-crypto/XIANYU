+                logger.warning(f"【{account_id}】Chat Token缓存失效标记失败: {invalidation.message}")
+
+        logger.info(
+            f"【{account_id}】Chat auth consumers invalidated: "
+            f"client_disconnected={disconnected}, "
+            f"chat_token_cache_invalidated={token_cache_invalidated}"
+        )
+        return {
+            "client_disconnected": disconnected,
+            "chat_token_cache_invalidated": token_cache_invalidated,
+            "chat_token_cache_key_present": bool(unb),
+        }
