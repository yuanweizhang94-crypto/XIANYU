+        renew_method="api",
+        updated_cookie_names=[],
+        new_cookies_str="a=b",
+        api_message="renew failed",
+    )
+    with (
+        patch(
+            "common.services.cookie_renew_api_service.cookie_renew_api_service.renew",
+            new=AsyncMock(return_value=renew_result),
+        ),
+        patch("common.db.compat.db_manager.add_account_login_log", return_value=1),
