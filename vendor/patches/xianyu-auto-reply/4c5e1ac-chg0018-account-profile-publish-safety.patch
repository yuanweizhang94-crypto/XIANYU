+def _result(response_json, *, remote_failure_message: str = "") -> ImTokenApiResult:
+    return ImTokenApiResult(
+        response_json=response_json,
+        response_cookies={},
+        status_code=200,
+        duration_seconds=0.1,
+        remote_failure_message=remote_failure_message,
+    )
+
+
+def _manager_for_refresh():
+    parent = SimpleNamespace(
+        cookie_id="test-account",
+        cookies_str="a=b",
+        cookies={"a": "b"},
+        session=None,
+        current_token=None,
+        last_token_refresh_time=0,
+        last_token_refresh_status=None,
+        device_id="device-1",
+        myid="test-user",
+        max_captcha_verification_count=3,
+        last_message_received_time=0,
+        message_cookie_refresh_cooldown=300,
+        restarted_in_browser_refresh=False,
+        _using_expired_startup_token=False,
+        _safe_str=lambda value: str(value),
+        create_session=AsyncMock(),
+        send_token_refresh_notification=AsyncMock(),
+        restart_instance=AsyncMock(),
+    )
+    manager = CookieTokenManager(parent)
+    manager._is_local_slider_disabled = AsyncMock(return_value=False)
+    manager._get_cached_token = AsyncMock(return_value=None)
+    manager._get_processing_risk_control_skip_result = AsyncMock(return_value=(False, None))
+    manager._load_account_info = AsyncMock(return_value={"cookie_value": "a=b"})
+    manager._set_cached_token = AsyncMock()
+    manager._delete_cached_token = AsyncMock()
+    manager.handle_captcha_verification = AsyncMock()
+    manager.need_captcha_verification = Mock(return_value=False)
+    return manager, parent
+
