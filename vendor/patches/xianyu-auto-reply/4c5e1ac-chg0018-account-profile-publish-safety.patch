--- /dev/null
+++ b/tests/test_chg0018_auto_polish_safety.py
@@ -0,0 +1,70 @@
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+POLISH_TASK = ROOT / "scheduler/app/services/scheduler/polish_task.py"
+DAY_SWITCH_TASK = ROOT / "scheduler/app/services/scheduler/day_switch_task.py"
+
+
+def _source(path: Path) -> str:
+    return path.read_text(encoding="utf-8")
+
+
+def test_polish_execute_supports_account_scope_and_item_limit():
+    source = _source(POLISH_TASK)
+
+    assert "account_ids: set[str] | None = None" in source
+    assert "max_items_per_account: int | None = None" in source
+    assert "XYAccount.account_id.in_(account_ids)" in source
+    assert "limit=max_items_per_account" in source
+    assert "stmt = stmt.limit(limit)" in source
+
+
+def test_polish_waits_for_platform_day_and_fails_closed_on_redis_read_error():
+    source = _source(POLISH_TASK)
+
+    assert "PLATFORM_DAY_KEY = \"platform:day\"" in source
+    assert "if not await self._is_platform_day_ready()" in source
+    assert "platform_day_read_failed" in source
+    assert "return False" in source
+
+
+def test_no_credentials_do_not_trigger_password_login_from_polish():
+    source = _source(POLISH_TASK)
+
+    assert "if self._has_auto_login_credentials(account):" in source
+    assert "trigger_password_login_async(account.account_id)" in source
+    assert "no_credentials/login_required" in source
+    assert "account.status" not in source
+
+
+def test_polish_logs_are_sanitized_and_retry_is_bounded():
+    source = _source(POLISH_TASK)
+
+    assert "max_token_retries = 1" in source
+    assert "result={result}" not in source
+    assert "ret_code={ret_code}" in source
+    assert "set_cookie={has_set_cookie}" in source
+    assert "_mask_identifier(item_id)" in source
+    assert "NETWORK_ERROR: {type(e).__name__}" in source
+
+
+def test_duplicate_polish_results_are_successful():
+    source = _source(POLISH_TASK)
+
+    assert "def _is_duplicate_success" in source
+    assert "POLISH_DUPLICATE" in source
+    assert "IDLEITEM_POLISH_AGAIN" in source
+    assert "if not is_success and self._is_duplicate_success(error_msg):" in source
+    assert "if self._is_duplicate_success(error_msg):" in source
+
+
+def test_day_switch_distinguishes_missing_key_from_redis_failure():
+    source = _source(DAY_SWITCH_TASK)
+
+    assert "PLATFORM_DAY_READ_FAILED = object()" in source
+    assert "if platform_day is self.PLATFORM_DAY_READ_FAILED:" in source
+    assert "platform_day_read_failed; fail_closed=true" in source
+    assert "return self.PLATFORM_DAY_READ_FAILED" in source
