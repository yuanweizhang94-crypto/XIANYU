+from unittest.mock import AsyncMock, Mock, patch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "websocket"))
+
+from common.services.im_token_api import (
+    ImTokenApiResult,
+    _attach_remote_failure,
+    is_session_expired_token_result,
+)
+from common.services.remote_token_risk_log_service import build_remote_token_log_result
+from websocket.app.services.xianyu.cookie_token_manager import CookieTokenManager
+
+
+ROOT = Path(__file__).resolve().parents[1]
+COOKIE_TOKEN_MANAGER = ROOT / "websocket/app/services/xianyu/cookie_token_manager.py"
+TOKEN_REFETCH = ROOT / "common/services/captcha/token_refetch.py"
