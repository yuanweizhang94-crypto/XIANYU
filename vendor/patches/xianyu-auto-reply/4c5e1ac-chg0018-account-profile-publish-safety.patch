+def test_cookie_renew_success_reuses_session_without_password_or_qr_login():
+    manager, parent = _manager_for_refresh()
+    parent._last_password_login_time = {}
+    parent._password_error_cooldown_time = {}
+    manager.update_config_cookies = AsyncMock(return_value=True)
+    manager._load_account_info = AsyncMock()
+    renew_result = SimpleNamespace(
+        success=True,
+        renew_method="api",
+        updated_cookie_names=["_m_h5_tk"],
+        new_cookies_str="a=b; _m_h5_tk=fresh",
+        api_message="ok",
+    )
+    with (
+        patch(
+            "common.services.cookie_renew_api_service.cookie_renew_api_service.renew",
+            new=AsyncMock(return_value=renew_result),
+        ),
+        patch("common.db.compat.db_manager.add_account_login_log", return_value=1),
+    ):
+        assert asyncio.run(manager.try_password_login_refresh("Session过期")) is True
+
+    manager.update_config_cookies.assert_awaited_once()
+    manager._load_account_info.assert_not_awaited()
+    assert "_m_h5_tk=fresh" in manager.cookies_str
+
