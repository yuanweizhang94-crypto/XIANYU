+class _CaptureQuerySession:
+    def __init__(self, rows=None):
+        self.statement = None
+        self._rows = rows or []
+
+    async def execute(self, statement):
+        self.statement = statement
+        return SimpleNamespace(scalars=lambda: _FakeScalarRows(self._rows))
