+def test_remote_failure_is_propagated_without_overwriting_local_response():
+    local = _result({"ret": ["FAIL_SYS_TOKEN_EMPTY::令牌为空"], "data": {"marker": "local"}})
+    remote = _result(
+        {"ret": ["FAIL::remote"], "data": {"marker": "remote"}},
+        remote_failure_message="FAIL_SYS_SESSION_EXPIRED::Session过期",
+    )
+
+    merged = _attach_remote_failure(local, remote)
+    assert merged.response_json == local.response_json
+    assert merged.remote_failure_message == remote.remote_failure_message
+    assert is_session_expired_token_result(merged) is True
+
