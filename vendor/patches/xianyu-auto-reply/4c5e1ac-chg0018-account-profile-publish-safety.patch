+def test_session_expiry_check_precedes_captcha_and_preserves_chg0018_non_disable_boundary():
+    source = COOKIE_TOKEN_MANAGER.read_text(encoding="utf-8")
+    session_start = source.index("if is_session_expired_token_result(api_result):")
+    captcha_start = source.index("if self.need_captcha_verification(res_json):", session_start)
+    session_block = source[session_start:captcha_start]
+
+    assert session_start < captcha_start
+    assert 'await self.try_password_login_refresh("Session过期")' in session_block
+    assert "handle_captcha_verification" not in session_block
+    assert "disable_account" not in session_block
+    assert "account status is unchanged" in session_block
+
