+from __future__ import annotations
+
+from pathlib import Path
+
+from common.schemas.account import AccountDetail, AccountLoginInfoUpdate
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def read(relative: str) -> str:
+    return (ROOT / relative).read_text(encoding="utf-8")
+
+
+def test_account_detail_does_not_expose_raw_login_password() -> None:
+    fields = AccountDetail.model_fields
+    assert "login_password" not in fields
+    assert "has_password" in fields
+
+
+def test_login_info_update_requires_explicit_password_clear_flag() -> None:
+    payload = AccountLoginInfoUpdate()
+    assert payload.login_password is None
+    assert payload.clear_login_password is False
+
+
+def test_account_routes_return_presence_flag_not_raw_password() -> None:
+    source = read("backend-web/app/api/routes/cookies.py")
+    assert "login_password=account.login_password" not in source
+    assert '"login_password": account.login_password' not in source
+    assert "has_password=bool(account.username and account.login_password)" in source
+    assert '"has_password": bool(account.username and account.login_password)' in source
+
+
+def test_frontend_default_edit_does_not_load_or_submit_saved_password() -> None:
+    accounts_page = read("frontend/src/pages/accounts/Accounts.tsx")
+    api_client = read("frontend/src/api/accounts.ts")
+    frontend_types = read("frontend/src/types/index.ts")
+
+    assert "setEditPassword(account.login_password" not in accounts_page
+    assert "editCredentialMode" in accounts_page
+    assert 'autoComplete="new-password"' in accounts_page
+    assert "clear_login_password" in accounts_page
+    assert "item.login_password" not in api_client
+    assert "has_password?: boolean" in api_client
+    assert "login_password?: string" not in frontend_types
+
+
+def test_password_refresh_failures_do_not_disable_accounts_or_log_full_cookies() -> None:
+    for relative in [
+        "websocket/app/services/xianyu/cookie_token_manager.py",
+        "websocket/app/api/routes/internal.py",
+    ]:
+        source = read(relative)
+        assert "disable_account" not in source
+        assert "全量Cookies" not in source
+        assert "新Cookies" not in source
+        assert "account status is unchanged" in source
+        assert "cookie field count" in source
