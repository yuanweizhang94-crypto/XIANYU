+def test_existing_renew_login_chain_has_no_qr_fallback_in_password_refresh_method():
+    source = COOKIE_TOKEN_MANAGER.read_text(encoding="utf-8")
+    start = source.index("async def try_password_login_refresh")
+    end = source.index("async def verify_cookie_validity", start)
+    renew_block = source[start:end]
+
+    assert "cookie_renew_api_service.renew" in renew_block
+    assert "no_credentials" in renew_block
+    assert "qr_login" not in renew_block.lower()
+    assert "generate_qr" not in renew_block.lower()
