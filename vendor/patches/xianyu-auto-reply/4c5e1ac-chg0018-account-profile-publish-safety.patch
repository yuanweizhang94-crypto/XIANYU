+    async def _has_publish_quick_enter(self) -> bool:
+        if not self.page:
+            return False
+        for frame in self.page.frames:
+            if "passport.goofish.com" not in (frame.url or ""):
+                continue
+            try:
+                if await frame.locator("button").count() > 0:
+                    return True
+            except Exception:
+                continue
+        return False
