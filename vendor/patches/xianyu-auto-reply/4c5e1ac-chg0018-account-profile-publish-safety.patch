+def test_explicit_session_expiry_is_detected_from_local_or_remote_result():
+    local_expired = _result({"ret": ["FAIL_SYS_SESSION_EXPIRED::Session过期"], "data": {}})
+    remote_expired = _result(
+        {"ret": ["FAIL_SYS_UNKNOWN::temporary local result"], "data": {}},
+        remote_failure_message="FAIL_SYS_SESSION_EXPIRED::Session过期",
+    )
+
+    assert is_session_expired_token_result(local_expired) is True
+    assert is_session_expired_token_result(remote_expired) is True
+
+    manager, _parent = _manager_for_refresh()
+    manager.need_captcha_verification = Mock(return_value=True)
+    manager.try_password_login_refresh = AsyncMock(return_value="no_credentials")
+    manager.handle_captcha_verification = AsyncMock()
+    with (
+        patch("app.services.captcha.concurrency.should_skip_account", return_value=False),
+        patch(
+            "websocket.app.services.xianyu.cookie_token_manager.load_token_api_mode",
+            new=AsyncMock(return_value="web"),
+        ),
+        patch(
+            "websocket.app.services.xianyu.cookie_token_manager.request_im_token_with_fallback",
+            new=AsyncMock(return_value=local_expired),
+        ),
+    ):
+        assert asyncio.run(manager.refresh_token()) is None
+
+    manager.try_password_login_refresh.assert_awaited_once_with("Session过期")
+    manager.handle_captcha_verification.assert_not_awaited()
+
+
+def test_temporary_remote_failure_is_not_session_expiry():
+    temporary = _result(
+        {"ret": ["FAIL_SYS_NETWORK::temporary failure"], "data": {}},
+        remote_failure_message="TimeoutError: remote token endpoint timeout",
+    )
+    assert is_session_expired_token_result(temporary) is False
+
+    manager, _parent = _manager_for_refresh()
+    manager.try_password_login_refresh = AsyncMock()
+    manager.need_captcha_verification = Mock(return_value=False)
+    with (
+        patch("app.services.captcha.concurrency.should_skip_account", return_value=False),
+        patch(
+            "websocket.app.services.xianyu.cookie_token_manager.load_token_api_mode",
+            new=AsyncMock(return_value="remote"),
+        ),
+        patch(
+            "websocket.app.services.xianyu.cookie_token_manager.request_im_token_with_fallback",
+            new=AsyncMock(return_value=temporary),
+        ),
+    ):
+        assert asyncio.run(manager.refresh_token()) is None
+
+    manager.try_password_login_refresh.assert_not_awaited()
+
