+            return
+        from common.services.captcha.concurrency import (
+            account_browser_lock_manager,
+            concurrency_manager,
+        )
+
+        lock_key = self._profile_lock_key
+        if self._profile_account_lock_acquired:
+            await asyncio.to_thread(account_browser_lock_manager.release, lock_key)
+            self._profile_account_lock_acquired = False
+        if self._profile_slot_acquired:
+            await asyncio.to_thread(concurrency_manager.unregister_instance, lock_key)
+            self._profile_slot_acquired = False
+        self._profile_lock_key = None
+
