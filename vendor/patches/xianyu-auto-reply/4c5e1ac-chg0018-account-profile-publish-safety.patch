@@ -0,0 +1,68 @@
+from __future__ import annotations
+
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def read(relative: str) -> str:
+    return (ROOT / relative).read_text(encoding="utf-8")
+
+
+def test_publish_execution_passes_authoritative_account_identity_not_cookie_pairing() -> None:
+    source = read("common/services/publish_execution_service.py")
+
+    assert "cookie=cookies_str" not in source
+    assert "account_id=account.account_id" in source
+    assert "owner_id=user_id" in source
+
+
+def test_publish_service_preserves_compatibility_and_forwards_identity() -> None:
+    source = read("common/services/xianyu_publish_service.py")
+
+    assert "cookie: str | None = None" in source
+    assert "account_id: str | None = None" in source
+    assert "owner_id: int | None = None" in source
+    assert 'cookie_data={"cookie": cookie} if cookie is not None else None' in source
+    assert "account_id=account_id" in source
+    assert "owner_id=owner_id" in source
+
+
+def test_publisher_uses_persistent_profile_and_authoritative_cookie_lookup() -> None:
+    source = read("backend-web/app/services/xianyu_publisher.py")
+
+    assert "initialize_account_profile" in source
+    assert "launch_persistent_context(str(profile_dir)" in source
+    assert "_load_authoritative_cookie" in source
+    assert "select(XYAccount).where(XYAccount.account_id == account_id)" in source
+    assert "profile_missing" in source
+    assert "browser_busy" in source
+    assert '"browser_data" / f"user_{self._pure_account_id(account_id)}"' in source
+
+
+def test_publish_runs_shared_preflight_before_form_mutation_in_same_context() -> None:
+    source = read("backend-web/app/services/xianyu_publisher.py")
+    publish_start = source.index("async def publish_item(")
+    preflight_method = source.index("async def preflight_publish_form(")
+    preflight_call = source.index("preflight_result = await self.preflight_publish_form()", publish_start)
+    upload_call = source.index("await self._upload_images(images)", publish_start)
+    fill_call = source.index("await self._fill_description(item_data)", publish_start)
+    publish_click = source.index("await self._click_publish_button(result)", publish_start)
+
+    assert preflight_method < publish_start
+    assert preflight_call < upload_call < fill_call < publish_click
+    assert "preflight_only" in source
+    assert "publish preflight ready" in source
+
+
+def test_publisher_uses_existing_browser_guards_once_and_releases_them() -> None:
+    source = read("backend-web/app/services/xianyu_publisher.py")
+
+    assert "concurrency_manager.wait_for_slot" in source
+    assert "account_browser_lock_manager.acquire" in source
+    assert "concurrency_manager.unregister_instance" in source
+    assert "account_browser_lock_manager.release" in source
+    assert "await self._release_profile_guards()" in source
+    assert "class BrowserBroker" not in source
+    assert "new_service" not in source
