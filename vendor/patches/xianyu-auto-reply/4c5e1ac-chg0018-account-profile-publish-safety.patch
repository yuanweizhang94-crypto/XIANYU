+    async def _classify_publish_page_state(
+        self,
+        *,
+        elapsed_seconds: float,
+        quick_enter_clicked: bool,
+    ) -> dict[str, Any]:
+        current_url = self.page.url if self.page else ""
+        lowered_url = current_url.lower()
+        try:
+            page_text = await self.page.evaluate("() => document.body.innerText || ''")
+        except Exception:
+            page_text = ""
+
+        controls = await self._count_publish_form_controls()
+        real_controls = await self._detect_real_publish_controls()
+        diagnostics = {
+            "final_url_category": self._classify_publish_url(current_url),
+            "page_title_category": await self._classify_publish_title(),
+            "quick_enter_detected": await self._has_publish_quick_enter(),
+            "quick_enter_clicked": quick_enter_clicked,
+            "login_marker_detected": False,
+            "verification_marker_detected": False,
+            "shell_element_count": controls.get("input_count", 0) + controls.get("button_count", 0),
+            "real_publish_control_count": sum(real_controls.values()),
+            "elapsed_seconds": round(elapsed_seconds, 1),
+            **controls,
+            **real_controls,
+        }
+
+        login_terms = ("login", "passport", "auth", "sign")
+        if any(term in lowered_url for term in login_terms):
+            diagnostics["login_marker_detected"] = True
+            return {"state": "login_required", "diagnostics": diagnostics, "page_text": page_text}
+
+        risk_terms = ("punish", "captcha", "validate", "slider", "face")
+        if any(term in lowered_url for term in risk_terms):
+            diagnostics["verification_marker_detected"] = True
+            return {"state": "manual_verification_required", "diagnostics": diagnostics, "page_text": page_text}
+
+        try:
+            risk_selectors = ".nc-container, #nc_1_n1z, .captcha-container, iframe[src*=punish], iframe[src*=captcha]"
+            if await self.page.query_selector(risk_selectors):
+                diagnostics["verification_marker_detected"] = True
+                return {"state": "manual_verification_required", "diagnostics": diagnostics, "page_text": page_text}
+        except Exception:
+            pass
+
+        if diagnostics["quick_enter_detected"] and not quick_enter_clicked:
+            return {"state": "quick_enter_required", "diagnostics": diagnostics, "page_text": page_text}
+
+        ready_signals = 0
+        if real_controls.get("publish_route", 0) > 0:
+            ready_signals += 1
+        if real_controls.get("upload_control_count", 0) > 0:
+            ready_signals += 1
+        if real_controls.get("description_control_count", 0) > 0:
+            ready_signals += 1
+        if real_controls.get("price_control_count", 0) > 0:
+            ready_signals += 1
+        if real_controls.get("publish_button_count", 0) > 0:
+            ready_signals += 1
+        if ready_signals >= 3:
+            return {"state": "ready", "diagnostics": diagnostics, "page_text": page_text}
+
+        if elapsed_seconds >= 15 and not page_text.strip() and diagnostics["shell_element_count"] == 0:
+            return {"state": "publish_page_load_failed", "diagnostics": diagnostics, "page_text": page_text}
+
+        return {"state": "waiting", "diagnostics": diagnostics, "page_text": page_text}
+
+    def _classify_publish_url(self, url: str) -> str:
+        lowered = (url or "").lower()
+        if any(term in lowered for term in ("login", "passport", "auth")):
+            return "login"
+        if any(term in lowered for term in ("punish", "captcha", "validate")):
+            return "manual_verification"
+        if "publish" in lowered:
+            return "publish"
+        if "goofish.com" in lowered:
+            return "goofish"
+        if not lowered:
+            return "empty"
+        return "other"
+
+    async def _classify_publish_title(self) -> str:
+        try:
+            title = (await self.page.title()).lower()
+        except Exception:
+            return "unavailable"
+        if any(term in title for term in ("login", "登录")):
+            return "login"
+        if any(term in title for term in ("验证", "captcha", "security")):
+            return "manual_verification"
+        if title:
+            return "present"
+        return "empty"
+
+    async def preflight_publish_form(self) -> dict[str, Any]:
+        if not self.page:
