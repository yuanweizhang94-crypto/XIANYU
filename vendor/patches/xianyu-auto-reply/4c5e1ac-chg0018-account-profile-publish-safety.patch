+    async def _detect_real_publish_controls(self) -> dict[str, int]:
+        selectors = {
+            "publish_route": "1",
+            "upload_control_count": "input[type=file], [class*=upload], [class*=Upload]",
+            "title_control_count": "input[placeholder*=title], input[maxlength], [contenteditable=true]",
+            "description_control_count": "textarea, [contenteditable=true]",
+            "price_control_count": "input[inputmode=decimal], input[type=number], input[placeholder*=price]",
+            "publish_button_count": "button[type=submit], button[class*=publish], [class*=publish][role=button]",
+        }
+        counts: dict[str, int] = {}
+        for key, selector in selectors.items():
+            if selector == "1":
+                counts[key] = 1 if self.page and "publish" in (self.page.url or "").lower() else 0
+                continue
+            try:
+                counts[key] = len(await self.page.query_selector_all(selector))
+            except Exception:
+                counts[key] = 0
+        return counts
