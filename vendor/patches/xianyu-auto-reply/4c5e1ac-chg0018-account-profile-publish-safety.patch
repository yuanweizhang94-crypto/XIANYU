+    def _profile_dir_for_account(self, account_id: str) -> Path:
+        return Path(os.getcwd()) / "browser_data" / f"user_{self._pure_account_id(account_id)}"
+
+    def _profile_state(self, account_id: str) -> tuple[str, Path]:
+        profile_dir = self._profile_dir_for_account(account_id)
+        if not profile_dir.exists() or not any(profile_dir.iterdir()):
+            return "profile_missing", profile_dir
+        if any((profile_dir / name).exists() for name in ("SingletonLock", "SingletonCookie", "SingletonSocket")):
+            return "browser_busy", profile_dir
+        return "ready", profile_dir
+
+    async def _load_authoritative_cookie(self, account_id: str, owner_id: int | None = None) -> str:
+        from sqlalchemy import desc, select
+        from common.db.session import async_session_maker
+        from common.models.xy_account import XYAccount
+
+        async with async_session_maker() as session:
+            stmt = select(XYAccount).where(XYAccount.account_id == account_id)
+            if owner_id is not None:
+                stmt = stmt.where(XYAccount.owner_id == owner_id)
+            stmt = stmt.order_by(desc(XYAccount.id)).limit(1)
+            result = await session.execute(stmt)
+            account = result.scalars().first()
+            if not account or not account.cookie:
+                raise Exception("login_required")
+            return str(account.cookie)
+
+    async def _acquire_profile_guards(self, account_id: str) -> None:
+        from common.services.captcha.concurrency import (
+            account_browser_lock_manager,
+            concurrency_manager,
+        )
+
+        lock_key = self._pure_account_id(account_id)
+        self._profile_lock_key = lock_key
+        slot_acquired = await asyncio.to_thread(concurrency_manager.wait_for_slot, lock_key)
+        if not slot_acquired:
+            raise Exception("browser_busy")
+        self._profile_slot_acquired = True
+
+        try:
+            account_lock_timeout = float(getattr(concurrency_manager, "wait_timeout", 120) or 120)
+        except Exception:
+            account_lock_timeout = 120.0
+        account_lock_acquired = await asyncio.to_thread(
+            account_browser_lock_manager.acquire,
+            lock_key,
+            account_lock_timeout,
+        )
+        if not account_lock_acquired:
+            await asyncio.to_thread(concurrency_manager.unregister_instance, lock_key)
+            self._profile_slot_acquired = False
+            raise Exception("browser_busy")
+        self._profile_account_lock_acquired = True
+
+    async def _release_profile_guards(self) -> None:
+        if not self._profile_lock_key:
+            return
+        from common.services.captcha.concurrency import (
+            account_browser_lock_manager,
+            concurrency_manager,
+        )
+
+        lock_key = self._profile_lock_key
+        if self._profile_account_lock_acquired:
+            await asyncio.to_thread(account_browser_lock_manager.release, lock_key)
+            self._profile_account_lock_acquired = False
+        if self._profile_slot_acquired:
+            await asyncio.to_thread(concurrency_manager.unregister_instance, lock_key)
+            self._profile_slot_acquired = False
+        self._profile_lock_key = None
+
+    async def initialize_account_profile(
