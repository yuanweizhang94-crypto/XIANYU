+
+        loop = asyncio.get_running_loop()
+        start_time = loop.time()
+        deadline = start_time + 60
+        quick_enter_clicked = False
+        page_text = ""
+        last_state = "waiting"
+
+        while loop.time() < deadline:
+            elapsed = loop.time() - start_time
+            page_state = await self._classify_publish_page_state(
+                elapsed_seconds=elapsed,
+                quick_enter_clicked=quick_enter_clicked,
+            )
+            last_state = page_state["state"]
+            page_text = page_state.get("page_text") or ""
+            self.last_publish_diagnostics.update(page_state["diagnostics"])
+
+            if last_state == "ready":
+                return {
+                    "ready": True,
+                    "failure_reason": None,
+                    "diagnostics": self.last_publish_diagnostics,
+                    "page_text_length": len(page_text),
+                }
+            if last_state in {"login_required", "manual_verification_required", "publish_page_load_failed"}:
+                raise Exception(last_state)
+            if last_state == "quick_enter_required":
+                quick_enter_clicked = await self._handle_publish_quick_enter()
+                self.last_publish_diagnostics["quick_enter_clicked"] = quick_enter_clicked
+            await asyncio.sleep(1)
+
+        self.last_publish_diagnostics["final_failure_reason"] = "publish_form_timeout"
+        self.last_publish_diagnostics["last_page_state"] = last_state
+        raise Exception("publish_form_timeout")
