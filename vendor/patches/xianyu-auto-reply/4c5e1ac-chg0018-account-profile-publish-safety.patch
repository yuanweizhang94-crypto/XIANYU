+def test_healthy_session_is_not_misclassified_and_returns_before_login_path():
+    healthy = _result({"ret": ["SUCCESS::调用成功"], "data": {"accessToken": "token"}})
+    assert is_session_expired_token_result(healthy) is False
+
+    source = COOKIE_TOKEN_MANAGER.read_text(encoding="utf-8")
+    success_pos = source.index("if new_token:")
+    session_pos = source.index("if is_session_expired_token_result(api_result):")
+    assert success_pos < session_pos
+
+    manager, _parent = _manager_for_refresh()
+    manager.try_password_login_refresh = AsyncMock()
+    manager.handle_captcha_verification = AsyncMock()
+    healthy_api_result = _result(
+        {"ret": ["SUCCESS::调用成功"], "data": {"accessToken": "token-live"}}
+    )
+    with (
+        patch("app.services.captcha.concurrency.should_skip_account", return_value=False),
+        patch(
+            "websocket.app.services.xianyu.cookie_token_manager.load_token_api_mode",
+            new=AsyncMock(return_value="web"),
+        ),
+        patch(
+            "websocket.app.services.xianyu.cookie_token_manager.request_im_token_with_fallback",
+            new=AsyncMock(return_value=healthy_api_result),
+        ),
+    ):
+        token = asyncio.run(manager.refresh_token())
+
+    assert token == "token-live"
+    manager.try_password_login_refresh.assert_not_awaited()
+    manager.handle_captcha_verification.assert_not_awaited()
+
