+class StubLogger:
+    def __init__(self):
+        self._next_token = 1
+        self._sinks = {}
+
+    def add(self, sink, **_kwargs):
+        token = self._next_token
+        self._next_token += 1
+        self._sinks[token] = sink
+        return token
+
+    def remove(self, token):
+        self._sinks.pop(token, None)
+
+    def opt(self, **_kwargs):
+        return self
+
+    def _emit(self, message="", *args, **kwargs):
+        text = str(message)
+        try:
+            if args or kwargs:
+                text = text.format(*args, **kwargs)
+        except Exception:
+            pass
+        for sink in list(self._sinks.values()):
+            sink(text)
+
+    debug = _emit
+    info = _emit
+    warning = _emit
+    error = _emit
+    exception = _emit
