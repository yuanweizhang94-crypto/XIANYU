@@ -44,0 +45,134 @@ def clean_ai_text(value: Any) -> str:
+GEMINI_TRUNCATED_FINISH_REASONS = {"MAX_TOKENS", "LENGTH"}
+GEMINI_SUCCESS_FINISH_REASONS = {"STOP"}
+GEMINI_INITIAL_MAX_OUTPUT_TOKENS = 1024
+GEMINI_RETRY_MAX_OUTPUT_TOKENS = 2048
+GEMINI_TEXT_GENERATION_CONFIG = {
+    "responseMimeType": "text/plain",
+    "thinkingConfig": {"thinkingLevel": "low"},
+}
+
+
+def parse_gemini_generate_content_response(result: Any) -> dict[str, Any]:
+    """Parse Gemini generateContent JSON without exposing thought/internal parts."""
+    parsed = {
+        "final_text": "",
+        "finish_reason": "",
+        "part_count": 0,
+        "thought_part_count": 0,
+        "answer_part_count": 0,
+        "truncated": False,
+        "error_class": "",
+    }
+    if not isinstance(result, dict):
+        parsed["error_class"] = "response_not_object"
+        return parsed
+
+    candidates = result.get("candidates")
+    if not isinstance(candidates, list) or not candidates:
+        parsed["error_class"] = "missing_candidates"
+        return parsed
+
+    candidate = candidates[0]
+    if not isinstance(candidate, dict):
+        parsed["error_class"] = "candidate_not_object"
+        return parsed
+
+    finish_reason = str(candidate.get("finishReason") or "").strip()
+    finish_reason_upper = finish_reason.upper()
+    parsed["finish_reason"] = finish_reason
+    parsed["truncated"] = finish_reason_upper in GEMINI_TRUNCATED_FINISH_REASONS
+    if not finish_reason:
+        parsed["error_class"] = "missing_finish_reason"
+    elif (
+        finish_reason_upper not in GEMINI_SUCCESS_FINISH_REASONS
+        and finish_reason_upper not in GEMINI_TRUNCATED_FINISH_REASONS
+    ):
+        parsed["error_class"] = "non_success_finish_reason"
+
+    content = candidate.get("content") if isinstance(candidate.get("content"), dict) else {}
+    parts = content.get("parts") if isinstance(content, dict) else None
+    if not isinstance(parts, list):
+        parsed["error_class"] = "missing_parts"
+        return parsed
+
+    parsed["part_count"] = len(parts)
+    answer_texts: list[str] = []
+    for part in parts:
+        if not isinstance(part, dict):
+            continue
+        if part.get("thought") is True:
+            parsed["thought_part_count"] += 1
+            continue
+        text = part.get("text")
+        if not isinstance(text, str) or not text.strip():
+            continue
+        parsed["answer_part_count"] += 1
+        answer_texts.append(text)
+
+    final_text = " ".join(" ".join(text.split()) for text in answer_texts).strip()
+    parsed["final_text"] = final_text
+    if not final_text and not parsed["error_class"]:
+        parsed["error_class"] = "missing_answer_text"
+    return parsed
+
+
+def validate_ai_reply_text(text: Any, *, truncated: bool = False) -> tuple[bool, str]:
+    """Reject obvious non-customer-facing or truncated AI output before sender use."""
+    cleaned = clean_ai_text(text)
+    if not cleaned:
+        return False, "empty"
+    if truncated:
+        return False, "truncated"
+    if len(cleaned) <= 2:
+        return False, "too_short"
+    if all(ch.isspace() or ch in ".,:;!?，。！？、：；-_*#`{}[]()（）|/\\\"'" for ch in cleaned):
+        return False, "punctuation_only"
+    if cleaned[0] in ",:;，：；、）)]}":
+        return False, "broken_prefix"
+
+    stripped = cleaned.strip()
+    if stripped.startswith(("{", "[")) and stripped.endswith(("}", "]")):
+        return False, "json_like"
+
+    lower = cleaned.lower()
+    markers = (
+        "length:",
+        "assistant:",
+        "assistant：",
+        "product intro",
+        "logistics",
+        "markdown",
+        "field name",
+    )
+    if any(marker in lower for marker in markers):
+        return False, "template_leak"
+    if cleaned.startswith(("**", "#", "- ", "* ", "+ ", "• ", "```")):
+        return False, "markdown_like"
+    if any(cleaned.startswith(f"{index}.") for index in range(1, 10)):
+        return False, "markdown_like"
+
+    cjk_count = sum(1 for ch in cleaned if "\u4e00" <= ch <= "\u9fff")
+    ascii_letter_count = sum(1 for ch in cleaned if ("a" <= ch.lower() <= "z"))
+    if cjk_count == 0 and ascii_letter_count:
+        return False, "english_template"
+    if ascii_letter_count > max(24, cjk_count):
+        return False, "english_template"
+    if ascii_letter_count >= 12 and ascii_letter_count > cjk_count * 2:
+        return False, "english_template"
+    return True, ""
+
+
+def extract_gemini_final_text(result: Any) -> str:
+    """Return validated Gemini answer text or raise a sanitized RuntimeError."""
+    parsed = parse_gemini_generate_content_response(result)
+    ok, reason = validate_ai_reply_text(parsed["final_text"], truncated=bool(parsed["truncated"]))
+    if parsed["error_class"] or not ok:
+        error_class = parsed["error_class"] or reason
+        raise RuntimeError(
+            "Gemini response invalid "
+            f"error_class={error_class} finish_reason={parsed['finish_reason']} "
+            f"part_count={parsed['part_count']} answer_part_count={parsed['answer_part_count']}"
+        )
+    return parsed["final_text"]
+
+
