+import sys
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "backend-web"))
+sys.path.insert(0, str(ROOT))
+
+from app.services.ai_reply_service import validate_custom_prompts_json
+
+
+class AIReplyPromptValidationTest(unittest.TestCase):
+    def test_rejects_account_level_plain_text_prompt(self):
+        with self.assertRaises(ValueError):
+            validate_custom_prompts_json("根据我的商品情况，引导下单")
+
+    def test_rejects_account_level_json_array(self):
+        with self.assertRaises(ValueError):
+            validate_custom_prompts_json('["default"]')
+
+    def test_accepts_account_level_json_object_with_string_values(self):
+        text = '{"default":"只输出简体中文完整句子","tech":"按商品信息回答","price":"引导闲鱼页面下单"}'
+
+        self.assertEqual(validate_custom_prompts_json(text), text)
+
+    def test_rejects_account_level_json_with_non_string_prompt_value(self):
+        with self.assertRaises(ValueError):
+            validate_custom_prompts_json('{"default":123}')
+
+    def test_allows_empty_account_level_prompt_to_use_system_default(self):
+        self.assertEqual(validate_custom_prompts_json(""), "")
+
+
+if __name__ == "__main__":
+    unittest.main()
