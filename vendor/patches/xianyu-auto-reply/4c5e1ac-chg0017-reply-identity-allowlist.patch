@@ -0,0 +1,511 @@
+import os
+import sys
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "websocket"))
+sys.path.insert(0, str(ROOT))
+
+import app.services.xianyu.auto_reply_service as auto_reply_module
+from app.services.xianyu.auto_reply_service import AutoReplyService
+from common.utils.item_info_manager import ItemInfoManager
+
+
+ACCOUNT_A = "account-a"
+ACCOUNT_A_PLATFORM = "platform-a"
+OWNER_TEST_B_ACCOUNT = "account-b"
+OWNER_TEST_B_PLATFORM = "platform-b"
+
+
+class DummyInstance:
+    myid = ACCOUNT_A_PLATFORM
+
+    async def send_msg(self, **_kwargs):
+        return {"success": True}
+
+
+class DummySessionContext:
+    async def __aenter__(self):
+        return object()
+
+    async def __aexit__(self, exc_type, exc, tb):
+        return False
+
+
+class DummyAccount:
+    id = 1
+
+
+class Chg0017ReplyAllowlistTest(unittest.IsolatedAsyncioTestCase):
+    def setUp(self):
+        self._original_session_maker = auto_reply_module.async_session_maker
+
+    def tearDown(self):
+        for key in (
+            "CHG0017_REPLY_ALLOWLIST_ENABLED",
+            "CHG0017_REPLY_ALLOWED_COOKIE_IDS",
+            "CHG0017_REPLY_ALLOWED_SENDER_IDS",
+        ):
+            os.environ.pop(key, None)
+        auto_reply_module.async_session_maker = self._original_session_maker
+
+    def enable_gate(self, receiver: str = ACCOUNT_A, sender: str = OWNER_TEST_B_PLATFORM):
+        os.environ["CHG0017_REPLY_ALLOWLIST_ENABLED"] = "true"
+        os.environ["CHG0017_REPLY_ALLOWED_COOKIE_IDS"] = receiver
+        os.environ["CHG0017_REPLY_ALLOWED_SENDER_IDS"] = sender
+
+    def service(self, receiver: str = ACCOUNT_A) -> AutoReplyService:
+        return AutoReplyService(receiver, DummyInstance())
+
+    def test_allows_receiver_account_and_sender_platform_identity(self):
+        self.enable_gate()
+        allowed, reason = self.service()._check_chg0017_reply_gate(OWNER_TEST_B_PLATFORM)
+
+        self.assertTrue(allowed)
+        self.assertEqual(reason, "allowed")
+
+    def test_denies_owner_test_account_id_as_sender_identity(self):
+        self.enable_gate()
+        allowed, reason = self.service()._check_chg0017_reply_gate(OWNER_TEST_B_ACCOUNT)
+
+        self.assertFalse(allowed)
+        self.assertEqual(reason, "chg0017_allowlist_sender_denied")
+
+    def test_denies_account_a_platform_identity_as_own_message(self):
+        self.enable_gate()
+        allowed, reason = self.service()._check_chg0017_reply_gate(ACCOUNT_A_PLATFORM)
+
+        self.assertFalse(allowed)
+        self.assertEqual(reason, "self_message")
+
+    def test_denies_unknown_sender(self):
+        self.enable_gate()
+
+        allowed, reason = self.service()._check_chg0017_reply_gate("unknown")
+
+        self.assertFalse(allowed)
+        self.assertEqual(reason, "chg0017_allowlist_sender_unknown")
+
+    def test_denies_empty_sender(self):
+        self.enable_gate()
+
+        allowed, reason = self.service()._check_chg0017_reply_gate("")
+
+        self.assertFalse(allowed)
+        self.assertEqual(reason, "chg0017_allowlist_sender_missing")
+
+    def test_denies_system_sender_name(self):
+        self.enable_gate()
+
+        allowed, reason = self.service()._check_chg0017_reply_gate(OWNER_TEST_B_PLATFORM, "系统")
+
+        self.assertFalse(allowed)
+        self.assertEqual(reason, "chg0017_allowlist_system_sender")
+
+    def test_denies_other_receiver_account(self):
+        self.enable_gate()
+
+        allowed, reason = self.service("account-c")._check_chg0017_reply_gate(OWNER_TEST_B_PLATFORM)
+
+        self.assertFalse(allowed)
+        self.assertEqual(reason, "chg0017_allowlist_receiver_denied")
+
+    def test_denies_missing_config(self):
+        os.environ["CHG0017_REPLY_ALLOWLIST_ENABLED"] = "true"
+        service = self.service()
+
+        allowed, reason = service._check_chg0017_reply_gate(OWNER_TEST_B_PLATFORM)
+
+        self.assertFalse(allowed)
+        self.assertEqual(reason, "chg0017_allowlist_config_missing")
+
+    def test_denies_when_gate_disabled(self):
+        service = self.service()
+
+        allowed, reason = service._check_chg0017_reply_gate(OWNER_TEST_B_PLATFORM)
+
+        self.assertFalse(allowed)
+        self.assertEqual(reason, "chg0017_allowlist_disabled")
+
+    async def test_non_whitelist_sender_denied_before_reply_route(self):
+        self.enable_gate()
+        service = self.service()
+        calls = {"reply": 0, "log_payload": None}
+
+        async def get_reply(**_kwargs):
+            calls["reply"] += 1
+            return "must not be reached"
+
+        async def record_log(payload):
+            calls["log_payload"] = dict(payload)
+            return 1
+
+        service.get_reply = get_reply
+        service._record_auto_reply_log = record_log
+
+        await service.handle_chat_message(
+            {
+                "send_user_id": "non-whitelist-platform",
+                "send_user_name": "owner-test",
+                "send_message": "hello",
+                "chat_id": "chat-fixture",
+                "item_id": "",
+                "msg_time": 1,
+            },
+            websocket=None,
+        )
+
+        self.assertEqual(calls["reply"], 0)
+        self.assertIsNotNone(calls["log_payload"])
+        self.assertEqual(calls["log_payload"]["process_status"], "skipped")
+        self.assertEqual(calls["log_payload"]["decision_reason"], "chg0017_allowlist_sender_denied")
+
+    async def test_catalog_missing_global_keyword_still_matches(self):
+        auto_reply_module.async_session_maker = lambda: DummySessionContext()
+        service = self.service()
+
+        async def get_account(_session):
+            return DummyAccount()
+
+        async def list_keywords(_session, _account):
+            return [
+                {
+                    "keyword": "item-only",
+                    "reply": "item reply",
+                    "item_id": "item-secret-123",
+                    "type": "text",
+                    "image_url": "",
+                    "item_title": "",
+                },
+                {
+                    "keyword": "global",
+                    "reply": "global reply",
+                    "item_id": "",
+                    "type": "text",
+                    "image_url": "",
+                    "item_title": "",
+                },
+            ]
+
+        async def no_ai(*_args, **_kwargs):
+            return None
+
+        async def no_default(*_args, **_kwargs):
+            return None
+
+        service._get_account = get_account
+        service._list_keywords = list_keywords
+        service.get_ai_reply = no_ai
+        service.get_default_reply = no_default
+
+        reply = await service.get_reply(
+            send_user_name="owner-test",
+            send_user_id=OWNER_TEST_B_PLATFORM,
+            send_message="please use global",
+            chat_id="chat-fixture",
+            item_id="item-secret-123",
+            catalog_item_known=False,
+        )
+
+        self.assertEqual(reply, "global reply")
+
+    async def test_catalog_missing_item_specific_keyword_is_skipped(self):
+        auto_reply_module.async_session_maker = lambda: DummySessionContext()
+        service = self.service()
+
+        async def get_account(_session):
+            return DummyAccount()
+
+        async def list_keywords(_session, _account):
+            return [
+                {
+                    "keyword": "item-only",
+                    "reply": "item reply",
+                    "item_id": "item-secret-123",
+                    "type": "text",
+                    "image_url": "",
+                    "item_title": "",
+                }
+            ]
+
+        async def no_ai(*_args, **_kwargs):
+            return None
+
+        async def no_default(*_args, **_kwargs):
+            return None
+
+        service._get_account = get_account
+        service._list_keywords = list_keywords
+        service.get_ai_reply = no_ai
+        service.get_default_reply = no_default
+
+        reply = await service.get_reply(
+            send_user_name="owner-test",
+            send_user_id=OWNER_TEST_B_PLATFORM,
+            send_message="item-only",
+            chat_id="chat-fixture",
+            item_id="item-secret-123",
+            catalog_item_known=False,
+        )
+
+        self.assertIsNone(reply)
+
+    async def test_catalog_missing_ai_path_receives_no_item_id(self):
+        auto_reply_module.async_session_maker = lambda: DummySessionContext()
+        service = self.service()
+        calls = {"ai_item_id": "not-called"}
+
+        async def get_account(_session):
+            return DummyAccount()
+
+        async def list_keywords(_session, _account):
+            return []
+
+        async def ai_reply(_session, *_args):
+            calls["ai_item_id"] = _args[3]
+            return "ai reply"
+
+        async def no_default(*_args, **_kwargs):
+            raise AssertionError("default route must not run after AI reply")
+
+        service._get_account = get_account
+        service._list_keywords = list_keywords
+        service.get_ai_reply = ai_reply
+        service.get_default_reply = no_default
+
+        reply = await service.get_reply(
+            send_user_name="owner-test",
+            send_user_id=OWNER_TEST_B_PLATFORM,
+            send_message="question",
+            chat_id="chat-fixture",
+            item_id="item-secret-123",
+            catalog_item_known=False,
+        )
+
+        self.assertEqual(reply, "ai reply")
+        self.assertIsNone(calls["ai_item_id"])
+
+    async def test_catalog_missing_default_route_uses_account_scope(self):
+        auto_reply_module.async_session_maker = lambda: DummySessionContext()
+        service = self.service()
+        calls = {"default_item_id": "not-called"}
+
+        async def get_account(_session):
+            return DummyAccount()
+
+        async def list_keywords(_session, _account):
+            return []
+
+        async def no_ai(*_args, **_kwargs):
+            return None
+
+        async def default_reply(_session, *_args):
+            calls["default_item_id"] = _args[4]
+            return "account default"
+
+        service._get_account = get_account
+        service._list_keywords = list_keywords
+        service.get_ai_reply = no_ai
+        service.get_default_reply = default_reply
+
+        reply = await service.get_reply(
+            send_user_name="owner-test",
+            send_user_id=OWNER_TEST_B_PLATFORM,
+            send_message="fallback",
+            chat_id="chat-fixture",
+            item_id="item-secret-123",
+            catalog_item_known=False,
+        )
+
+        self.assertEqual(reply, "account default")
+        self.assertIsNone(calls["default_item_id"])
+
+    async def test_catalog_missing_does_not_log_sensitive_values(self):
+        from loguru import logger
+
+        self.enable_gate()
+        service = self.service()
+        captured = []
+        token = logger.add(lambda message: captured.append(str(message)), format="{message}")
+
+        async def get_reply(**_kwargs):
+            return None
+
+        async def record_log(_payload):
+            return 1
+
+        async def no_filters(_filter_type):
+            return []
+
+        async def no_notification(**_kwargs):
+            return None
+
+        async def item_missing(_account_id, _item_id):
+            return False
+
+        service.get_reply = get_reply
+        service._record_auto_reply_log = record_log
+        service.get_filter_keywords = no_filters
+        service._send_notification = no_notification
+        service._message_expire_time = 3600
+        service._message_expire_time_loaded = True
+
+        try:
+            with patch("app.services.xianyu.rate_service.check_item_belongs_to_account", item_missing):
+                await service.handle_chat_message(
+                    {
+                        "send_user_id": OWNER_TEST_B_PLATFORM,
+                        "send_user_name": "owner-test",
+                        "send_message": "secret body text",
+                        "chat_id": "chat-fixture",
+                        "item_id": "item-secret-123",
+                        "msg_time": 1,
+                    },
+                    websocket=None,
+                )
+        finally:
+            logger.remove(token)
+
+        catalog_lines = [line for line in captured if "catalog missing" in line]
+        self.assertTrue(catalog_lines)
+        joined = "\n".join(catalog_lines)
+        self.assertNotIn("item-secret-123", joined)
+        self.assertNotIn(ACCOUNT_A, joined)
+        self.assertNotIn("Cookie", joined)
+        self.assertNotIn("secret body text", joined)
+
+    async def test_catalog_missing_sets_trace_context(self):
+        auto_reply_module.async_session_maker = lambda: DummySessionContext()
+        service = self.service()
+        trace = {}
+        token = service._reply_trace_var.set(trace)
+
+        async def get_account(_session):
+            return DummyAccount()
+
+        async def list_keywords(_session, _account):
+            return []
+
+        async def no_ai(*_args, **_kwargs):
+            return None
+
+        async def no_default(*_args, **_kwargs):
+            return None
+
+        service._get_account = get_account
+        service._list_keywords = list_keywords
+        service.get_ai_reply = no_ai
+        service.get_default_reply = no_default
+
+        try:
+            await service.get_reply(
+                send_user_name="owner-test",
+                send_user_id=OWNER_TEST_B_PLATFORM,
+                send_message="question",
+                chat_id="chat-fixture",
+                item_id="item-secret-123",
+                catalog_item_known=False,
+            )
+        finally:
+            service._reply_trace_var.reset(token)
+
+        self.assertTrue(trace["context_snapshot"]["item_catalog_missing"])
+
+    async def test_known_catalog_keeps_item_scope_for_default_reply(self):
+        auto_reply_module.async_session_maker = lambda: DummySessionContext()
+        service = self.service()
+        calls = {"default_item_id": "not-called"}
+
+        async def get_account(_session):
+            return DummyAccount()
+
+        async def list_keywords(_session, _account):
+            return []
+
+        async def no_ai(*_args, **_kwargs):
+            return None
+
+        async def default_reply(_session, *_args):
+            calls["default_item_id"] = _args[4]
+            return "item default"
+
+        service._get_account = get_account
+        service._list_keywords = list_keywords
+        service.get_ai_reply = no_ai
+        service.get_default_reply = default_reply
+
+        reply = await service.get_reply(
+            send_user_name="owner-test",
+            send_user_id=OWNER_TEST_B_PLATFORM,
+            send_message="fallback",
+            chat_id="chat-fixture",
+            item_id="item-known-123",
+            catalog_item_known=True,
+        )
+
+        self.assertEqual(reply, "item default")
+        self.assertEqual(calls["default_item_id"], "item-known-123")
+
+    async def test_item_list_logging_is_masked(self):
+        from loguru import logger
+
+        class FakeHeaders(dict):
+            def getall(self, _name):
+                return []
+
+        class FakeResponse:
+            status = 200
+            headers = FakeHeaders()
+
+            async def __aenter__(self):
+                return self
+
+            async def __aexit__(self, exc_type, exc, tb):
+                return False
+
+            async def json(self):
+                return {
+                    "ret": ["SUCCESS::调用成功"],
+                    "data": {
+                        "cardList": [],
+                        "otherItems": [{"id": "item-secret-123"}],
+                        "userId": "user-secret-123",
+                    },
+                }
+
+        class FakeSession:
+            def post(self, *_args, **_kwargs):
+                return FakeResponse()
+
+        captured = []
+        token = logger.add(lambda message: captured.append(str(message)), format="{message}")
+        manager = ItemInfoManager(
+            cookie_id=ACCOUNT_A,
+            cookies_str="_m_h5_tk=token-secret; cookie-secret=value",
+            session=FakeSession(),
+        )
+
+        try:
+            result = await manager.get_item_list_info(page_number=1, page_size=20, myid="user-secret-123")
+        finally:
+            logger.remove(token)
+
+        self.assertTrue(result["success"])
+        self.assertEqual(result["http_status"], 200)
+        self.assertEqual(result["response_data_keys"], ["cardList", "otherItems", "userId"])
+        self.assertEqual(result["card_list_count"], 0)
+        self.assertEqual(result["other_array_counts"], {"otherItems": 1})
+        joined = "\n".join(captured)
+        self.assertNotIn("cookie-secret", joined)
+        self.assertNotIn("_m_h5_tk", joined)
+        self.assertNotIn("token-secret", joined)
+        self.assertNotIn("sign", joined)
+        self.assertNotIn("Authorization", joined)
+        self.assertNotIn("user-secret-123", joined)
+        self.assertNotIn(ACCOUNT_A, joined)
+
+
+if __name__ == "__main__":
