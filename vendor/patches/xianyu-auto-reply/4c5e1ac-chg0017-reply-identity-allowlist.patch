+import copy
+import sys
+import unittest
+from pathlib import Path
+from unittest.mock import AsyncMock, patch
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "websocket"))
+sys.path.insert(0, str(ROOT))
+
+from common.services.ai_provider_service import (
+    GEMINI_INITIAL_MAX_OUTPUT_TOKENS,
+    GEMINI_RETRY_MAX_OUTPUT_TOKENS,
+    GEMINI_TEXT_GENERATION_CONFIG,
+    extract_gemini_final_text,
+    parse_gemini_generate_content_response,
+    validate_ai_reply_text,
+)
+from app.services.xianyu.ai_reply_engine import AIReplyEngine
+
+
+class FakeGeminiResponse:
+    def __init__(self, payload):
+        self.payload = payload
+
+    def raise_for_status(self):
+        return None
+
+    def json(self):
+        return self.payload
+
+
+class FakeGeminiClient:
+    responses = []
+    requests = []
+
+    def __init__(self, *_args, **_kwargs):
+        pass
+
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, exc_type, exc, tb):
+        return False
+
+    async def post(self, _url, **kwargs):
+        self.__class__.requests.append(copy.deepcopy(kwargs["json"]))
+        return FakeGeminiResponse(self.__class__.responses.pop(0))
+
+
+class FakeDBResult:
+    def __init__(self, rows=None, scalar_value=None):
+        self._rows = rows or []
+        self._scalar_value = scalar_value
+
+    def all(self):
+        return self._rows
+
+    def scalar(self):
+        return self._scalar_value
+
+
+class FakeDBSession:
+    def __init__(self):
+        self.results = [
+            FakeDBResult(rows=[]),
+            FakeDBResult(rows=[]),
+            FakeDBResult(scalar_value=0),
+        ]
+        self.added = []
+        self.commit_count = 0
+
+    def add(self, value):
+        self.added.append(value)
+
+    async def commit(self):
+        self.commit_count += 1
+
+    async def execute(self, _statement):
+        return self.results.pop(0)
+
+
+class GeminiResponseParserTest(unittest.TestCase):
+    def test_skips_thought_part_and_reads_final_answer(self):
+        result = {
+            "candidates": [
+                {
+                    "finishReason": "STOP",
+                    "content": {
+                        "parts": [
+                            {"text": "internal reasoning", "thought": True},
+                            {"text": "可以在闲鱼页面点击购买入口下单。"},
+                        ]
+                    },
+                }
+            ]
+        }
+
+        parsed = parse_gemini_generate_content_response(result)
+
+        self.assertEqual(parsed["thought_part_count"], 1)
+        self.assertEqual(parsed["answer_part_count"], 1)
+        self.assertEqual(parsed["final_text"], "可以在闲鱼页面点击购买入口下单。")
+        self.assertEqual(extract_gemini_final_text(result), "可以在闲鱼页面点击购买入口下单。")
+
+    def test_merges_multiple_non_thought_text_parts(self):
+        result = {
+            "candidates": [
+                {
+                    "finishReason": "STOP",
+                    "content": {
+                        "parts": [
+                            {"text": "这个服务包含视频剪辑，"},
+                            {"text": "下单请通过闲鱼页面购买入口提交。"},
+                        ]
+                    },
+                }
+            ]
+        }
+
+        parsed = parse_gemini_generate_content_response(result)
+
+        self.assertEqual(parsed["answer_part_count"], 2)
+        self.assertEqual(parsed["final_text"], "这个服务包含视频剪辑， 下单请通过闲鱼页面购买入口提交。")
+
+    def test_ignores_thought_signature_and_function_call_parts(self):
+        result = {
+            "candidates": [
+                {
+                    "finishReason": "STOP",
+                    "content": {
+                        "parts": [
+                            {"text": "internal", "thought": True, "thoughtSignature": "secret"},
+                            {"functionCall": {"name": "internal_tool"}},
+                            {"thoughtSignature": "secret"},
+                            {"text": "具体内容以商品页面信息为准。"},
+                        ]
+                    },
+                }
+            ]
+        }
+
+        parsed = parse_gemini_generate_content_response(result)
+
+        self.assertEqual(parsed["thought_part_count"], 1)
+        self.assertEqual(parsed["answer_part_count"], 1)
+        self.assertEqual(parsed["final_text"], "具体内容以商品页面信息为准。")
+
+    def test_rejects_truncated_response(self):
+        result = {
+            "candidates": [
+                {
+                    "finishReason": "MAX_TOKENS",
+                    "content": {"parts": [{"text": "亲，在"}]},
+                }
+            ]
+        }
+
+        parsed = parse_gemini_generate_content_response(result)
+
+        self.assertTrue(parsed["truncated"])
+        with self.assertRaises(RuntimeError):
+            extract_gemini_final_text(result)
+
+    def test_rejects_internal_template_fragments(self):
+        for text in (
+            "* Length:",
+            "Assistant:**",
+            "Assistant:** 可以下单。",
+            "assistant:",
+            "** Product intro",
+            "logistics,",
+        ):
+            ok, reason = validate_ai_reply_text(text)
+            self.assertFalse(ok)
+            self.assertIn(
+                reason,
+                {"template_leak", "markdown_like", "broken_prefix", "english_template"},
+            )
+
+    def test_rejects_json_and_ordered_template_output(self):
+        for text in ('{"reply":"可以下单"}', '["可以下单"]', "1. Product intro"):
+            ok, _reason = validate_ai_reply_text(text)
+            self.assertFalse(ok)
+
+    def test_rejects_non_success_finish_reason(self):
+        result = {
+            "candidates": [
+                {
+                    "finishReason": "SAFETY",
+                    "content": {"parts": [{"text": "可以下单。"}]},
+                }
+            ]
+        }
+
+        parsed = parse_gemini_generate_content_response(result)
+
+        self.assertEqual(parsed["error_class"], "non_success_finish_reason")
+        with self.assertRaises(RuntimeError):
+            extract_gemini_final_text(result)
+
+    def test_rejects_empty_parts(self):
+        result = {
+            "candidates": [
+                {
+                    "finishReason": "STOP",
+                    "content": {"parts": []},
+                }
+            ]
+        }
+
+        parsed = parse_gemini_generate_content_response(result)
+
+        self.assertEqual(parsed["error_class"], "missing_answer_text")
+        with self.assertRaises(RuntimeError):
+            extract_gemini_final_text(result)
+
+    def test_rejects_english_dominant_customer_reply(self):
+        ok, reason = validate_ai_reply_text("You can place the order from the product page purchase button.")
+
+        self.assertFalse(ok)
+        self.assertEqual(reason, "english_template")
+
+    def test_allows_normal_short_chinese_customer_reply(self):
+        ok, reason = validate_ai_reply_text("在的，请问需要了解什么？")
+
+        self.assertTrue(ok, reason)
+
+    def test_allows_chinese_reply_with_normal_model_name(self):
+        ok, reason = validate_ai_reply_text("支持 iPhone 15 Pro，具体以商品页面信息为准。")
+
+        self.assertTrue(ok, reason)
+
+    def test_documents_token_limits(self):
+        self.assertEqual(GEMINI_INITIAL_MAX_OUTPUT_TOKENS, 1024)
+        self.assertEqual(GEMINI_RETRY_MAX_OUTPUT_TOKENS, 2048)
