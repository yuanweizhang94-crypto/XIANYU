+        self.results = [
+            FakeDBResult(rows=[]),
+            FakeDBResult(rows=[]),
+            FakeDBResult(scalar_value=0),
+        ]
+        self.added = []
+        self.commit_count = 0
+
+    def add(self, value):
+        self.added.append(value)
+
+    async def commit(self):
+        self.commit_count += 1
+
+    async def execute(self, _statement):
