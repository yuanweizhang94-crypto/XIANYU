+def _parse_chg0017_allowlist(raw_value: str | None) -> set[str]:
+    return {part.strip() for part in str(raw_value or "").split(",") if part.strip()}
+
+
+def _matches_chg0017_allowlist(allowed_values: set[str], value: str) -> bool:
+    return "*" in allowed_values or value in allowed_values
+
+
@@ -127,0 +137,32 @@ class AutoReplyService:
+    def _check_chg0017_reply_gate(self, send_user_id: str, send_user_name: str = "") -> tuple[bool, str]:
+        if str(os.getenv("CHG0017_REPLY_ALLOWLIST_ENABLED") or "").strip().lower() not in {"1", "true", "yes", "on"}:
+            return False, "chg0017_allowlist_disabled"
+
+        allowed_cookie_ids = _parse_chg0017_allowlist(os.getenv("CHG0017_REPLY_ALLOWED_COOKIE_IDS"))
+        allowed_sender_ids = _parse_chg0017_allowlist(os.getenv("CHG0017_REPLY_ALLOWED_SENDER_IDS"))
+
+        if not allowed_cookie_ids or not allowed_sender_ids:
+            return False, "chg0017_allowlist_config_missing"
+
+        if not _matches_chg0017_allowlist(allowed_cookie_ids, str(self.cookie_id)):
+            return False, "chg0017_allowlist_receiver_denied"
+
+        normalized_sender = str(send_user_id or "").strip()
+        if not normalized_sender:
+            return False, "chg0017_allowlist_sender_missing"
+        if normalized_sender.lower() == "unknown":
+            return False, "chg0017_allowlist_sender_unknown"
+        if str(send_user_name or "").strip() == "系统":
+            return False, "chg0017_allowlist_system_sender"
+
+        current_platform_id = str(getattr(self.xianyu_instance, "myid", "") or "").strip()
+        if current_platform_id and normalized_sender == current_platform_id:
+            return False, "self_message"
+        if not _matches_chg0017_allowlist(allowed_sender_ids, normalized_sender):
+            return False, "chg0017_allowlist_sender_denied"
+        return True, "allowed"
+
+    def _is_chg0017_reply_allowed(self, send_user_id: str) -> bool:
+        allowed, _reason = self._check_chg0017_reply_gate(send_user_id)
+        return allowed
+
