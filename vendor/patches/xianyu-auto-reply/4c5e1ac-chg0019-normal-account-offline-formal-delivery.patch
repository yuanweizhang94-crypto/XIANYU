+
+test('item_status minus nine is not an offline authority', () => {
+  assert.equal(itemsPageSource.includes('item_status'), false)
+  assert.equal(helperSource.includes('item_status'), false)
+})
+
+test('empty batch selection never produces an api plan', () => {
+  assert.deepEqual(helper.buildBatchOfflinePlan([], 'acct-1', new Set()), { ok: false, reason: 'EMPTY' })
+})
+
+test('batch requires explicit account selection', () => {
+  assert.deepEqual(helper.buildBatchOfflinePlan([item(1)], '', new Set()), { ok: false, reason: 'ACCOUNT_REQUIRED' })
