diff --git a/backend-web/app/services/xianyu_publisher.py b/backend-web/app/services/xianyu_publisher.py
index 6e1ed6efaf9aa59c3cc931016e89d36ba76904bc..9ddd59a41a0b281684fe9ec7002d780d58a9230e 100644
--- a/backend-web/app/services/xianyu_publisher.py
+++ b/backend-web/app/services/xianyu_publisher.py
@@ -557,0 +558,388 @@ class XianyuPublisher:
+    @staticmethod
+    def normal_item_detail_url(item_id: str) -> str:
+        """Build the normal-account item detail URL used by goofish Web."""
+        normalized = str(item_id or "").strip()
+        if not normalized or not normalized.isdigit():
+            raise ValueError("invalid_item_id")
+        return f"https://www.goofish.com/item?id={normalized}"
+
+    @staticmethod
+    def _normalize_action_text(value: Any) -> str:
+        return re.sub(r"\s+", "", "" if value is None else str(value))
+
+    @classmethod
+    def _is_safe_offline_action_text(cls, value: Any) -> bool:
+        return cls._normalize_action_text(value) == "下架"
+
+    @classmethod
+    def _is_delete_semantics(cls, value: Any) -> bool:
+        return "删除" in cls._normalize_action_text(value)
+
+    @classmethod
+    def _is_safe_offline_confirmation(cls, dialog_text: Any, button_text: Any) -> bool:
+        """Classify one confirm control using only its local dialog semantics."""
+        dialog = cls._normalize_action_text(dialog_text)
+        button = cls._normalize_action_text(button_text)
+        offline_markers = ("下架", "停止出售", "暂停出售", "停止销售")
+        dangerous_markers = ("删除", "永久删除", "注销", "清空", "编辑", "发布", "上架")
+        if not any(marker in dialog for marker in offline_markers):
+            return False
+        if any(marker in dialog for marker in dangerous_markers):
+            return False
+        if any(marker in button for marker in dangerous_markers):
+            return False
+        return button in {"确认下架", "确定下架", "确认", "确定"}
+
+    @classmethod
+    def _is_offline_cancel_control(cls, value: Any) -> bool:
+        return cls._normalize_action_text(value) in {"取消", "关闭"}
+
+    @classmethod
+    def _is_offline_positive_control(cls, value: Any) -> bool:
+        return cls._normalize_action_text(value) in {"确定", "确认", "确定下架", "确认下架"}
+
+    async def _dialog_control_is_usable(self, element) -> bool:
+        """Validate one dialog-local click target without following handlers outside the dialog."""
+        try:
+            if not await element.is_visible() or not await element.is_enabled():
+                return False
+            box = await element.bounding_box()
+            if not box or box.get("width", 0) <= 0 or box.get("height", 0) <= 0:
+                return False
+            pointer_events = await element.evaluate("(el) => getComputedStyle(el).pointerEvents || ''")
+            if str(pointer_events or "").lower() == "none":
+                return False
+            center_is_clear = await element.evaluate(
+                """
+                (el) => {
+                    const rect = el.getBoundingClientRect();
+                    if (!rect || rect.width <= 0 || rect.height <= 0) return false;
+                    const hit = document.elementFromPoint(
+                        rect.left + rect.width / 2,
+                        rect.top + rect.height / 2
+                    );
+                    if (!hit) return false;
+                    const dialog = el.closest('[role="dialog"], .ant-modal-content');
+                    if (!dialog || !dialog.contains(el) || !dialog.contains(hit)) return false;
+                    if (hit === el || el.contains(hit)) return true;
+                    let node = el.parentElement;
+                    while (node && node !== dialog) {
+                        const style = getComputedStyle(node);
+                        const interactive =
+                            node.tagName === 'BUTTON' ||
+                            node.getAttribute('role') === 'button' ||
+                            style.cursor === 'pointer';
+                        if (interactive && (hit === node || node.contains(hit))) return true;
+                        node = node.parentElement;
+                    }
+                    return false;
+                }
+                """
+            )
+            return bool(center_is_clear)
+        except Exception:
+            return False
+
+    async def _dialog_control_has_deeper_exact_candidate(
+        self,
+        element,
+        allowed_texts: set[str],
+    ) -> bool:
+        """Drop wrapper nodes when a deeper visible descendant carries the same exact action text."""
+        normalized_allowed = sorted({self._normalize_action_text(text) for text in allowed_texts})
+        try:
+            return bool(
+                await element.evaluate(
+                    """
+                    (el, allowed) => {
+                        const normalize = (value) => (value || '').replace(/\\s+/g, '');
+                        return Array.from(el.querySelectorAll('button,[role="button"],div,span')).some((child) => {
+                            if (!allowed.includes(normalize(child.innerText || child.textContent || ''))) return false;
+                            const style = getComputedStyle(child);
+                            const rect = child.getBoundingClientRect();
+                            return style.display !== 'none' &&
+                                style.visibility !== 'hidden' &&
+                                Number(style.opacity || '1') !== 0 &&
+                                rect.width > 0 && rect.height > 0;
+                        });
+                    }
+                    """,
+                    normalized_allowed,
+                )
+            )
+        except Exception:
+            return False
+
+    async def _collect_dialog_exact_controls(
+        self,
+        dialog,
+        selector: str,
+        allowed_texts: set[str],
+    ) -> list[Any]:
+        """Collect leaf-most, visible, exact-text controls from the selected dialog only."""
+        try:
+            elements = await dialog.query_selector_all(selector)
+        except Exception:
+            return []
+        controls: list[Any] = []
+        for element in elements:
+            try:
+                text = await element.inner_text()
+                if self._normalize_action_text(text) not in {
+                    self._normalize_action_text(value) for value in allowed_texts
+                }:
+                    continue
+                if not await self._dialog_control_is_usable(element):
+                    continue
+                if await self._dialog_control_has_deeper_exact_candidate(element, allowed_texts):
+                    continue
+                controls.append(element)
+            except Exception:
+                continue
+        return controls
+
+    @classmethod
+    def _is_offline_success_text(cls, value: Any) -> bool:
+        normalized = cls._normalize_action_text(value)
+        return any(marker in normalized for marker in ("下架成功", "已下架", "商品已下架"))
+
+    async def _page_auth_or_verification_failure(self) -> str | None:
+        if not self.page:
+            return "browser_not_initialized"
+        current_url = (self.page.url or "").lower()
+        if any(marker in current_url for marker in ("login", "passport", "auth")):
+            return "login_required"
+        try:
+            page_text = await self.page.evaluate("() => document.body.innerText || ''")
+        except Exception:
+            page_text = ""
+        if any(marker in page_text for marker in ("扫码登录", "登录后可以", "请先登录")):
+            return "login_required"
+        if any(marker in page_text for marker in ("滑块验证", "人脸验证", "验证码", "安全验证")):
+            return "manual_verification_required"
+        return None
+
+    async def _owner_action_context_text(self, element) -> str:
+        """Return the smallest nearby container that looks like owner operations."""
+        try:
+            return await element.evaluate(
+                """
+                (el) => {
+                    let node = el;
+                    for (let depth = 0; node && depth < 7; depth += 1, node = node.parentElement) {
+                        const text = (node.innerText || node.textContent || '').replace(/\\s+/g, ' ').trim();
+                        if (text.includes('下架') && text.includes('删除') && text.length <= 500) {
+                            return text;
+                        }
+                    }
+                    return '';
+                }
+                """
+            )
+        except Exception:
+            return ""
+
+    async def _find_unique_offline_control(self) -> tuple[Any | None, bool]:
+        """Resolve exactly one actionable owner `下架` control or fail closed."""
+        if not self.page:
+            return None, False
+        candidates = []
+        try:
+            elements = await self.page.query_selector_all("button, [role='button'], a, div, span")
+        except Exception:
+            return None, False
+        for element in elements:
+            try:
+                text = await element.inner_text()
+                if not self._is_safe_offline_action_text(text):
+                    continue
+                if not await element.is_visible() or not await element.is_enabled():
+                    continue
+                box = await element.bounding_box()
+                if not box or box.get("width", 0) <= 0 or box.get("height", 0) <= 0:
+                    continue
+                context_text = await self._owner_action_context_text(element)
+                if not context_text or "下架" not in context_text or "删除" not in context_text:
+                    continue
+                await element.click(trial=True, timeout=2000)
+                candidates.append(element)
+            except Exception:
+                continue
+        if len(candidates) != 1:
+            return None, len(candidates) > 1
+        return candidates[0], False
+
+    async def _find_safe_offline_confirmation(self) -> tuple[Any | None, bool, bool]:
+        """Return one safe confirm control from one visible local dialog, or fail closed."""
+        if not self.page:
+            return None, True, False
+
+        # Prefer semantic dialog roots. Ant Modal can expose nested `.ant-modal` and
+        # `.ant-modal-content` nodes for one logical dialog, so mixing broad selectors
+        # would double-count the same confirmation UI.
+        visible_dialogs: list[tuple[Any, str]] = []
+        for selector in ("[role='dialog']", ".ant-modal-content"):
+            try:
+                dialogs = await self.page.query_selector_all(selector)
+            except Exception:
+                dialogs = []
+            current: list[tuple[Any, str]] = []
+            for dialog in dialogs:
+                try:
+                    if not await dialog.is_visible():
+                        continue
+                    text = await dialog.inner_text()
+                    if self._normalize_action_text(text):
+                        current.append((dialog, text))
+                except Exception:
+                    continue
+            if current:
+                visible_dialogs = current
+                break
+
+        # This method is called after the owner `下架` click. Missing or multiple
+        # confirmation dialogs are therefore an unknown outcome and must fail closed.
+        if len(visible_dialogs) != 1:
+            return None, True, False
+
+        dialog, dialog_text = visible_dialogs[0]
+        normalized_dialog = self._normalize_action_text(dialog_text)
+        offline_markers = ("下架", "停止出售", "暂停出售", "停止销售")
+        dangerous_markers = ("删除", "永久删除", "注销", "清空", "编辑", "发布", "上架")
+        if not any(marker in normalized_dialog for marker in offline_markers):
+            return None, True, False
+        if any(marker in normalized_dialog for marker in dangerous_markers):
+            return None, True, False
+
+        positive_texts = {"确定", "确认", "确定下架", "确认下架"}
+        cancel_texts = {"取消", "关闭"}
+
+        # Preserve the semantic-button path first. If the official dialog renders its
+        # controls as non-semantic div/span nodes, fall back strictly inside this same
+        # dialog using normalized exact text and leaf-most deduplication.
+        semantic_selector = "button, [role='button']"
+        semantic_positive = await self._collect_dialog_exact_controls(
+            dialog, semantic_selector, positive_texts
+        )
+        semantic_cancel = await self._collect_dialog_exact_controls(
+            dialog, semantic_selector, cancel_texts
+        )
+        if len(semantic_positive) > 1:
+            return None, True, False
+        if len(semantic_positive) == 1 and semantic_cancel:
+            return semantic_positive[0], True, True
+
+        fallback_selector = "button, [role='button'], div, span"
+        fallback_positive = await self._collect_dialog_exact_controls(
+            dialog, fallback_selector, positive_texts
+        )
+        fallback_cancel = await self._collect_dialog_exact_controls(
+            dialog, fallback_selector, cancel_texts
+        )
+
+        # The official normal-Web confirm helper has one cancel/close escape action and
+        # one positive action. Exact text prevents the title `确定要下架这个宝贝吗？` from
+        # becoming a positive candidate; leaf-most dedup prevents div > span wrappers
+        # from counting the same action twice. Any remaining ambiguity fails closed.
+        if len(fallback_positive) != 1 or not fallback_cancel:
+            return None, True, False
+        return fallback_positive[0], True, True
+
+    async def _wait_for_offline_ui_success(self) -> bool:
+        if not self.page:
+            return False
+        loop = asyncio.get_running_loop()
+        deadline = loop.time() + 10
+        while loop.time() < deadline:
+            try:
+                body_text = await self.page.evaluate("() => document.body.innerText || ''")
+            except Exception:
+                body_text = ""
+            if self._is_offline_success_text(body_text):
+                return True
+            offline_control, ambiguous = await self._find_unique_offline_control()
+            if not ambiguous and offline_control is None:
+                try:
+                    reverse = self.page.locator("text=/^(上架|重新上架)$/")
+                    count = await reverse.count()
+                    for index in range(count):
+                        if await reverse.nth(index).is_visible():
+                            return True
+                except Exception:
+                    pass
+            await asyncio.sleep(0.5)
+        return False
+
+    async def offline_item(self, *, item_id: str, cookies_str: str) -> dict[str, Any]:
+        """Take one normal-account item off sale through its official Web owner UI."""
+        normalized_item_id = str(item_id or "").strip()
+        result: dict[str, Any] = {
+            "item_id": normalized_item_id,
+            "success": False,
+            "message": "",
+            "ui_actions": 0,
+            "unique_offline_control_found": False,
+            "ambiguous_offline_control": False,
+            "confirm_dialog_required": False,
+            "confirm_dialog_safe": False,
+            "ui_success": False,
+            "auth_failure": False,
+        }
+        try:
+            detail_url = self.normal_item_detail_url(normalized_item_id)
+            await self.initialize(headless=True)
+            await self.set_cookies(cookies_str)
+            if not self.page:
+                raise Exception("browser_not_initialized")
+            await self.page.goto("https://www.goofish.com/", wait_until="domcontentloaded", timeout=30000)
+            await asyncio.sleep(1)
+            await self.page.goto(detail_url, wait_until="domcontentloaded", timeout=30000)
+            await asyncio.sleep(3)
+
+            failure = await self._page_auth_or_verification_failure()
+            if failure:
+                result["auth_failure"] = failure == "login_required"
+                result["message"] = failure
+                return result
+
+            current_url = self.page.url or ""
+            match = re.search(r"[?&]id=(\d+)", current_url)
+            if not match or match.group(1) != normalized_item_id:
+                result["message"] = "target_item_mismatch"
+                return result
+
+            offline_control, ambiguous = await self._find_unique_offline_control()
+            result["ambiguous_offline_control"] = ambiguous
+            if ambiguous:
+                result["message"] = "ambiguous_offline_control"
+                return result
+            if offline_control is None:
+                result["message"] = "offline_control_not_found"
+                return result
+            result["unique_offline_control_found"] = True
+
+            await offline_control.click(timeout=5000)
+            result["ui_actions"] += 1
+            await asyncio.sleep(0.8)
+
+            confirm_button, dialog_required, dialog_safe = await self._find_safe_offline_confirmation()
+            result["confirm_dialog_required"] = dialog_required
+            result["confirm_dialog_safe"] = dialog_safe
+            if dialog_required and not dialog_safe:
+                result["message"] = "unsafe_or_ambiguous_offline_confirmation"
+                return result
+            if confirm_button is not None:
+                await confirm_button.click(timeout=5000)
+                result["ui_actions"] += 1
+
+            result["ui_success"] = await self._wait_for_offline_ui_success()
+            result["success"] = bool(result["ui_success"])
+            result["message"] = "offline_success" if result["success"] else "offline_state_unconfirmed"
+            return result
+        except Exception as exc:
+            result["message"] = f"browser_failure:{type(exc).__name__}"
+            logger.warning(f"普通Web下架失败 item={normalized_item_id}: {type(exc).__name__}")
+            return result
+        finally:
+            await self.close()
+
diff --git a/common/services/xianyu_publish_service.py b/common/services/xianyu_publish_service.py
index 3b53ba2a1111166d47bf47399e1e7f13c61fb001..e95b5fe7a1da1c7f5a41535e2cb25b83b8de2795 100644
--- a/common/services/xianyu_publish_service.py
+++ b/common/services/xianyu_publish_service.py
@@ -30,0 +31,48 @@ def create_xianyu_publisher(static_root: str | Path | None = None) -> Any:
+async def offline_items_normal_web(
+    *,
+    cookies_str: str,
+    item_ids: list[str],
+) -> dict[str, Any]:
+    """逐商品使用普通 Web owner UI 下架，保持旧批量下架返回结构。"""
+    cleaned_ids: list[str] = []
+    seen: set[str] = set()
+    for raw_item_id in item_ids or []:
+        item_id = str(raw_item_id or "").strip()
+        if item_id and item_id not in seen:
+            seen.add(item_id)
+            cleaned_ids.append(item_id)
+
+    results: list[dict[str, Any]] = []
+    messages: list[str] = []
+    suc_count = 0
+    fail_count = 0
+    for item_id in cleaned_ids:
+        publisher = create_xianyu_publisher()
+        item_result = await publisher.offline_item(
+            item_id=item_id,
+            cookies_str=cookies_str,
+        )
+        success = bool(item_result.get("success"))
+        results.append({"item_id": item_id, "success": success})
+        if success:
+            suc_count += 1
+        else:
+            fail_count += 1
+            messages.append(str(item_result.get("message") or "下架失败"))
+
+    if not cleaned_ids:
+        message = "没有有效的商品ID"
+    elif suc_count == 0:
+        message = messages[0] if messages else "下架失败"
+    else:
+        message = f"下架成功 {suc_count} 个，失败 {fail_count} 个"
+    return {
+        "success": suc_count > 0,
+        "message": message,
+        "suc_count": suc_count,
+        "fail_count": fail_count,
+        "results": results,
+        "cookies_str": cookies_str,
+    }
+
+
