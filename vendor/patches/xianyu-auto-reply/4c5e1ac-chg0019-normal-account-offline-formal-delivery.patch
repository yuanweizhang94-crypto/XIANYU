+from __future__ import annotations
+
+import asyncio
+import importlib.util
+import sys
+import types
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+PUBLISHER_PATH = ROOT / "backend-web" / "app" / "services" / "xianyu_publisher.py"
+ITEMS_ROUTE_PATH = ROOT / "backend-web" / "app" / "api" / "routes" / "items.py"
+
+
+def load_publisher_module():
+    loguru_module = types.ModuleType("loguru")
+    loguru_module.logger = types.SimpleNamespace(
+        info=lambda *args, **kwargs: None,
+        warning=lambda *args, **kwargs: None,
+        error=lambda *args, **kwargs: None,
+    )
+    sys.modules.setdefault("loguru", loguru_module)
