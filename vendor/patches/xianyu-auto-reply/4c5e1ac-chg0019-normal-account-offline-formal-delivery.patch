+class FakeElement:
+    def __init__(
+        self,
+        text: str,
+        context: str = "下架 删除",
+        visible: bool = True,
+        enabled: bool = True,
+        *,
+        tag: str = "button",
+        role: str | None = None,
+        pointer_events: str = "auto",
+        obscured: bool = False,
+    ):
+        self.text = text
+        self.context = context
+        self.visible = visible
+        self.enabled = enabled
+        self.tag = tag.lower()
+        self.role = role
+        self.pointer_events = pointer_events
+        self.obscured = obscured
+        self.clicks = 0
+        self.children: list[FakeElement] = []
+
+    async def inner_text(self):
+        return self.text
+
+    async def is_visible(self):
+        return self.visible
+
+    async def is_enabled(self):
+        return self.enabled
+
+    async def bounding_box(self):
+        return {"width": 80, "height": 30} if self.visible else None
+
+    def _descendants(self):
+        result = []
+        for child in self.children:
+            result.append(child)
+            result.extend(child._descendants())
+        return result
+
+    @staticmethod
+    def _matches_selector(element, selector: str) -> bool:
+        parts = {part.strip() for part in selector.split(",")}
+        return (
+            element.tag in parts
+            or ("[role='button']" in parts and element.role == "button")
+            or ('[role="button"]' in parts and element.role == "button")
+        )
+
+    async def evaluate(self, script, *args):
+        if "pointerEvents" in script and "elementFromPoint" not in script:
+            return self.pointer_events
+        if "elementFromPoint" in script:
+            return not self.obscured
+        if "querySelectorAll('button,[role=\"button\"],div,span')" in script:
+            allowed = set(args[0] if args else [])
+            for child in self._descendants():
+                normalized = "".join(child.text.split())
+                if normalized in allowed and child.visible:
+                    box = await child.bounding_box()
+                    if box and box["width"] > 0 and box["height"] > 0:
+                        return True
+            return False
+        return self.context
+
+    async def click(self, **kwargs):
+        if not kwargs.get("trial"):
+            self.clicks += 1
+
+    async def query_selector_all(self, selector):
+        return [element for element in self._descendants() if self._matches_selector(element, selector)]
+
+
+class FakePage:
+    def __init__(
+        self,
+        elements=None,
+        *,
+        url="https://www.goofish.com/item?id=1070515947040",
+        body="",
+        selector_map=None,
+    ):
+        self.elements = list(elements or [])
+        self.url = url
+        self.body = body
+        self.selector_map = dict(selector_map or {})
+
+    async def query_selector_all(self, selector):
+        if selector in self.selector_map:
+            return self.selector_map[selector]
+        return self.elements
+
+    async def evaluate(self, script):
+        return self.body
+
