+import assert from 'node:assert/strict'
+import fs from 'node:fs'
+import path from 'node:path'
+import test from 'node:test'
+import ts from 'typescript'
+
+const frontendRoot = path.resolve(import.meta.dirname, '..')
+const helperPath = path.join(frontendRoot, 'src/pages/items/offlineUi.ts')
+const itemsPagePath = path.join(frontendRoot, 'src/pages/items/Items.tsx')
+const itemsApiPath = path.join(frontendRoot, 'src/api/items.ts')
+
+const helperSource = fs.readFileSync(helperPath, 'utf8')
+const itemsPageSource = fs.readFileSync(itemsPagePath, 'utf8')
+const itemsApiSource = fs.readFileSync(itemsApiPath, 'utf8')
+const transpiled = ts.transpileModule(helperSource, {
+  compilerOptions: {
+    module: ts.ModuleKind.ES2022,
+    target: ts.ScriptTarget.ES2020,
+  },
+}).outputText
+const helper = await import(`data:text/javascript;base64,${Buffer.from(transpiled).toString('base64')}`)
+
+const item = (id, account = 'acct-1') => ({ id, item_id: String(id), cookie_id: account })
+
+test('single item offline entry exists', () => {
+  assert.match(itemsPageSource, /data-offline-action="single"/)
+  assert.match(itemsPageSource, /onClick=\{\(\) => openSingleOffline\(item\)\}/)
+})
+
+test('single offline opens project confirmation dialog', () => {
+  assert.match(itemsPageSource, /title="确认下架商品？"/)
+  assert.match(itemsPageSource, /确认将该商品从闲鱼下架吗？下架后不会删除商品。/)
+})
+
+test('single cancel only closes dialog and confirm owns submit', () => {
+  assert.match(itemsPageSource, /onConfirm=\{handleSingleOffline\}/)
+  assert.match(itemsPageSource, /onCancel=\{\(\) => setSingleOfflineConfirm\(null\)\}/)
+})
+
+test('offline api uses existing batch-offline route and contract', () => {
+  assert.match(itemsApiSource, /post\(`\$\{ITEM_PREFIX\}\/batch-offline`, \{ cookie_id: cookieId, item_ids: itemIds \}\)/)
+})
+
+test('single handler sends exact item id through existing api', () => {
+  assert.match(itemsPageSource, /batchOfflineItems\(item\.cookie_id, \[item\.item_id\]\)/)
+})
+
+test('single success feedback is explicit', () => {
+  assert.match(itemsPageSource, /商品已成功下架/)
+})
+
+test('single success refreshes item list', () => {
+  const start = itemsPageSource.indexOf('const handleSingleOffline')
+  const end = itemsPageSource.indexOf('const openBatchOffline', start)
+  assert.ok(start >= 0 && end > start)
+  assert.match(itemsPageSource.slice(start, end), /await loadItems\(\)/)
+})
+
+test('single in-flight item cannot start again', () => {
+  assert.equal(helper.canStartSingleOffline('1', new Set(), new Set(['1'])), false)
+  assert.match(itemsPageSource, /disabled=\{offliningItemIds\.has\(item\.item_id\)\}/)
+})
+
+test('single session-confirmed offline item cannot submit again', () => {
+  assert.equal(helper.canStartSingleOffline('1', new Set(['1']), new Set()), false)
+})
+
+test('all-failure result remains failure', () => {
+  const summary = helper.summarizeOfflineResponse(
+    { success: false, message: 'offline_state_unconfirmed', data: { suc_count: 0, fail_count: 1, results: [{ item_id: '1', success: false }] } },
+    ['1'],
+  )
+  assert.equal(summary.successCount, 0)
+  assert.equal(summary.failCount, 1)
+  assert.deepEqual(summary.failedIds, ['1'])
+})
+
+test('partial success reports both counts and failed ids', () => {
+  const summary = helper.summarizeOfflineResponse(
+    { success: true, data: { suc_count: 1, fail_count: 1, results: [{ item_id: '1', success: true }, { item_id: '2', success: false }] } },
+    ['1', '2'],
+  )
+  assert.equal(summary.partialFailure, true)
+  assert.equal(summary.successCount, 1)
+  assert.equal(summary.failCount, 1)
+  assert.deepEqual(summary.failedIds, ['2'])
+})
+
+test('session expiry gets restore-login guidance', () => {
+  assert.equal(helper.getOfflineFailureMessage('login_required'), '账号登录状态已失效，请先恢复登录。')
+})
+
+test('verification requirement is not exposed as stack text', () => {
+  assert.equal(helper.getOfflineFailureMessage('manual_verification_required'), '账号需要人工验证，请先完成官方验证。')
+})
+
+test('frontend does not consume or display cookies_str', () => {
+  assert.equal(itemsPageSource.includes('cookies_str'), false)
+  assert.equal(helperSource.includes('cookies_str'), false)
+})
+
+test('delete row action remains separate from offline action', () => {
+  assert.match(itemsPageSource, /setDeleteItemConfirm\(\{ open: true, item \}\)/)
