@@ -0,0 +1,115 @@
+import type { BatchOfflineResponseData } from '@/api/items'
+import type { ApiResponse, Item } from '@/types'
+
+export type OfflinePlanFailure = 'EMPTY' | 'ACCOUNT_REQUIRED' | 'MULTI_ACCOUNT' | 'ALREADY_OFFLINE'
+
+export type BatchOfflinePlan =
+  | { ok: true; cookieId: string; itemIds: string[] }
+  | { ok: false; reason: OfflinePlanFailure }
+
+export interface OfflineResultSummary {
+  successCount: number
+  failCount: number
+  successfulIds: string[]
+  failedIds: string[]
+  partialFailure: boolean
+  authFailure: boolean
+  verificationRequired: boolean
+}
+
+const normalizeMessage = (value?: string) => (value || '').trim().toLowerCase()
+
+export const isOfflineAuthFailureMessage = (message?: string): boolean => {
+  const value = normalizeMessage(message)
+  return [
+    'login_required',
+    'session_expired',
+    'session expired',
+    'cookie为空',
+    'cookie expired',
+    '登录状态',
+    '请先登录',
+  ].some((marker) => value.includes(marker))
+}
+
+export const isOfflineVerificationMessage = (message?: string): boolean => {
+  const value = normalizeMessage(message)
+  return [
+    'manual_verification_required',
+    '滑块验证',
+    '人脸验证',
+    '安全验证',
+    '验证码',
+  ].some((marker) => value.includes(marker))
+}
+
+export const getOfflineFailureMessage = (message?: string): string => {
+  if (isOfflineAuthFailureMessage(message)) {
+    return '账号登录状态已失效，请先恢复登录。'
+  }
+  if (isOfflineVerificationMessage(message)) {
+    return '账号需要人工验证，请先完成官方验证。'
+  }
+  return '下架失败，请检查账号登录状态后重试。'
+}
+
+export const buildBatchOfflinePlan = (
+  selectedItems: Item[],
+  selectedAccount: string,
+  sessionOfflineItemIds: ReadonlySet<string>,
+): BatchOfflinePlan => {
+  if (selectedItems.length === 0) return { ok: false, reason: 'EMPTY' }
+  if (!selectedAccount) return { ok: false, reason: 'ACCOUNT_REQUIRED' }
+  if (selectedItems.some((item) => item.cookie_id !== selectedAccount)) {
+    return { ok: false, reason: 'MULTI_ACCOUNT' }
+  }
+  if (selectedItems.some((item) => sessionOfflineItemIds.has(item.item_id))) {
+    return { ok: false, reason: 'ALREADY_OFFLINE' }
+  }
+  return {
+    ok: true,
+    cookieId: selectedAccount,
+    itemIds: Array.from(new Set(selectedItems.map((item) => item.item_id))),
+  }
+}
+
+export const summarizeOfflineResponse = (
+  response: ApiResponse<BatchOfflineResponseData>,
+  requestedIds: string[],
+): OfflineResultSummary => {
+  const results = Array.isArray(response.data?.results) ? response.data?.results || [] : []
+  const countedSuccess = results.filter((item) => item.success).length
+  const countedFailure = results.filter((item) => !item.success).length
+  const explicitSuccess = Number.isFinite(response.data?.suc_count)
+    ? Number(response.data?.suc_count)
+    : undefined
+  const explicitFailure = Number.isFinite(response.data?.fail_count)
+    ? Number(response.data?.fail_count)
+    : undefined
+
+  const successCount = explicitSuccess ?? (results.length > 0 ? countedSuccess : response.success ? requestedIds.length : 0)
+  const failCount = explicitFailure ?? (results.length > 0 ? countedFailure : response.success ? 0 : requestedIds.length)
+
+  const successfulIds = results.length > 0
+    ? results.filter((item) => item.success).map((item) => item.item_id)
+    : successCount === requestedIds.length
+      ? [...requestedIds]
+      : []
+  const failedIds = results.filter((item) => !item.success).map((item) => item.item_id)
+
+  return {
+    successCount,
+    failCount,
+    successfulIds,
+    failedIds,
+    partialFailure: successCount > 0 && failCount > 0,
+    authFailure: isOfflineAuthFailureMessage(response.message),
+    verificationRequired: isOfflineVerificationMessage(response.message),
+  }
+}
+
+export const canStartSingleOffline = (
+  itemId: string,
+  sessionOfflineItemIds: ReadonlySet<string>,
+  inFlightItemIds: ReadonlySet<string>,
+): boolean => !sessionOfflineItemIds.has(itemId) && !inFlightItemIds.has(itemId)
