+def run_dialog_classifier(
+    title: str,
+    buttons: list[str],
+    *,
+    page_body: str = "",
+    tag: str = "button",
+    role: str | None = None,
+):
+    module = load_publisher_module()
+    dialog = FakeElement(title, tag="div", role="dialog")
+    dialog.children = [FakeElement(text, context="", tag=tag, role=role) for text in buttons]
+    publisher = module.XianyuPublisher()
+    publisher.page = FakePage(
+        body=page_body,
+        selector_map={"[role='dialog']": [dialog], ".ant-modal-content": []},
+    )
+    return asyncio.run(publisher._find_safe_offline_confirmation())
