diff --git a/tests/test_chg0018_frontend_spa_cache.py b/tests/test_chg0018_frontend_spa_cache.py
new file mode 100644
index 0000000000000000000000000000000000000000..e890811015ac77bda9be447d3787deec6420c2b0
--- /dev/null
+++ b/tests/test_chg0018_frontend_spa_cache.py
@@ -0,0 +1,22 @@
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+NGINX = ROOT / "docker/frontend/nginx.conf"
+
+
+def test_spa_entry_is_not_cached_while_hashed_assets_stay_immutable() -> None:
+    source = NGINX.read_text(encoding="utf-8")
+    assert "location /assets" in source
+    assert 'Cache-Control "public, immutable"' in source
+    assert "location = /index.html" in source
+    assert 'Cache-Control "no-cache, no-store, must-revalidate"' in source
+    assert 'add_header Pragma "no-cache" always;' in source
+    assert 'add_header Expires "0" always;' in source
+
+
+def test_spa_route_fallback_is_not_cached() -> None:
+    source = NGINX.read_text(encoding="utf-8")
+    location = source[source.index("location / {"):]
+    assert 'Cache-Control "no-cache, no-store, must-revalidate"' in location
+    assert "try_files $uri $uri/ /index.html;" in location
