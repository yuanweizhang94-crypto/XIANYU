@@ -22,0 +23,28 @@ type PolishSystemStatus = 'loading' | 'enabled' | 'disabled' | 'unknown'
+const getSessionStatePresentation = (state?: string): { label: string; className: string } => {
+  switch (state) {
+    case 'REAL_BROWSER_LOGIN_READY':
+      return { label: '可用', className: 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300' }
+    case 'SESSION_RENEWING':
+      return { label: '续期中', className: 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300' }
+    case 'SESSION_RENEWABLE':
+      return { label: '待续期', className: 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300' }
+    case 'SESSION_RENEW_SUCCESS':
+    case 'SESSION_CHECK_PENDING':
+    case 'ACCOUNT_RECORD_HEALTHY':
+    case 'COOKIE_PRESENT':
+    case 'PROFILE_PRESENT':
+      return { label: '待检查', className: 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300' }
+    case 'HUMAN_QR_REQUIRED':
+      return { label: '需要扫码', className: 'bg-orange-100 text-orange-700 dark:bg-orange-900/30 dark:text-orange-300' }
+    case 'PLATFORM_VERIFICATION_REQUIRED':
+      return { label: '需要平台验证', className: 'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-300' }
+    case 'SESSION_EXPIRED':
+    case 'SESSION_RENEW_FAILED':
+      return { label: '登录已失效', className: 'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-300' }
+    case 'COOLDOWN':
+      return { label: '冷却中', className: 'bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300' }
+    default:
+      return { label: '状态未知', className: 'bg-slate-100 text-slate-500 dark:bg-slate-700 dark:text-slate-400' }
+  }
+}
