@@ -0,0 +1,25 @@
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+ORDER_SERVICE = ROOT / "common/services/order_service.py"
+
+
+def _block(source: str, start: str, end: str) -> str:
+    a = source.index(start)
+    b = source.index(end, a)
+    return source[a:b]
+
+
+def test_sold_order_request_does_not_force_commonpro_business_header() -> None:
+    source = ORDER_SERVICE.read_text(encoding="utf-8")
+    sold = _block(source, "async def _fetch_sold_orders_page", "# ---- 获取退款订单列表")
+    assert "idle_site_biz_code" not in sold
+    assert "\'Referer\': \'https://seller.goofish.com/?site=COMMONPRO\'" in sold
+    assert "\'Origin\': \'https://seller.goofish.com\'" in sold
+
+
+def test_refund_order_request_is_not_changed_by_sold_order_fix() -> None:
+    source = ORDER_SERVICE.read_text(encoding="utf-8")
+    refund = source[source.index("# ---- 获取退款订单列表"): ]
+    assert "idle_site_biz_code" in refund
