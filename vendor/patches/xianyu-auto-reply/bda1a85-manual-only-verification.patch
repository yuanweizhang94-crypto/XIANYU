diff --git a/tests/test_manual_verification.py b/tests/test_manual_verification.py
new file mode 100644
index 0000000..cc5d99c
--- /dev/null
+++ b/tests/test_manual_verification.py
@@ -0,0 +1,294 @@
+from __future__ import annotations
+
+import threading
+import importlib.util
+import sys
+import types
+from pathlib import Path
+
+import pytest
+
+logger_module = types.ModuleType("loguru")
+logger_module.logger = types.SimpleNamespace(info=lambda *args, **kwargs: None, warning=lambda *args, **kwargs: None)
+sys.modules.setdefault("loguru", logger_module)
+
+xianyu_utils = types.ModuleType("common.utils.xianyu_utils")
+
+
+def trans_cookies(raw: str) -> dict[str, str]:
+    cookies: dict[str, str] = {}
+    for part in raw.split(";"):
+        if "=" in part:
+            name, value = part.split("=", 1)
+            cookies[name.strip()] = value.strip()
+    return cookies
+
+
+xianyu_utils.trans_cookies = trans_cookies
+sys.modules.setdefault("common", types.ModuleType("common"))
+sys.modules.setdefault("common.utils", types.ModuleType("common.utils"))
+sys.modules["common.utils.xianyu_utils"] = xianyu_utils
+
+spec = importlib.util.spec_from_file_location(
+    "manual_verification_under_test",
+    Path(__file__).resolve().parents[1] / "common" / "services" / "captcha" / "manual_verification.py",
+)
+assert spec and spec.loader
+manual = importlib.util.module_from_spec(spec)
+sys.modules["manual_verification_under_test"] = manual
+spec.loader.exec_module(manual)
+
+
+class FakeClock:
+    def __init__(self) -> None:
+        self.value = 0.0
+
+    def __call__(self) -> float:
+        return self.value
+
+    def advance(self, seconds: float) -> None:
+        self.value += seconds
+
+
+class FakePage:
+    def __init__(self, context: "FakeContext", clock: FakeClock, *, redirect_url: str | None = None) -> None:
+        self._context = context
+        self._clock = clock
+        self._redirect_url = redirect_url
+        self.url = ""
+        self.closed = False
+
+    def goto(self, url: str, **_: object) -> None:
+        self.url = self._redirect_url or url
+
+    def wait_for_timeout(self, milliseconds: int) -> None:
+        self._context.polls += 1
+        if self._context.new_x5sec_after_poll is not None and self._context.polls >= 1:
+            self._context.current_cookies = [{"name": "x5sec", "value": self._context.new_x5sec_after_poll}]
+            self.url = "https://h5api.m.goofish.com/home"
+        self._clock.advance(milliseconds / 1000)
+
+    def is_closed(self) -> bool:
+        return self.closed
+
+
+class FakeContext:
+    def __init__(
+        self,
+        clock: FakeClock,
+        *,
+        initial_cookies: list[dict[str, str]] | None = None,
+        new_x5sec_after_poll: str | None = None,
+        redirect_url: str | None = None,
+    ) -> None:
+        self._clock = clock
+        self.current_cookies = initial_cookies or []
+        self.new_x5sec_after_poll = new_x5sec_after_poll
+        self.redirect_url = redirect_url
+        self.polls = 0
+        self.closed = False
+
+    def add_cookies(self, cookies: list[dict[str, object]]) -> None:
+        self.current_cookies = [
+            {"name": str(cookie["name"]), "value": str(cookie["value"])}
+            for cookie in cookies
+            if cookie.get("name") == "x5sec"
+        ]
+
+    def cookies(self) -> list[dict[str, str]]:
+        return self.current_cookies
+
+    def new_page(self) -> FakePage:
+        return FakePage(self, self._clock, redirect_url=self.redirect_url)
+
+    def close(self) -> None:
+        self.closed = True
+
+
+class FakeChromium:
+    def __init__(self, context: FakeContext) -> None:
+        self._context = context
+        self.launch_count = 0
+
+    def launch_persistent_context(self, **kwargs: object) -> FakeContext:
+        assert kwargs["headless"] is False
+        assert "user_data_dir" in kwargs
+        self.launch_count += 1
+        return self._context
+
+
+class FakePlaywright:
+    def __init__(self, chromium: FakeChromium) -> None:
+        self.chromium = chromium
+
+
+class FakePlaywrightContextManager:
+    def __init__(self, chromium: FakeChromium) -> None:
+        self._playwright = FakePlaywright(chromium)
+
+    def __enter__(self) -> FakePlaywright:
+        return self._playwright
+
+    def __exit__(self, *_: object) -> None:
+        return None
+
+
+def fake_factory(chromium: FakeChromium):
+    def _factory() -> FakePlaywrightContextManager:
+        return FakePlaywrightContextManager(chromium)
+
+    return _factory
+
+
+@pytest.fixture(autouse=True)
+def reset_state() -> None:
+    manual.reset_manual_verification_state_for_tests()
+
+
+def test_changed_x5sec_after_leaving_verification_page_succeeds() -> None:
+    clock = FakeClock()
+    context = FakeContext(clock, new_x5sec_after_poll="new-x5sec")
+    chromium = FakeChromium(context)
+
+    ok, cookies, status = manual.run_manual_verification(
+        "ACCOUNT-A",
+        "https://h5api.m.goofish.com/punish?redacted",
+        existing_cookies_str="x5sec=old-x5sec",
+        browser_timeout=30,
+        playwright_factory=fake_factory(chromium),
+        clock=clock,
+    )
+
+    assert ok is True
+    assert cookies == {"x5sec": "new-x5sec"}
+    assert status == "manual_verification_succeeded"
+    assert manual.manual_verification_state_snapshot()["browser_launch_count"] == 1
+    assert context.closed is True
+
+
+def test_existing_same_x5sec_is_not_success_and_second_call_does_not_launch() -> None:
+    clock = FakeClock()
+    context = FakeContext(clock)
+    chromium = FakeChromium(context)
+
+    ok, cookies, status = manual.run_manual_verification(
+        "ACCOUNT-A",
+        "https://h5api.m.goofish.com/punish?redacted",
+        existing_cookies_str="x5sec=same",
+        browser_timeout=30,
+        playwright_factory=fake_factory(chromium),
+        clock=clock,
+    )
+    assert ok is False
+    assert cookies is None
+    assert status == "manual_verification_timed_out"
+    assert chromium.launch_count == 1
+
+    second = manual.run_manual_verification(
+        "ACCOUNT-B",
+        "https://h5api.m.goofish.com/punish?redacted",
+        browser_timeout=30,
+        playwright_factory=fake_factory(chromium),
+        clock=clock,
+    )
+    assert second == (False, None, "manual_already_consumed")
+    assert chromium.launch_count == 1
+
+
+def test_rejects_x5_prefix_cookies_other_than_exact_x5sec() -> None:
+    clock = FakeClock()
+    context = FakeContext(clock, initial_cookies=[{"name": "x5token", "value": "wrong"}])
+    chromium = FakeChromium(context)
+
+    ok, cookies, status = manual.run_manual_verification(
+        "ACCOUNT-A",
+        "https://h5api.m.goofish.com/punish?redacted",
+        browser_timeout=30,
+        playwright_factory=fake_factory(chromium),
+        clock=clock,
+    )
+
+    assert ok is False
+    assert cookies is None
+    assert status == "manual_verification_timed_out"
+
+
+@pytest.mark.parametrize(
+    "url",
+    [
+        "http://h5api.m.goofish.com/punish",
+        "https://user:pass@h5api.m.goofish.com/punish",
+        "https://127.0.0.1/punish",
+        "https://h5api.m.goofish.com:8443/punish",
+        "https://login.taobao.com/punish",
+    ],
+)
+def test_unsafe_initial_urls_fail_before_browser_launch(url: str) -> None:
+    ok, cookies, status = manual.run_manual_verification("ACCOUNT-A", url, browser_timeout=30)
+
+    assert ok is False
+    assert cookies is None
+    assert status == "VERIFICATION_REDIRECT_BLOCKED"
+    assert manual.manual_verification_state_snapshot()["browser_launch_count"] == 0
+
+
+def test_unknown_redirect_fails_closed_after_single_launch() -> None:
+    clock = FakeClock()
+    context = FakeContext(clock, redirect_url="https://example.invalid/after")
+    chromium = FakeChromium(context)
+
+    ok, cookies, status = manual.run_manual_verification(
+        "ACCOUNT-A",
+        "https://h5api.m.goofish.com/punish?redacted",
+        browser_timeout=30,
+        playwright_factory=fake_factory(chromium),
+        clock=clock,
+    )
+
+    assert ok is False
+    assert cookies is None
+    assert status == "VERIFICATION_REDIRECT_BLOCKED"
+    assert chromium.launch_count == 1
+
+
+def test_concurrent_calls_launch_at_most_one_browser() -> None:
+    clock = FakeClock()
+    context = FakeContext(clock)
+    chromium = FakeChromium(context)
+    barrier = threading.Barrier(2)
+    results: list[tuple[bool, dict[str, str] | None, str]] = []
+
+    def run_once(account: str) -> None:
+        barrier.wait()
+        results.append(
+            manual.run_manual_verification(
+                account,
+                "https://h5api.m.goofish.com/punish?redacted",
+                browser_timeout=30,
+                playwright_factory=fake_factory(chromium),
+                clock=clock,
+            )
+        )
+
+    t1 = threading.Thread(target=run_once, args=("ACCOUNT-A",))
+    t2 = threading.Thread(target=run_once, args=("ACCOUNT-B",))
+    t1.start()
+    t2.start()
+    t1.join()
+    t2.join()
+
+    assert chromium.launch_count <= 1
+    assert {result[2] for result in results} <= {
+        "manual_verification_timed_out",
+        "manual_verification_busy_or_consumed",
+        "manual_already_consumed",
+    }
+
+
+def test_process_restart_resets_single_shot_state_for_new_process() -> None:
+    manual.run_manual_verification("ACCOUNT-A", "https://login.taobao.com/punish", browser_timeout=30)
+    assert manual.manual_verification_state_snapshot()["state"] == "FAILED"
+
+    manual.reset_manual_verification_state_for_tests()
+
+    assert manual.manual_verification_state_snapshot() == {"state": "IDLE", "browser_launch_count": 0}
