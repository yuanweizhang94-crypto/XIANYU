index 0000000..09971b8
--- /dev/null
+++ b/common/services/captcha/manual_verification.py
@@ -0,0 +1,231 @@
+"""Manual-only platform verification helper.
+
+This mode opens the official verification URL in one visible local browser and
+waits for the account owner to complete the page. It never moves the mouse,
+types, clicks, drags, injects trajectories, uses DrissionPage, or calls a
+remote solver.
+"""
+from __future__ import annotations
+
+import ipaddress
+import os
+import shutil
+import tempfile
+import threading
+import time
+from http.cookiejar import Cookie
+from typing import Any, Callable, Dict, Iterable
+from urllib.parse import urlparse
+
+from loguru import logger
+
+from common.utils.xianyu_utils import trans_cookies
+
+_ALLOWED_INITIAL_HOST = "h5api.m.goofish.com"
+_ALLOWED_COOKIE_NAMES = {"x5sec"}
+_VERIFICATION_MARKERS = ("punish", "x5secdata", "captcha", "verify", "verification", "baxia")
+_STATE_LOCK = threading.Lock()
+_STATE = "IDLE"
+_BROWSER_LAUNCH_COUNT = 0
+_TERMINAL_STATES = {"SUCCEEDED", "FAILED", "TIMED_OUT", "CANCELLED", "CONSUMED"}
+
+PlaywrightFactory = Callable[[], Any]
+Clock = Callable[[], float]
+
+
+def is_manual_only_enabled() -> bool:
+    return str(os.getenv("CAPTCHA_MANUAL_ONLY", "")).strip().lower() in {
+        "1",
+        "true",
+        "yes",
+        "on",
+    }
+
+
+def manual_timeout_seconds(default: int = 300) -> int:
+    raw = str(os.getenv("CAPTCHA_MANUAL_TIMEOUT_SECONDS", default)).strip()
+    try:
+        value = int(raw)
+    except ValueError:
+        value = default
+    return max(30, min(value, 300))
+
+
+def reset_manual_verification_state_for_tests() -> None:
+    global _BROWSER_LAUNCH_COUNT, _STATE
+    with _STATE_LOCK:
+        _STATE = "IDLE"
+        _BROWSER_LAUNCH_COUNT = 0
+
+
+def manual_verification_state_snapshot() -> dict[str, object]:
+    with _STATE_LOCK:
+        return {"state": _STATE, "browser_launch_count": _BROWSER_LAUNCH_COUNT}
+
+
+def _try_begin() -> tuple[bool, str]:
+    global _STATE
+    with _STATE_LOCK:
+        if _STATE != "IDLE":
+            if _STATE == "RUNNING":
+                return False, "manual_verification_busy_or_consumed"
+            if _STATE in _TERMINAL_STATES:
+                _STATE = "CONSUMED"
+            return False, "manual_already_consumed"
+        _STATE = "RUNNING"
+        return True, "running"
+
+
+def _mark_browser_launch() -> None:
+    global _BROWSER_LAUNCH_COUNT
+    with _STATE_LOCK:
+        _BROWSER_LAUNCH_COUNT += 1
+
+
+def _finish(state: str, status: str) -> str:
+    global _STATE
+    with _STATE_LOCK:
+        _STATE = state
+    return status
+
+
+def _host_allowed(url: str) -> bool:
+    if len(url) > 2048:
+        return False
+    parsed = urlparse(url)
+    if parsed.scheme.lower() != "https":
+        return False
+    if parsed.username or parsed.password:
+        return False
+    if parsed.port is not None:
+        return False
+    host = (parsed.hostname or "").lower()
+    if not host or host != _ALLOWED_INITIAL_HOST:
+        return False
+    try:
+        ipaddress.ip_address(host)
+        return False
+    except ValueError:
+        return True
+
+
+def _safe_host_category(url: str) -> str:
+    return "allowed_goofish_h5api" if _host_allowed(url) else "blocked"
+
+
+def _allowed_cookie(name: str) -> bool:
+    return name.strip().lower() in _ALLOWED_COOKIE_NAMES
+
+
+def _existing_cookie_payloads(cookies_str: str) -> list[dict[str, object]]:
+    payloads: list[dict[str, object]] = []
+    cookies = trans_cookies(cookies_str or "")
+    for name, value in cookies.items():
+        if not name:
+            continue
+        payloads.append({"name": name, "value": value, "domain": ".goofish.com", "path": "/"})
+    return payloads
+
+
+def _extract_allowed(cookies: Iterable[dict[str, object] | Cookie]) -> Dict[str, str]:
+    extracted: Dict[str, str] = {}
+    for cookie in cookies:
+        if isinstance(cookie, Cookie):
+            name = cookie.name
+            value = cookie.value
+        else:
+            name = str(cookie.get("name") or "")
+            value = str(cookie.get("value") or "")
+        if name and value and _allowed_cookie(name):
+            extracted[name.lower()] = value
+    return extracted
+
+
+def _left_verification_page(url: str) -> bool:
+    parsed = urlparse(url)
+    observed = f"{parsed.hostname or ''}{parsed.path or ''}".lower()
+    return bool(observed) and not any(marker in observed for marker in _VERIFICATION_MARKERS)
+
+
+def _default_playwright_factory() -> Any:
+    from playwright.sync_api import sync_playwright
+
+    return sync_playwright()
+
+
+def run_manual_verification(
+    user_id: str,
+    url: str,
+    *,
+    existing_cookies_str: str = "",
+    browser_timeout: int = 300,
+    playwright_factory: PlaywrightFactory | None = None,
+    clock: Clock = time.monotonic,
+) -> tuple[bool, Dict[str, str] | None, str]:
+    """Open one official verification page and wait for a new x5sec Cookie."""
+    begin_ok, begin_status = _try_begin()
+    if not begin_ok:
+        logger.warning(
+            f"[manual-verification] state={begin_status} "
+            f"browser_launch_count={manual_verification_state_snapshot()['browser_launch_count']}"
+        )
+        return False, None, begin_status
+
+    if not _host_allowed(url):
+        logger.warning("[manual-verification] host_category=blocked result=VERIFICATION_REDIRECT_BLOCKED")
+        return False, None, _finish("FAILED", "VERIFICATION_REDIRECT_BLOCKED")
+
+    timeout = min(manual_timeout_seconds(browser_timeout), browser_timeout if browser_timeout else 300)
+    logger.warning(
+        f"[manual-verification] state=RUNNING host_category={_safe_host_category(url)} "
+        f"owner_action_required=true timeout_seconds={timeout}"
+    )
+
+    factory = playwright_factory or _default_playwright_factory
+    started = clock()
+    profile_dir = tempfile.mkdtemp(prefix="xianyu-manual-verification-")
+    context = None
+    playwright_cm = None
+    try:
+        playwright_cm = factory()
+        playwright = playwright_cm.__enter__()
+        _mark_browser_launch()
+        context = playwright.chromium.launch_persistent_context(
+            user_data_dir=profile_dir,
+            headless=False,
+            args=[],
+        )
+        payloads = _existing_cookie_payloads(existing_cookies_str)
+        if payloads:
+            context.add_cookies(payloads)
+        baseline = _extract_allowed(context.cookies()).get("x5sec")
+        page = context.new_page()
+        page.goto(url, wait_until="domcontentloaded", timeout=min(timeout, 60) * 1000)
+
+        while clock() - started <= timeout:
+            if hasattr(page, "is_closed") and page.is_closed():
+                logger.warning("[manual-verification] state=CANCELLED")
+                return False, None, _finish("CANCELLED", "manual_verification_cancelled")
+            current_url = str(getattr(page, "url", "") or "")
+            if current_url and not _host_allowed(current_url):
+                logger.warning("[manual-verification] host_category=blocked result=VERIFICATION_REDIRECT_BLOCKED")
+                return False, None, _finish("FAILED", "VERIFICATION_REDIRECT_BLOCKED")
+            x5sec = _extract_allowed(context.cookies()).get("x5sec")
+            if x5sec and x5sec != baseline and current_url and _left_verification_page(current_url):
+                logger.info("[manual-verification] state=SUCCEEDED cookie_field_count=1")
+                return True, {"x5sec": x5sec}, _finish("SUCCEEDED", "manual_verification_succeeded")
+            page.wait_for_timeout(1000)
+
+        logger.warning("[manual-verification] state=TIMED_OUT")
+        return False, None, _finish("TIMED_OUT", "manual_verification_timed_out")
+    except Exception as exc:
+        logger.warning(f"[manual-verification] state=FAILED error_class={type(exc).__name__}")
+        return False, None, _finish("FAILED", "manual_verification_failed")
+    finally:
+        try:
+            if context is not None:
+                context.close()
+        finally:
+            if playwright_cm is not None:
+                playwright_cm.__exit__(None, None, None)
+            shutil.rmtree(profile_dir, ignore_errors=True)
