+"""Manual-only platform verification helper.
+
+This mode opens the official verification URL in a visible local browser and
+waits for the account owner to complete the page. It never moves the mouse,
+types, clicks, drags, injects trajectories, or calls a remote solver.
+"""
+from __future__ import annotations
+
+import os
+import time
+from http.cookiejar import Cookie
+from typing import Dict, Iterable
+from urllib.parse import urlparse
+
+from loguru import logger
+
+from common.utils.xianyu_utils import trans_cookies
+
+_ALLOWED_HOST_SUFFIXES = (
+    ".goofish.com",
+    ".taobao.com",
+    ".tmall.com",
+    ".alibaba.com",
+    "goofish.com",
+    "taobao.com",
+    "tmall.com",
+    "alibaba.com",
+)
+_ALLOWED_COOKIE_NAMES = {"x5sec"}
+
+
+def is_manual_only_enabled() -> bool:
+    return str(os.getenv("CAPTCHA_MANUAL_ONLY", "")).strip().lower() in {
+        "1",
+        "true",
+        "yes",
+        "on",
+    }
+
+
+def manual_timeout_seconds(default: int = 300) -> int:
+    raw = str(os.getenv("CAPTCHA_MANUAL_TIMEOUT_SECONDS", default)).strip()
+    try:
+        value = int(raw)
+    except ValueError:
+        value = default
+    return max(30, min(value, 300))
+
+
+def _host_allowed(url: str) -> bool:
+    host = (urlparse(url).hostname or "").lower()
+    return any(host == suffix or host.endswith(suffix) for suffix in _ALLOWED_HOST_SUFFIXES)
+
+
+def _allowed_cookie(name: str) -> bool:
+    normalized = name.strip().lower()
+    return normalized in _ALLOWED_COOKIE_NAMES or normalized.startswith("x5")
+
+
+def _existing_cookie_payloads(cookies_str: str) -> list[dict[str, object]]:
+    payloads: list[dict[str, object]] = []
+    cookies = trans_cookies(cookies_str or "")
+    for name, value in cookies.items():
+        if not name:
+            continue
+        for domain in (".goofish.com", ".taobao.com", ".tmall.com"):
+            payloads.append({"name": name, "value": value, "domain": domain, "path": "/"})
+    return payloads
+
+
+def _extract_allowed(cookies: Iterable[dict[str, object] | Cookie]) -> Dict[str, str]:
+    extracted: Dict[str, str] = {}
+    for cookie in cookies:
+        if isinstance(cookie, Cookie):
+            name = cookie.name
+            value = cookie.value
+        else:
+            name = str(cookie.get("name") or "")
+            value = str(cookie.get("value") or "")
+        if name and value and _allowed_cookie(name):
+            extracted[name] = value
+    return extracted
+
+
+def run_manual_verification(
+    user_id: str,
+    url: str,
+    *,
+    existing_cookies_str: str = "",
+    browser_timeout: int = 300,
+) -> tuple[bool, Dict[str, str] | None]:
+    """Open the official verification page and wait for owner-completed x5 cookies."""
+    if not _host_allowed(url):
+        logger.warning(f"[manual-verification] account={user_id} blocked non-official verification host")
+        return False, None
+
+    timeout = min(manual_timeout_seconds(browser_timeout), browser_timeout if browser_timeout else 300)
+    logger.warning(
+        f"[manual-verification] account={user_id} opening visible official verification page; "
+        f"owner action required within {timeout} seconds"
+    )
+
+    from playwright.sync_api import sync_playwright
+
+    started = time.monotonic()
+    with sync_playwright() as playwright:
+        browser = playwright.chromium.launch(headless=False)
+        context = browser.new_context()
+        try:
+            payloads = _existing_cookie_payloads(existing_cookies_str)
+            if payloads:
+                context.add_cookies(payloads)
+            page = context.new_page()
+            page.goto(url, wait_until="domcontentloaded", timeout=min(timeout, 60) * 1000)
+            while time.monotonic() - started <= timeout:
+                cookies = _extract_allowed(context.cookies())
+                if cookies:
+                    logger.info(
+                        f"[manual-verification] account={user_id} owner-completed page produced "
+                        f"{len(cookies)} allowed cookie fields"
+                    )
+                    return True, cookies
+                page.wait_for_timeout(1000)
+            logger.warning(f"[manual-verification] account={user_id} timed out waiting for owner completion")
+            return False, None
+        finally:
+            context.close()
+            browser.close()
