+    async def _wait_for_registration_response(self, ws, reg_mid: str, timeout: float = 5.0):
+        """等待 /reg 的匹配响应，避免只凭底层连接/心跳误判业务订阅已就绪。"""
+        loop = asyncio.get_running_loop()
+        deadline = loop.time() + timeout
+
+        while True:
+            remaining = deadline - loop.time()
+            if remaining <= 0:
+                raise asyncio.TimeoutError("WebSocket registration response timeout")
+
+            try:
+                raw_message = await asyncio.wait_for(ws.recv(), timeout=remaining)
+            except asyncio.TimeoutError as exc:
+                raise asyncio.TimeoutError("WebSocket registration response timeout") from exc
+
+            if raw_message is None:
+                raise ConnectionError("WebSocket closed before registration response")
+
+            try:
+                message_data = json.loads(raw_message)
+            except Exception as exc:
+                logger.warning(f"【{self.cookie_id}】注册阶段收到无法解析的消息: {self._safe_str(exc)}")
+                continue
+
+            if self.connection_manager.handle_heartbeat_response(message_data):
+                continue
+
+            headers = message_data.get("headers") if isinstance(message_data, dict) else {}
+            response_mid = headers.get("mid") if isinstance(headers, dict) else None
+            if response_mid == reg_mid:
+                code = message_data.get("code", 0)
+                if code != 200:
+                    raise RuntimeError(f"WebSocket registration rejected: code={code}")
+                logger.info(f"【{self.cookie_id}】WebSocket注册响应确认成功")
+                return message_data
+
+            # 注册确认前到达的其他合法帧不能丢弃，继续交给既有分派/消息处理链。
+            self._dispatch_mid_response(message_data)
+            self._create_tracked_task(
+                self._handle_message_with_semaphore(message_data, ws)
+            )
+
