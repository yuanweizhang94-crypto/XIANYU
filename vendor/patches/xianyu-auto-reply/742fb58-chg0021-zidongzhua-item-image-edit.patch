+def _validate_uploaded_product_images(images: List[str]) -> tuple[bool, str]:
+    """Allow item editing to consume only XIANYU's own product-upload static files."""
+    product_root = (STATIC_ROOT / "uploads" / "products").resolve()
+    for raw in images:
+        value = str(raw or "").strip()
+        if not value.startswith("/static/uploads/products/"):
+            return False, "商品编辑图片必须先通过 XIANYU 商品图片上传接口"
+        relative = value.removeprefix("/static/")
+        resolved = (STATIC_ROOT / relative).resolve()
+        if resolved == product_root or product_root not in resolved.parents:
+            return False, "商品编辑图片路径不在允许目录"
+        if not resolved.is_file():
+            return False, "商品编辑图片文件不存在"
+    return True, ""
