+def _normalized_image_url(value: Any) -> str:
+    """Normalize a platform image URL without discarding the real returned URL."""
+    raw = text(value)
+    if raw.startswith("//"):
+        raw = "https:" + raw
+    return raw.split("?", 1)[0].rstrip("/")
+
+
+def _image_compare_key(value: Any) -> str:
+    """Treat Alibaba CDN path/scheme rewrites of the same uploaded object as equivalent."""
+    normalized = _normalized_image_url(value)
+    if "alicdn.com/" in normalized:
+        return normalized.rsplit("/", 1)[-1]
+    return normalized.replace("http://", "https://", 1)
+
+
+def _edit_payload_from_detail(detail: dict[str, Any]) -> dict[str, Any]:
+    """Keep only fields the official PC edit form submits back to idleitem.edit."""
+    return {key: detail[key] for key in _EDIT_PAYLOAD_FIELDS if key in detail}
