+    manager = get_manager()
+    status = manager.get_task_status(account_id)
+    persisted = manager.platform_verification_states.get(account_id)
+    if not status.get("platform_verification_required") and not persisted:
+        return {
+            "success": False,
+            "code": 409,
+            "message": "PLATFORM_VERIFICATION_REQUIRED_STATE_REQUIRED",
+            "data": {"account_id": account_id, "human_browser_visible": False},
+        }
+
+    result = await cookie_renew_browser_service.open_human_verification(account_id)
+    state = str(result.get("state") or "HUMAN_BROWSER_START_FAILED")
+    return {
+        "success": bool(result.get("success")),
+        "code": 200 if result.get("success") else 409,
+        "message": state,
+        "data": {
+            "account_id": account_id,
+            "state": state,
+            "human_browser_visible": bool(result.get("human_browser_visible")),
+            "canonical_profile_reused": bool(result.get("canonical_profile_reused")),
+            "official_url_only": bool(result.get("official_url_only")),
