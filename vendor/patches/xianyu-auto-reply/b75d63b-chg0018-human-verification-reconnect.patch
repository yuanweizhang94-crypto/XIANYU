+@router.post("/accounts/{account_id}/human-verification/recheck")
+async def recheck_after_human_verification(account_id: str):
+    """Explicit one-shot canonical Profile health probe after the real user finishes verification."""
+    from sqlalchemy.orm.attributes import flag_modified
+    from app.services.xianyu.cookie_manager import get_manager
+    from common.db.session import async_session_maker
+    from common.services.cookie_renew_browser_service import cookie_renew_browser_service
+    from common.utils.cookie_refresh import get_account_by_identity, update_account_cookies_in_db
+
+    manager = get_manager()
+    status = manager.get_task_status(account_id)
+    persisted = manager.platform_verification_states.get(account_id)
+    if not status.get("platform_verification_required") and not persisted:
+        return {
+            "success": False,
+            "code": 409,
+            "message": "PLATFORM_VERIFICATION_REQUIRED_STATE_REQUIRED",
+            "data": {"account_id": account_id, "recheck_performed": False},
+        }
+
+    async with async_session_maker() as session:
+        account = await get_account_by_identity(account_id, session=session)
+        if not account:
+            return {
+                "success": False,
+                "code": 404,
+                "message": "ACCOUNT_NOT_FOUND",
+                "data": None,
+            }
+        current_cookie = str(account.cookie or "")
+        owner_id = getattr(account, "owner_id", None)
+
+    result = await cookie_renew_browser_service.check_real_browser_login(
+        current_cookie,
+        account_id,
+        sync_db_cookie_to_profile=False,
+    )
+    state = str(result.state or "SESSION_RENEW_FAILED")
+    if not result.ready or state != "REAL_BROWSER_LOGIN_READY":
+        return {
+            "success": False,
+            "code": 200,
+            "message": state,
+            "data": {
+                "account_id": account_id,
+                "state": state,
+                "recheck_performed": True,
+                "platform_verification_cleared": False,
+                "websocket_restarted": False,
+            },
+        }
+
+    new_cookie = str(result.new_cookies_str or current_cookie)
+    if new_cookie != current_cookie:
+        saved = await update_account_cookies_in_db(
+            account_id,
+            new_cookie,
+            owner_id=owner_id,
+            allow_platform_verification_write=True,
+        )
+        if not saved:
+            return {
+                "success": False,
+                "code": 500,
+                "message": "VERIFICATION_COOKIE_PERSIST_FAILED",
+                "data": {
+                    "account_id": account_id,
+                    "state": "VERIFICATION_COOKIE_PERSIST_FAILED",
+                    "recheck_performed": True,
+                    "platform_verification_cleared": False,
+                    "websocket_restarted": False,
+                },
+            }
+
+    instance = manager.instances.get(account_id)
+    if instance is not None:
+        await instance._cookie_token_manager._persist_platform_verification_marker(required=False)
+        instance._cookie_token_manager._clear_platform_verification_required()
+    else:
+        async with async_session_maker() as session:
+            account = await get_account_by_identity(account_id, session=session)
+            if account:
+                metadata = dict(account.metadata_json or {})
+                metadata.pop("auto_reply_platform_verification", None)
+                account.metadata_json = metadata
+                flag_modified(account, "metadata_json")
+                session.add(account)
+                await session.commit()
+    manager.platform_verification_states.pop(account_id, None)
+
+    return {
+        "success": True,
+        "code": 200,
+        "message": "REAL_BROWSER_LOGIN_READY",
+        "data": {
+            "account_id": account_id,
+            "state": "REAL_BROWSER_LOGIN_READY",
+            "recheck_performed": True,
+            "platform_verification_cleared": True,
+            "cookie_updated": new_cookie != current_cookie,
+            "websocket_restarted": False,
+        },
+    }
+
