diff --git a/tests/test_chg0018_auto_reply_session_safety.py b/tests/test_chg0018_auto_reply_session_safety.py
new file mode 100644
index 0000000000000000000000000000000000000000..132b5179201fb12006ac3ecdc8b59c32edba94df
--- /dev/null
+++ b/tests/test_chg0018_auto_reply_session_safety.py
@@ -0,0 +1,175 @@
+from __future__ import annotations
+
+import ast
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+from types import SimpleNamespace
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parents[1]
+ACCOUNT_ROUTE = ROOT / "backend-web" / "app" / "api" / "routes" / "cookies.py"
+WS_COOKIE_MANAGER = ROOT / "websocket" / "app" / "services" / "xianyu" / "cookie_manager.py"
+WS_TOKEN_MANAGER = ROOT / "websocket" / "app" / "services" / "xianyu" / "cookie_token_manager.py"
+WS_MAIN = ROOT / "websocket" / "app" / "services" / "xianyu" / "xianyu_async.py"
+WS_INTERNAL = ROOT / "websocket" / "app" / "api" / "routes" / "internal.py"
+
+
+def _read(path: Path) -> str:
+    return path.read_text(encoding="utf-8-sig")
+
+
+def _load_capability_builder():
+    source = _read(ACCOUNT_ROUTE)
+    tree = ast.parse(source)
+    wanted = {
+        "_status_to_enabled",
+        "_consumer_record",
+        "_build_platform_restriction",
+        "_business_capability",
+        "_bounded_operation_active",
+        "_build_business_capabilities",
+    }
+    nodes = [
+        node
+        for node in tree.body
+        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and node.name in wanted
+    ]
+    namespace = {
+        "Any": Any,
+        "XYAccount": object,
+        "datetime": datetime,
+        "timedelta": timedelta,
+        "timezone": timezone,
+        "safe_isoformat": lambda value: value.isoformat() if value else None,
+    }
+    module = ast.Module(body=nodes, type_ignores=[])
+    exec(compile(module, str(ACCOUNT_ROUTE), "exec"), namespace)
+    return namespace["_build_business_capabilities"]
+
+
+_build_business_capabilities = _load_capability_builder()
+
+
+def _account():
+    return SimpleNamespace(
+        status="active",
+        disable_reason="",
+        updated_at=None,
+        metadata_json={
+            "session_maintenance": {
+                "state": "SESSION_CHECK_PENDING",
+                "consumers": {},
+            }
+        },
+    )
+
+
+def _auto_reply(ws_status: dict[str, Any]):
+    return _build_business_capabilities(
+        _account(),
+        ws_status,
+        {},
+        "2026-08-18T14:40:00+08:00",
+    )["auto_reply"]
+
+
+def test_connected_websocket_requires_token_before_auto_reply_is_online():
+    ready = _auto_reply(
+        {
+            "running": True,
+            "is_connected": True,
+            "connection_state": "connected",
+            "token_ready": True,
+            "token_refresh_status": "success",
+        }
+    )
+    assert ready["state"] == "ONLINE"
+    assert ready["reason"] == "websocket_connected_token_ready"
+
+    no_credentials = _auto_reply(
+        {
+            "running": True,
+            "is_connected": True,
+            "connection_state": "connected",
+            "token_ready": False,
+            "token_refresh_status": "no_credentials",
+        }
+    )
+    assert no_credentials["state"] == "LOGIN_REQUIRED"
+    assert no_credentials["label"] == "需登录"
+
+    expired = _auto_reply(
+        {
+            "running": True,
+            "is_connected": True,
+            "connection_state": "connected",
+            "token_ready": False,
+            "token_refresh_status": "failed_session_expired",
+        }
+    )
+    assert expired["state"] == "TEMPORARY_FAILURE"
+    assert expired["label"] == "Session失效"
+
+
+def test_platform_verification_cannot_be_reported_as_auto_reply_online():
+    capability = _auto_reply(
+        {
+            "running": True,
+            "is_connected": True,
+            "connection_state": "connected",
+            "token_ready": False,
+            "token_refresh_status": "platform_verification_required",
+        }
+    )
+    assert capability["state"] == "PLATFORM_VERIFICATION_REQUIRED"
+    assert capability["auto_recoverable"] is False
+
+
+def test_websocket_status_exposes_token_readiness_and_backend_reads_connected_accounts():
+    manager_source = _read(WS_COOKIE_MANAGER)
+    assert '"token_ready"' in manager_source
+    assert '"token_refresh_status"' in manager_source
+
+    route_source = _read(ACCOUNT_ROUTE)
+    block = route_source[
+        route_source.index("async def _load_websocket_task_statuses") :
+        route_source.index("def _build_business_capabilities")
+    ]
+    assert "account.account_id not in online_ids" not in block
+    assert "websocket_client.get_account_status(account.account_id)" in block
+
+
+def test_session_expiry_and_no_credentials_are_non_counted_and_do_not_auto_disable():
+    source = _read(WS_MAIN)
+    block = source[
+        source.index("non_counted_statuses = (") :
+        source.index("# 更新连接状态", source.index("non_counted_statuses = ("))
+    ]
+    for status in (
+        "human_qr_required",
+        "platform_verification_required",
+        "failed_session_expired",
+        "no_credentials",
+    ):
+        assert repr(status) in block
+    assert "sleep_duration = 300" in block
+
+    token_source = _read(WS_TOKEN_MANAGER)
+    no_credentials_block = token_source[
+        token_source.index('if refresh_result == "no_credentials":') :
+        token_source.index("if refresh_result is True:", token_source.index('if refresh_result == "no_credentials":'))
+    ]
+    assert 'self.last_token_refresh_status = "no_credentials"' in no_credentials_block
+    assert "disable_account" not in no_credentials_block
+
+
+def test_standalone_password_refresh_never_disables_for_missing_or_bad_credentials():
+    source = _read(WS_INTERNAL)
+    block = source[
+        source.index("async def _standalone_password_login") :
+        source.index('@router.post("/accounts/{account_id}/create-chat")')
+    ]
+    assert "disable_account" not in block
+    assert "账号状态保持不变" in block
+    assert '"reason": "no_credentials"' in block
