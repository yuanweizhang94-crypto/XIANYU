+def _native_chat_instance(account_id: str):
+    """Return the existing Native IM owner for Online Chat RPC reuse."""
+    from app.services.xianyu.cookie_manager import get_manager
+
+    manager = get_manager()
+    instance = manager.instances.get(account_id) if manager else None
+    if not instance:
+        return None
+    connection_manager = getattr(instance, "connection_manager", None)
+    if connection_manager is None or connection_manager.ws is None:
+        return None
+    return instance
+
+
+@router.get("/accounts/{account_id}/chat/conversations")
+async def native_chat_conversations(
+    account_id: str,
+    cursor: int | None = None,
+    limit: int = 20,
+):
+    """Read Online Chat conversations through the existing Native IM owner."""
+    instance = _native_chat_instance(account_id)
+    if instance is None:
+        return {"success": False, "code": 503, "message": "Native WebSocket 未连接", "data": None}
+    try:
+        body = await instance.get_chat_conversations(cursor, max(1, min(int(limit), 100)))
+        return {
+            "success": True,
+            "code": 200,
+            "message": "success",
+            "data": {"body": body, "myid": instance.myid},
+        }
+    except Exception as exc:
+        return {"success": False, "code": 502, "message": str(exc), "data": None}
+
+
+@router.get("/accounts/{account_id}/chat/messages/{cid}")
+async def native_chat_messages(
+    account_id: str,
+    cid: str,
+    cursor: int | None = None,
+    limit: int = 20,
+):
+    """Read Online Chat message history through the existing Native IM owner."""
+    instance = _native_chat_instance(account_id)
+    if instance is None:
+        return {"success": False, "code": 503, "message": "Native WebSocket 未连接", "data": None}
+    try:
+        body = await instance.get_chat_messages(cid, cursor, max(1, min(int(limit), 100)))
+        return {
+            "success": True,
+            "code": 200,
+            "message": "success",
+            "data": {"body": body, "myid": instance.myid},
+        }
+    except Exception as exc:
+        return {"success": False, "code": 502, "message": str(exc), "data": None}
+
+
+@router.post("/accounts/{account_id}/chat/send-text")
+async def native_chat_send_text(account_id: str, request: NativeChatSendTextRequest):
+    """Send manual Online Chat text through the existing Native IM owner."""
+    instance = _native_chat_instance(account_id)
+    if instance is None:
+        return {"success": False, "code": 503, "message": "Native WebSocket 未连接", "data": None}
+    if not request.text.strip():
+        return {"success": False, "code": 400, "message": "消息内容不能为空", "data": None}
+    try:
+        result = await instance.send_chat_text_message(request.cid, request.to_user_id, request.text)
+        return {"success": True, "code": 200, "message": "发送成功", "data": result}
+    except Exception as exc:
+        return {"success": False, "code": 400, "message": str(exc), "data": None}
+
+
+@router.post("/accounts/{account_id}/chat/send-image")
+async def native_chat_send_image(account_id: str, request: NativeChatSendImageRequest):
+    """Send manual Online Chat image through the existing Native IM owner."""
+    instance = _native_chat_instance(account_id)
+    if instance is None:
+        return {"success": False, "code": 503, "message": "Native WebSocket 未连接", "data": None}
+    try:
+        result = await instance.send_chat_image_message(
+            request.cid,
+            request.to_user_id,
+            request.image_url,
+            request.width,
+            request.height,
+        )
+        return {"success": True, "code": 200, "message": "发送成功", "data": result}
+    except Exception as exc:
+        return {"success": False, "code": 400, "message": str(exc), "data": None}
+
+
+@router.post("/accounts/{account_id}/chat/recall")
+async def native_chat_recall(account_id: str, request: NativeChatRecallRequest):
+    """Recall manual Online Chat message through the existing Native IM owner."""
+    instance = _native_chat_instance(account_id)
+    if instance is None:
+        return {"success": False, "code": 503, "message": "Native WebSocket 未连接", "data": None}
+    if not request.message_id:
+        return {"success": False, "code": 400, "message": "缺少消息ID", "data": None}
+    try:
+        await instance.recall_chat_message(request.message_id)
+        return {"success": True, "code": 200, "message": "消息已撤回", "data": {}}
+    except Exception as exc:
+        return {"success": False, "code": 400, "message": str(exc), "data": None}
+
+
diff --git a/websocket/app/services/xianyu/xianyu_async.py b/websocket/app/services/xianyu/xianyu_async.py
