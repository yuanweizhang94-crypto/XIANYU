diff --git a/tests/test_chg0018_authoritative_platform_status.py b/tests/test_chg0018_authoritative_platform_status.py
new file mode 100644
index 0000000..2a38d92
--- /dev/null
+++ b/tests/test_chg0018_authoritative_platform_status.py
@@ -0,0 +1,214 @@
+from __future__ import annotations
+
+import ast
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+from types import SimpleNamespace
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def _load_class_methods(path: Path, class_name: str, names: set[str]) -> dict[str, object]:
+    tree = ast.parse(path.read_text(encoding="utf-8-sig"))
+    klass = next(node for node in tree.body if isinstance(node, ast.ClassDef) and node.name == class_name)
+    selected = [
+        node
+        for node in klass.body
+        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and node.name in names
+    ]
+    module = ast.Module(
+        body=[
+            ast.ImportFrom(module="__future__", names=[ast.alias(name="annotations")], level=0),
+            ast.Import(names=[ast.alias(name="re")]),
+            ast.ImportFrom(module="typing", names=[ast.alias(name="Any"), ast.alias(name="Iterable")], level=0),
+            ast.ClassDef(class_name, bases=[], keywords=[], body=selected, decorator_list=[]),
+        ],
+        type_ignores=[],
+    )
+    ast.fix_missing_locations(module)
+    namespace = {"Any": Any}
+    exec(compile(module, str(path), "exec"), namespace)
+    return {name: getattr(namespace[class_name], name) for name in names}
+
+
+def _item_service_stub() -> SimpleNamespace:
+    return SimpleNamespace(
+        PLATFORM_STATUS_ACTIVE="ACTIVE",
+        PLATFORM_STATUS_MISSING="NOT_IN_ACTIVE_LIST",
+        PLATFORM_STATUS_OFFLINE="OFFLINE",
+        PLATFORM_STATUS_SOLD="SOLD",
+        PLATFORM_STATUS_DELETED="DELETED",
+        PLATFORM_STATUS_UNDER_REVIEW="UNDER_REVIEW",
+        PLATFORM_STATUS_PLATFORM_DELISTED="PLATFORM_DELISTED",
+        PLATFORM_STATUS_UNKNOWN="UNKNOWN",
+    )
+
+
+def _item_classifier():
+    methods = _load_class_methods(
+        ROOT / "common" / "services" / "item_service.py",
+        "ItemService",
+        {"_summarize_official_text", "_text_contains_any", "_classify_authoritative_item_status"},
+    )
+    service = _item_service_stub()
+    service._summarize_official_text = lambda value, limit=180: methods["_summarize_official_text"](service, value, limit)
+    service._text_contains_any = lambda text, needles: methods["_text_contains_any"](service, text, needles)
+    return methods["_classify_authoritative_item_status"], service
+
+
+def test_authoritative_item_status_classifies_active_list_metadata_separately():
+    source = (ROOT / "common" / "services" / "item_service.py").read_text(encoding="utf-8")
+
+    assert "PLATFORM_STATUS_ACTIVE = \"ACTIVE\"" in source
+    assert "PLATFORM_STATUS_MISSING = \"NOT_IN_ACTIVE_LIST\"" in source
+    assert "PLATFORM_STATUS_PLATFORM_DELISTED = \"PLATFORM_DELISTED\"" in source
+    assert "ItemInfoManager.get_item_list_info" in source
+
+
+def test_authoritative_item_status_classifies_offline_sold_deleted_review_and_platform_delist():
+    classify, service = _item_classifier()
+
+    assert classify(service, text="商品已下架")["status"] == "OFFLINE"
+    assert classify(service, text="已卖出")["status"] == "SOLD"
+    assert classify(service, http_status=404, text="")["status"] == "DELETED"
+    assert classify(service, text="审核中")["status"] == "UNDER_REVIEW"
+    assert classify(service, text="平台下架：商品违规")["status"] == "PLATFORM_DELISTED"
+
+
+def test_ordinary_offline_does_not_become_platform_delisted():
+    classify, service = _item_classifier()
+
+    result = classify(service, text="商品已下架，卖家可重新上架")
+
+    assert result["status"] == "OFFLINE"
+    assert result["status"] != "PLATFORM_DELISTED"
+
+
+def test_unknown_item_detail_preserves_previous_state():
+    classify, service = _item_classifier()
+
+    result = classify(service, text="普通商品详情页")
+
+    assert result["status"] == "UNKNOWN"
+    assert result["preserve_previous"] is True
+
+
+def test_session_or_platform_verification_is_not_item_platform_delist():
+    classify, service = _item_classifier()
+
+    result = classify(service, http_status=403, text="请先登录后查看")
+    captcha = classify(service, text="需要滑块验证码")
+
+    assert result["status"] == "UNKNOWN"
+    assert result["preserve_previous"] is True
+    assert captcha["status"] == "UNKNOWN"
+    assert captcha["preserve_previous"] is True
+
+
+def _load_module_functions(path: Path, names: set[str], imports: list[ast.stmt] | None = None) -> dict[str, object]:
+    tree = ast.parse(path.read_text(encoding="utf-8-sig"))
+    selected = [node for node in tree.body if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and node.name in names]
+    module = ast.Module(body=(imports or []) + selected, type_ignores=[])
+    ast.fix_missing_locations(module)
+    namespace = {
+        "Any": Any,
+        "datetime": datetime,
+        "timedelta": timedelta,
+        "timezone": timezone,
+        "get_beijing_now_naive": lambda: datetime(2026, 8, 13, 12, 0, 0),
+    }
+    exec(compile(module, str(path), "exec"), namespace)
+    return {name: namespace[name] for name in names}
+
+
+def test_publish_restriction_detects_explicit_until_and_duration():
+    funcs = _load_module_functions(
+        ROOT / "common" / "services" / "xianyu_publish_service.py",
+        {"parse_publish_restriction_evidence"},
+        imports=[ast.Import(names=[ast.alias(name="re")])],
+    )
+    parse = funcs["parse_publish_restriction_evidence"]
+    now = datetime(2026, 8, 13, 12, 0, 0)
+
+    explicit = parse("账号限制发布，限制至2026-08-20 12:30", now=now)
+    duration = parse("账号限制7天，暂时无法发布", now=now)
+    no_date = parse("账号限制发布，暂时无法发布", now=now)
+
+    assert explicit["state"] == "PUBLISH_RESTRICTED"
+    assert explicit["restriction_until"].startswith("2026-08-20T12:30")
+    assert explicit["evidence_type"] == "UNTIL_EXPLICIT"
+    assert duration["duration_seconds"] == 7 * 86400
+    assert duration["restriction_until"].startswith("2026-08-20T12:00")
+    assert duration["evidence_type"] == "DURATION_DERIVED"
+    assert no_date["restriction_until"] is None
+    assert no_date["evidence_type"] == "EXPLICIT_RESTRICTION_TEXT"
+
+
+def test_publish_readiness_classification_separates_session_verification_and_restriction():
+    funcs = _load_module_functions(
+        ROOT / "common" / "services" / "xianyu_publish_service.py",
+        {"_classify_publish_readiness_result"},
+        imports=[ast.Import(names=[ast.alias(name="json")])],
+    )
+    classify = funcs["_classify_publish_readiness_result"]
+
+    assert classify({"failure_reason": "login_required"})[0] == "HUMAN_QR_REQUIRED"
+    assert classify({"failure_reason": "platform_verification captcha"})[0] == "PLATFORM_VERIFICATION_REQUIRED"
+    assert classify({"failure_reason": "network timeout"})[0] == "TEMPORARY_FAILURE"
+    assert classify({"diagnostics": {"official_page_text_summary": "限制发布"}})[0] == "PUBLISH_RESTRICTED"
+
+
+def test_publish_restriction_fail_closed_ttl_and_expiry():
+    funcs = _load_module_functions(
+        ROOT / "common" / "services" / "publish_execution_service.py",
+        {"_parse_iso_datetime", "get_effective_publish_restriction", "build_publish_restriction_failure"},
+        imports=[
+            ast.ImportFrom(module="__future__", names=[ast.alias(name="annotations")], level=0),
+            ast.ImportFrom(module="datetime", names=[ast.alias(name="datetime"), ast.alias(name="timedelta"), ast.alias(name="timezone")], level=0),
+        ],
+    )
+    effective = funcs["get_effective_publish_restriction"]
+    build = funcs["build_publish_restriction_failure"]
+    now = datetime(2026, 8, 13, 12, 0, 0, tzinfo=timezone.utc)
+
+    fresh = {"platform_restriction": {"state": "PUBLISH_RESTRICTED", "last_checked_at": now.isoformat(), "reason": "限制发布"}}
