+def _classify_publish_readiness_result(result: dict[str, Any] | BaseException) -> tuple[str, str]:
+    if isinstance(result, dict) and result.get("success"):
+        return "READY", "publish_preflight_ready"
+
+    text_body = (
+        json.dumps(result, ensure_ascii=False)
+        if isinstance(result, dict)
+        else str(result)
+    )
+    lowered = text_body.lower()
+    if (
+        "publish_restricted" in lowered
+        or "\u9650\u5236\u53d1\u5e03" in text_body
+        or "\u65e0\u6cd5\u53d1\u5e03" in text_body
+        or "\u6682\u4e0d\u652f\u6301\u53d1\u5e03" in text_body
+        or "\u4e0d\u80fd\u53d1\u5e03" in text_body
+    ):
