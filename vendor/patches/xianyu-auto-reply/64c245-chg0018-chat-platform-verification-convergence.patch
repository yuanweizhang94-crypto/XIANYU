+import asyncio
+import pytest
+import sys
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+sys.path.insert(0, str(ROOT / "backend-web"))
+
+from app.services.chat_new.im_session_manager import ImSessionManager
+from common.utils.cookie_refresh import auth_convergence_fingerprint
+
+
+class FakeClient:
+    instances = []
+
+    def __init__(self, account_id, cookies_str, *, account_row_id=None):
+        self.account_id = account_id
+        self.cookies_str = cookies_str
+        self.account_row_id = account_row_id
+        self.auth_fingerprint = auth_convergence_fingerprint(cookies_str)
+        self.is_connected = True
+        self.disconnect_count = 0
+        FakeClient.instances.append(self)
+
+    async def connect(self):
+        return True
+
+    async def disconnect(self):
+        self.disconnect_count += 1
+        self.is_connected = False
+
+
+def test_get_or_connect_reuses_connected_client_when_cookie_fingerprint_matches(monkeypatch):
+    manager = ImSessionManager()
+
+    async def fake_context(account_id):
+        return 1, "unb=1001; token=alpha"
+
+    monkeypatch.setattr(manager, "_get_account_context", fake_context)
+    monkeypatch.setattr("app.services.chat_new.im_session_manager.GoofishImClient", FakeClient)
+
+    async def run_case():
+        first_client = await manager.get_or_connect("acct-1")
+        second_client = await manager.get_or_connect("acct-1")
+        return first_client, second_client
+
+    first, second = asyncio.run(run_case())
+
+    assert second is first
+    assert first.disconnect_count == 0
+    assert len(FakeClient.instances) == 1
+
+
+def test_get_or_connect_replaces_connected_client_when_cookie_fingerprint_changes(monkeypatch):
+    manager = ImSessionManager()
+    contexts = ["unb=1001; token=alpha", "unb=1001; token=beta"]
+
+    async def fake_context(account_id):
+        return 1, contexts.pop(0)
+
+    monkeypatch.setattr(manager, "_get_account_context", fake_context)
+    monkeypatch.setattr("app.services.chat_new.im_session_manager.GoofishImClient", FakeClient)
+
+    async def run_case():
+        first_client = await manager.get_or_connect("acct-1")
+        second_client = await manager.get_or_connect("acct-1")
+        return first_client, second_client
+
+    first, second = asyncio.run(run_case())
+
+    assert second is not first
+    assert first.disconnect_count == 1
+    assert second.auth_fingerprint == auth_convergence_fingerprint("unb=1001; token=beta")
+    assert manager.clients["acct-1"] is second
+
+
+def test_invalidate_auth_consumers_disconnects_client_and_expires_chat_token(monkeypatch):
+    manager = ImSessionManager()
+    client = FakeClient("acct-1", "unb=1001; token=alpha", account_row_id=1)
+    manager.clients["acct-1"] = client
+    calls = []
+
+    async def fake_mark_token_cache_expired(**kwargs):
+        calls.append(kwargs)
+
+        class Result:
+            success = True
+            message = "expired"
+
+        return Result()
+
+    monkeypatch.setattr(
+        "app.services.chat_new.im_session_manager.mark_token_cache_expired",
+        fake_mark_token_cache_expired,
+    )
+
+    result = asyncio.run(manager.invalidate_auth_consumers("acct-1", "unb=1001; token=beta"))
+
+    assert result == {
+        "client_disconnected": True,
+        "chat_token_cache_invalidated": True,
+        "chat_token_cache_key_present": True,
+    }
+    assert client.disconnect_count == 1
+    assert "acct-1" not in manager.clients
+    assert calls == [
+        {"token_user_id": "chat_1001", "invalidate_valid_cache": True}
+    ]
+
+
+def test_auth_convergence_fingerprint_ignores_runtime_browser_cookie_rotation():
+    first = "unb=1001; cookie2=auth; atpsida=a; sca=b; tfstk=c"
+    second = "tfstk=z; cookie2=auth; sca=y; unb=1001; atpsida=x"
+    assert auth_convergence_fingerprint(first) == auth_convergence_fingerprint(second)
+
+
+def test_auth_convergence_fingerprint_changes_for_auth_cookie_rotation():
+    first = "unb=1001; cookie2=auth-a; atpsida=a; sca=b; tfstk=c"
+    second = "unb=1001; cookie2=auth-b; atpsida=x; sca=y; tfstk=z"
+    assert auth_convergence_fingerprint(first) != auth_convergence_fingerprint(second)
