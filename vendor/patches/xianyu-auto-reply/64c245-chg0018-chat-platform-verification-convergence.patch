+
+def get_session_maintenance_state(metadata_json: dict[str, Any] | None) -> dict[str, Any]:
+    if not isinstance(metadata_json, dict):
+        return {}
+    value = metadata_json.get(SESSION_MAINTENANCE_KEY)
+    return dict(value) if isinstance(value, dict) else {}
+
+
+def set_session_maintenance_state(
+    metadata_json: dict[str, Any] | None,
+    *,
+    state: str,
+    cookie_string: str = "",
+    failure_reason: str | None = None,
+    final_page_url: str | None = None,
+    final_page_title: str | None = None,
+    visible_login_ui: bool | None = None,
+    visible_qr: bool | None = None,
+    visible_platform_error: list[str] | None = None,
+    cooldown_until: str | None = None,
+) -> dict[str, Any]:
+    """Persist only allow-listed lifecycle diagnostics; never persist Cookie values or QR payloads."""
+    if state not in SESSION_MAINTENANCE_STATES:
+        raise ValueError(f"unsupported_session_maintenance_state:{state}")
+    metadata = dict(metadata_json or {})
+    record: dict[str, Any] = {
+        "state": state,
+        "updated_at": datetime.now(timezone.utc).isoformat(),
+    }
+    if cookie_string:
+        record["cookie_fingerprint"] = cookie_fingerprint(cookie_string)
+    if failure_reason:
+        record["failure_reason"] = str(failure_reason)[:500]
+    if final_page_url is not None:
+        record["final_page_url"] = str(final_page_url)[:500]
+    if final_page_title is not None:
+        record["final_page_title"] = str(final_page_title)[:300]
+    if visible_login_ui is not None:
+        record["visible_login_ui"] = bool(visible_login_ui)
+    if visible_qr is not None:
+        record["visible_qr"] = bool(visible_qr)
+    if visible_platform_error is not None:
+        record["visible_platform_error"] = [str(item)[:200] for item in visible_platform_error[:10]]
+    if cooldown_until:
+        record["cooldown_until"] = str(cooldown_until)
+    if state == "HUMAN_QR_REQUIRED" and cookie_string:
+        record["qr_required_cookie_fingerprint"] = cookie_fingerprint(cookie_string)
+    metadata[SESSION_MAINTENANCE_KEY] = record
+    return metadata
+
+
+def set_session_check_lease(
+    metadata_json: dict[str, Any] | None,
+    *,
+    active: bool,
+    deadline_seconds: float | None = None,
+) -> dict[str, Any]:
+    """Update only the existing Session-maintenance check lease metadata.
+
+    The lease distinguishes a real in-flight Browser/Session operation from a raw
+    lifecycle state such as ``SESSION_CHECK_PENDING``. It never changes Cookie or
+    creates a second status owner.
+    """
+    metadata = dict(metadata_json or {})
+    record = get_session_maintenance_state(metadata)
+    now = datetime.now(timezone.utc)
+    record["check_active"] = bool(active)
+    if active:
+        record["check_started_at"] = now.isoformat()
+        if deadline_seconds is not None:
+            from datetime import timedelta
+
+            record["check_deadline_at"] = (
+                now + timedelta(seconds=max(0.0, float(deadline_seconds)))
+            ).isoformat()
+    else:
+        record["check_finished_at"] = now.isoformat()
+    metadata[SESSION_MAINTENANCE_KEY] = record
+    return metadata
+
+
+def mark_cookie_update_session_pending(
+    metadata_json: dict[str, Any] | None,
+    cookie_string: str,
+) -> dict[str, Any]:
+    """Invalidate prior QR/cooldown state whenever authoritative Cookie content changes."""
+    return set_session_maintenance_state(
+        clear_cookie_refresh_snapshot(metadata_json),
+        state="SESSION_CHECK_PENDING",
+        cookie_string=cookie_string,
+    )
+
+
+def is_human_qr_required_for_cookie(
+    metadata_json: dict[str, Any] | None,
+    cookie_string: str,
+) -> bool:
+    state = get_session_maintenance_state(metadata_json)
+    expected = str(state.get("qr_required_cookie_fingerprint") or "")
+    return bool(
+        state.get("state") == "HUMAN_QR_REQUIRED"
+        and expected
+        and expected == cookie_fingerprint(cookie_string or "")
+    )
 
 
