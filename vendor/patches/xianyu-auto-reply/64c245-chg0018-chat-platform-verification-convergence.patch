+    ws_connection_state = str(ws_status.get("connection_state") or "unknown")
+    ws_connected = bool(ws_status.get("is_connected")) or ws_connection_state == "connected"
+    ws_recovery_active = bool(ws_status.get("reconnect_active"))
+    ws_recovery_deadline = ws_status.get("recovery_deadline_at")
+    if ws_connected:
+        auto_reply = _business_capability(
+            state="ONLINE",
+            label="在线",
+            reason="websocket_connected",
+            source="websocket_manager",
+            last_checked_at=checked_at,
+            auto_recoverable=True,
+        )
+    elif ws_recovery_active:
+        auto_reply = _business_capability(
+            state="RECOVERING",
+            label="恢复中",
+            reason="websocket_reconnect_active",
+            source="websocket_manager",
+            last_checked_at=checked_at,
+            auto_recoverable=True,
+            recovery_active=True,
+            deadline_at=ws_recovery_deadline,
+        )
+    else:
+        offline_reason = (
+            "websocket_recovery_deadline_exceeded"
+            if ws_running and ws_connection_state in {"connecting", "reconnecting"} and ws_recovery_deadline
+            else "websocket_disconnected_no_active_recovery"
+            if ws_running
+            else "websocket_task_not_running"
+        )
+        auto_reply = _business_capability(
+            state="OFFLINE",
+            label="离线",
+            reason=offline_reason,
+            source="websocket_manager",
+            last_checked_at=checked_at,
+            auto_recoverable=True,
+            deadline_at=ws_recovery_deadline,
+        )
+
+    auth_convergence = metadata.get("auth_convergence")
+    if not isinstance(auth_convergence, dict):
+        auth_convergence = {}
+    chat_recovery_active, chat_recovery_expired = _bounded_operation_active(
+        auth_convergence,
+        active_key="recovery_active",
+        deadline_key="recovery_deadline_at",
+    )
+    chat_recovery_deadline = auth_convergence.get("recovery_deadline_at")
+    chat_state = str(chat.get("state") or "PENDING")
+    chat_reason = str(chat.get("reason") or "chat_readiness_pending")
+    chat_checked_at = chat.get("updated_at") or chat_diagnostic.get("updated_at")
+
+    # Chat 用户态由现有 ImSessionManager strict diagnostic 计算 current usability。
+    # 历史 READY 没有 live client 时绝不能继续假绿；Account GET 仍严格只读。
+    effective_chat_state = str(chat_diagnostic.get("effective_state") or "")
+    effective_chat_reason = str(chat_diagnostic.get("effective_reason") or "")
+    effective_chat_auto_recoverable = bool(chat_diagnostic.get("auto_recoverable", True))
+    chat_connect_active = bool(chat_diagnostic.get("connect_active"))
+    chat_connect_deadline = chat_diagnostic.get("connect_deadline_at")
+    if not effective_chat_state:
+        if bool(
+            chat_diagnostic.get("client_connected")
+            and chat_diagnostic.get("client_fingerprint_matches")
+        ):
+            effective_chat_state = "READY"
+            effective_chat_reason = "chat_runtime_client_ready"
+        elif bool(chat_diagnostic.get("connect_active")) or chat_recovery_active:
+            effective_chat_state = "CONNECTING"
+            effective_chat_reason = chat_reason or "auth_convergence_active"
+        elif chat_state == "PLATFORM_VERIFICATION_REQUIRED":
+            effective_chat_state = "PLATFORM_VERIFICATION_REQUIRED"
+            effective_chat_reason = chat_reason or "platform_verification_required"
+            effective_chat_auto_recoverable = False
+        elif chat_state in {"HUMAN_QR_REQUIRED", "SESSION_EXPIRED"}:
+            effective_chat_state = "LOGIN_REQUIRED"
+            effective_chat_reason = chat_reason or "chat_login_required"
+            effective_chat_auto_recoverable = False
+        elif chat_state == "TEMPORARY_FAILURE":
+            effective_chat_state = "TEMPORARY_FAILURE"
+            effective_chat_reason = chat_reason or "chat_temporary_failure"
+        else:
+            # 包括 stored READY/PENDING：没有当前 runtime 证据只能“待连接”。
+            effective_chat_state = "WAITING_CONNECT"
+            effective_chat_reason = "chat_client_not_currently_connected"
+
+    chat_labels = {
+        "READY": "可用",
+        "CONNECTING": "连接中",
+        "RECOVERING": "恢复中",
+        "WAITING_CONNECT": "待连接",
+        "DISCONNECTED": "待连接",
+        "TEMPORARY_FAILURE": "暂不可用",
+        "LOGIN_REQUIRED": "需登录",
+        "PLATFORM_VERIFICATION_REQUIRED": "需平台验证",
+        "RATE_LIMITED": "请求频繁，稍后重试",
+        "DISABLED": "停用",
+        "UNKNOWN": "未知",
+    }
+    chat_capability = _business_capability(
+        state=effective_chat_state,
+        label=chat_labels.get(effective_chat_state, "未知"),
+        reason=effective_chat_reason or "chat_state_unknown",
+        source="chat_read_only_runtime",
+        last_checked_at=(checked_at if effective_chat_state in {"READY", "CONNECTING"} else chat_checked_at),
+        auto_recoverable=effective_chat_auto_recoverable,
+        recovery_active=chat_connect_active or chat_recovery_active,
+        deadline_at=chat_connect_deadline or chat_recovery_deadline,
+    )
+    chat_capability["verification_state"] = str(
+        chat_diagnostic.get("verification_state") or chat.get("verification_state") or "NONE"
+    )
+    chat_capability["verification_active"] = bool(chat_diagnostic.get("verification_active"))
+    chat_capability["verification_deadline_at"] = (
+        chat_diagnostic.get("verification_deadline_at") or chat.get("verification_deadline_at")
+    )
+    chat_capability["verification_reason"] = str(
+        chat_diagnostic.get("verification_reason") or chat.get("verification_reason") or ""
+    )
+    chat_capability["human_action"] = (
+        "platform_verification"
+        if effective_chat_state == "PLATFORM_VERIFICATION_REQUIRED"
+        else ""
+    )
+
+    restriction_state = str(restriction.get("platform_restriction_state") or "UNKNOWN")
+    browser_state = str(session_maintenance.get("state") or "SESSION_CHECK_PENDING")
+    publish_state = str(publish.get("state") or "PENDING")
+    publish_reason = str(publish.get("reason") or session_maintenance.get("failure_reason") or "")
+    publish_checked_at = (
+        restriction.get("platform_restriction_updated_at")
+        or publish.get("updated_at")
+        or session_maintenance.get("updated_at")
+        or checked_at
+    )
+    session_check_active, session_check_expired = _bounded_operation_active(
+        session_maintenance,
+        active_key="check_active",
+        deadline_key="check_deadline_at",
+    )
+    publish_check_active, publish_check_expired = _bounded_operation_active(
+        publish,
+        active_key="check_active",
+        deadline_key="check_deadline_at",
+    )
+    any_publish_check_active = session_check_active or publish_check_active
+    publish_check_deadline = (
+        publish.get("check_deadline_at")
+        if publish_check_active
+        else session_maintenance.get("check_deadline_at")
+    )
+    publish_check_expired_effective = session_check_expired or publish_check_expired
+
+    if restriction_state == "PUBLISH_RESTRICTED":
+        publish_capability = _business_capability(
+            state="RESTRICTED", label="限制发布",
+            reason=str(restriction.get("platform_restriction_reason") or "publish_restricted"),
+            source=str(restriction.get("platform_restriction_source") or "platform_restriction"),
+            last_checked_at=publish_checked_at, auto_recoverable=False,
+        )
+    elif restriction_state == "PLATFORM_VERIFICATION_REQUIRED" or browser_state == "PLATFORM_VERIFICATION_REQUIRED" or publish_state == "PLATFORM_VERIFICATION_REQUIRED":
+        publish_capability = _business_capability(
+            state="PLATFORM_VERIFICATION_REQUIRED", label="需平台验证",
+            reason=publish_reason or str(restriction.get("platform_restriction_reason") or "platform_verification_required"),
+            source="canonical_browser_session", last_checked_at=publish_checked_at, auto_recoverable=False,
+        )
+    elif browser_state == "HUMAN_QR_REQUIRED" or publish_state == "HUMAN_QR_REQUIRED":
+        publish_capability = _business_capability(
+            state="QR_REQUIRED", label="需扫码",
+            reason=publish_reason or str(session_maintenance.get("failure_reason") or "LOGIN_OR_QR_UI_VISIBLE"),
+            source="canonical_browser_session", last_checked_at=publish_checked_at, auto_recoverable=False,
+        )
+    elif browser_state in {"SESSION_RENEWING", "SESSION_RENEWABLE"} or publish_state == "SESSION_EXPIRED":
+        if session_check_active:
+            publish_capability = _business_capability(
+                state="RECOVERING", label="恢复中", reason=publish_reason or browser_state,
+                source="session_maintenance", last_checked_at=publish_checked_at, auto_recoverable=True,
+                recovery_active=True, deadline_at=session_maintenance.get("check_deadline_at"),
+            )
+        else:
+            publish_capability = _business_capability(
+                state="RETRY_LATER", label="稍后重试",
+                reason=("session_recovery_timed_out" if session_check_expired else "session_recovery_not_active"),
+                source="session_maintenance", last_checked_at=publish_checked_at, auto_recoverable=True,
+                deadline_at=session_maintenance.get("check_deadline_at"),
+            )
+    elif browser_state == "SESSION_CHECK_PENDING" or publish_state == "PENDING":
+        if any_publish_check_active:
+            publish_capability = _business_capability(
+                state="CHECKING", label="检查中", reason=publish_reason or "session_check_active",
+                source="session_maintenance", last_checked_at=publish_checked_at, auto_recoverable=True,
+                check_active=True, deadline_at=publish_check_deadline,
+            )
+        else:
+            publish_capability = _business_capability(
+                state="RETRY_LATER", label="待检查",
+                reason=("publish_check_timed_out" if publish_check_expired_effective else "session_check_pending_no_active_check"),
+                source="session_maintenance", last_checked_at=publish_checked_at, auto_recoverable=True,
+                deadline_at=publish_check_deadline,
+            )
+    elif browser_state == "COOLDOWN" or publish_state in {"PROFILE_BUSY", "TEMPORARY_FAILURE", "COOLDOWN"}:
+        publish_capability = _business_capability(
+            state="RETRY_LATER", label="稍后重试", reason=publish_reason or browser_state,
+            source="session_maintenance", last_checked_at=publish_checked_at, auto_recoverable=True,
+        )
+    elif publish_check_active:
+        publish_capability = _business_capability(
+            state="CHECKING", label="检查中", reason="publish_preflight_active",
+            source="publish_auth_readiness", last_checked_at=publish_checked_at, auto_recoverable=True,
+            check_active=True, deadline_at=publish.get("check_deadline_at"),
+        )
+    elif publish_state == "READY":
+        publish_capability = _business_capability(
+            state="READY", label="可用", reason=publish_reason or "publish_auth_ready",
+            source="publish_auth_readiness", last_checked_at=publish_checked_at, auto_recoverable=True,
+        )
+    else:
+        publish_capability = _business_capability(
+            state="UNKNOWN", label="未知", reason=publish_reason or publish_state,
+            source="publish_auth_readiness", last_checked_at=publish_checked_at, auto_recoverable=False,
+        )
+
+    return {
+        "auto_reply": auto_reply,
+        "chat": chat_capability,
+        "publish": publish_capability,
+    }
