+def _consumer_record(
+    session_maintenance: dict[str, Any],
+    name: str,
+    *,
+    fallback_state: str = "PENDING",
+) -> dict[str, Any]:
+    consumers = session_maintenance.get("consumers")
+    record = consumers.get(name) if isinstance(consumers, dict) else None
+    if not isinstance(record, dict):
+        return {"state": fallback_state, "updated_at": None, "reason": ""}
+    normalized = dict(record)
+    normalized.update({
+        "state": str(record.get("state") or fallback_state),
+        "updated_at": record.get("updated_at"),
+        "reason": str(record.get("reason") or ""),
+    })
+    return normalized
