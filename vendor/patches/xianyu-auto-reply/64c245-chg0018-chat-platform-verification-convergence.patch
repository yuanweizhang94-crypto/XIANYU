+def parse_publish_restriction_evidence(
+    text_body: str,
+    *,
+    now: Any | None = None,
+) -> dict[str, Any]:
+    current = now or get_beijing_now_naive()
+    normalized = re.sub(r"\s+", " ", str(text_body or "")).strip()
+    restriction_terms = [
+        "\u9650\u5236\u53d1\u5e03",
+        "\u65e0\u6cd5\u53d1\u5e03",
+        "\u6682\u4e0d\u652f\u6301\u53d1\u5e03",
+        "\u4e0d\u80fd\u53d1\u5e03",
+        "\u53d1\u5e03\u6743\u9650",
+    ]
+    if not any(term in normalized for term in restriction_terms):
+        return {
+            "state": "NORMAL",
+            "reason": "official_publish_page_no_restriction",
+            "source": "publish_preflight_page",
+            "restriction_until": None,
+            "duration_seconds": None,
+            "evidence_type": "NO_RESTRICTION_SIGNAL",
+        }
+
+    until_match = re.search(
+        r"(?:\u9650\u5236\u81f3|\u622a\u6b62\u81f3|\u6062\u590d\u65f6\u95f4[:：]?)\s*"
+        r"(\d{4}[-/]\d{1,2}[-/]\d{1,2}(?:\s+\d{1,2}:\d{1,2}(?::\d{1,2})?)?)",
+        normalized,
+    )
+    restriction_until = None
+    duration_seconds = None
+    evidence_type = "EXPLICIT_RESTRICTION_TEXT"
+    if until_match:
+        raw_until = until_match.group(1).replace("/", "-")
+        try:
+            restriction_until = current.fromisoformat(raw_until).isoformat()
+        except Exception:
+            restriction_until = raw_until
+        evidence_type = "UNTIL_EXPLICIT"
+    else:
+        duration_match = re.search(
+            r"(?:\u9650\u5236\s*(\d+)\s*\u5929|(\d+)\s*\u5929\u5185\u65e0\u6cd5\u53d1\u5e03|\u5269\u4f59\s*(\d+)\s*\u5929)",
+            normalized,
+        )
+        if duration_match:
+            days = int(duration_match.group(1) or duration_match.group(2) or duration_match.group(3))
+            duration_seconds = days * 86400
+            try:
+                from datetime import timedelta
+
+                restriction_until = (current + timedelta(seconds=duration_seconds)).isoformat()
+            except Exception:
+                restriction_until = None
+            evidence_type = "DURATION_DERIVED"
+
+    return {
+        "state": "PUBLISH_RESTRICTED",
+        "reason": normalized[:180],
+        "source": "publish_preflight_page",
+        "restriction_until": restriction_until,
+        "duration_seconds": duration_seconds,
+        "evidence_type": evidence_type,
+    }
