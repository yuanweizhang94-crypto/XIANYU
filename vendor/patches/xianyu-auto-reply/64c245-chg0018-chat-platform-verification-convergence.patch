+            status = self.PLATFORM_STATUS_DELETED
+        elif self._text_contains_any(match_text, ["\u5df2\u5356\u51fa", "\u4ea4\u6613\u6210\u529f", "sold"]):
+            status = self.PLATFORM_STATUS_SOLD
+        elif self._text_contains_any(match_text, ["\u8fdd\u89c4\u4e0b\u67b6", "\u5e73\u53f0\u4e0b\u67b6", "\u8fdd\u89c4", "\u5904\u7f5a"]):
+            status = self.PLATFORM_STATUS_PLATFORM_DELISTED
+        elif self._text_contains_any(match_text, ["\u5ba1\u6838\u4e2d", "\u5f85\u5ba1\u6838", "\u5ba1\u6838\u672a\u901a\u8fc7"]):
+            status = self.PLATFORM_STATUS_UNDER_REVIEW
+        elif self._text_contains_any(match_text, ["\u5df2\u4e0b\u67b6", "\u5546\u54c1\u5df2\u4e0b\u67b6", "\u5b9d\u8d1d\u5df2\u4e0b\u67b6"]):
+            status = self.PLATFORM_STATUS_OFFLINE
+        else:
+            return {
+                "confirmed": False,
+                "status": self.PLATFORM_STATUS_UNKNOWN,
+                "reason": summary or "official_detail_no_explicit_status",
+                "source": source,
+                "raw_platform_item_status": raw_status,
+                "preserve_previous": True,
+            }
+        return {
+            "confirmed": True,
+            "status": status,
+            "reason": summary or "official_detail_no_explicit_status",
+            "source": source,
