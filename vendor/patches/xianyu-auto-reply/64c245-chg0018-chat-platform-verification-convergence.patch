+    if "human_qr_required" in lowered or "login_required" in lowered:
+        return "HUMAN_QR_REQUIRED", "authoritative_session_required_qr"
+    if "manual_verification_required" in lowered or "platform_verification" in lowered or "captcha" in lowered:
+        return "PLATFORM_VERIFICATION_REQUIRED", "platform_verification_required"
+    if "profile_in_use" in lowered or "browser_busy" in lowered or "profile_lock" in lowered:
+        return "PROFILE_BUSY", "profile_busy"
+    if "profile_missing" in lowered or "runtime_profile_path_mismatch" in lowered:
+        return "PENDING", "profile_not_ready"
+    if "publish_form_timeout" in lowered or "timeout" in lowered or "network" in lowered:
