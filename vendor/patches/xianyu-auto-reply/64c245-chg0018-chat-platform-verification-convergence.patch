+        "_build_platform_restriction",
+        "_business_capability",
+        "_bounded_operation_active",
+        "_build_business_capabilities",
+    }
+    nodes = [
+        node for node in tree.body
+        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and node.name in wanted
+    ]
+    namespace = {
+        "Any": Any,
+        "XYAccount": object,
+        "datetime": datetime,
+        "timedelta": timedelta,
+        "timezone": timezone,
+        "safe_isoformat": lambda value: value.isoformat() if value else None,
+    }
+    module = ast.Module(body=nodes, type_ignores=[])
+    exec(compile(module, str(ACCOUNT_ROUTE), "exec"), namespace)
+    return namespace["_build_business_capabilities"]
+
+
+_build_business_capabilities = _load_capability_builder()
+
+
+def _future(seconds: int = 600) -> str:
+    return (datetime.now(timezone.utc) + timedelta(seconds=seconds)).isoformat()
+
+
+def _past(seconds: int = 60) -> str:
+    return (datetime.now(timezone.utc) - timedelta(seconds=seconds)).isoformat()
+
+
+def _account(
+    *,
+    chat_state: str = "PENDING",
+    publish_state: str = "PENDING",
+    browser_state: str = "SESSION_CHECK_PENDING",
+    chat_reason: str = "",
+    publish_reason: str = "",
+    auth_convergence: dict | None = None,
+    session_extra: dict | None = None,
+    publish_extra: dict | None = None,
+    restriction: dict | None = None,
+    status: str = "active",
+):
+    session = {
+        "state": browser_state,
+        "updated_at": "2026-08-14T09:00:00+00:00",
+        "consumers": {
+            "chat": {
+                "state": chat_state,
+                "updated_at": "2026-08-14T09:00:00+00:00",
+                "reason": chat_reason,
+            },
+            "publish": {
+                "state": publish_state,
+                "updated_at": "2026-08-14T09:00:00+00:00",
+                "reason": publish_reason,
+                **(publish_extra or {}),
+            },
+        },
+        **(session_extra or {}),
+    }
+    metadata = {"session_maintenance": session}
+    if auth_convergence is not None:
+        metadata["auth_convergence"] = auth_convergence
+    if restriction is not None:
+        metadata["platform_restriction"] = restriction
+    return SimpleNamespace(
+        status=status,
+        metadata_json=metadata,
+        disable_reason="",
+        updated_at=None,
+    )
+
+
