+        "message": "PUBLISH_BLOCKED_BY_PLATFORM_RESTRICTION",
+        "failure_reason": "PUBLISH_BLOCKED_BY_PLATFORM_RESTRICTION",
+        "platform_restriction_reason": reason,
+        "platform_restriction_until": until,
+        "diagnostics": {
+            "source": record.get("source"),
+            "evidence_type": record.get("evidence_type"),
+        },
+    }
