diff --git a/tests/test_chg0018_order_fetch_recovery.py b/tests/test_chg0018_order_fetch_recovery.py
new file mode 100644
index 0000000000000000000000000000000000000000..5e7686aa4a10a644d2981687ef87524eb07034cf
--- /dev/null
+++ b/tests/test_chg0018_order_fetch_recovery.py
@@ -0,0 +1,32 @@
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+FETCH_ORDERS = ROOT / "scheduler/app/services/scheduler/fetch_orders_task.py"
+
+
+def _source() -> str:
+    return FETCH_ORDERS.read_text(encoding="utf-8")
+
+
+def test_order_fetch_uses_upstream_session_cooldown_without_auto_reply_metadata() -> None:
+    source = _source()
+    assert source.count("is_account_session_cooled(account.account_id)") == 2
+    assert "is_account_session_cooled(account.account_id, account.metadata_json)" not in source
+
+
+def test_order_fetch_errors_are_not_counted_as_success() -> None:
+    source = _source()
+    assert 'f"获取订单失败: {errors}"' in source
+    assert "if errors:\n                        failed_count += 1" in source.replace("\r\n", "\n")
+    assert "else:\n                        success_count += 1" in source.replace("\r\n", "\n")
+
+
+def test_refund_fetch_errors_are_not_counted_as_success() -> None:
+    source = _source()
+    assert 'f"【{self.task_name}】账号 {account.account_id} 获取退款订单失败: {errors}"' in source
+    normalized = source.replace("\r\n", "\n")
+    refund_anchor = normalized.index("class FetchRefundOrdersTaskService")
+    refund_source = normalized[refund_anchor:]
+    assert "if errors:\n                        failed_count += 1" in refund_source
+    assert "else:\n                        success_count += 1" in refund_source
